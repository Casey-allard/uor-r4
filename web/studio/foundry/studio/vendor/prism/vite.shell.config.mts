// hologram-forge (ours, not upstream's; see VENDORED.md): Upstream's renderer built for the shell, the vendored
// Vite config unchanged plus fixed output names, so the projected shell/index.html (written by the
// core from the verified View) can reference assets/index.js and assets/index.css without knowing a
// content hash. Lives beside the vendored config so Vite resolves upstream's modules. Run from vendor/prism:
//   npx vite build --config vite.shell.config.mts --base <base> --outDir dist --emptyOutDir
// then python3 ../../scripts/stamp_shell.py copies dist/assets into shell/assets.
//
// The product is Prism Foundry, and the assistant in it is Prism: the vendored sources already say Prism,
// and at build time upstream's logo becomes Hologram's mark.
//
// The brand is the Hologram brand kit's tokens (vendor/hologram-brand-kit, generated by
// tools/brand_kit.py into hologram.theme.css): Upstream's globals.css loses its own colour variables and
// its font faces (brand.css serves the kit's web fonts) and gains the kit's variables plus a Tailwind
// theme that remaps every palette family upstream's screens name onto the kit's warm ramp, floors text-xs
// at 14px and names the display face; the home headline is set in the display face; upstream's arbitrary
// purple hex classes become the foreground. No colour is typed in this file.
import fs from "fs";
import path from "path";
import { mergeConfig, type Plugin } from "vite";
import base from "./vite.renderer.config.mts";
import { audit, kitUi, registry, resolveUi } from "./hologram.ui.mjs";
import { toRadix } from "./hologram.radix.mjs";
import { screenSource, unapplied } from "./hologram.screens.mjs";
import { editorLoaderSource } from "./hologram.editor-loader.mjs";
const projectedEditorLoaders = new Set<string>();

const src = path.resolve(__dirname, "src").replace(/\\/g, "/");
const mark = path.resolve(__dirname, "../../shell/mark.svg");
const modeSelector = path.resolve(__dirname, "hologram.ChatModeSelector.tsx");
const picker = path.resolve(__dirname, "hologram.ModelPicker.tsx");
const githubIntegration = path.resolve(__dirname, "hologram.GitHubIntegration.tsx");
const posthogStub = path.resolve(__dirname, "hologram.posthog.ts");
const importDialog = path.resolve(__dirname, "hologram.ImportAppDialog.tsx");
const removedIntegrations = path.resolve(__dirname, "hologram.removed-integrations.tsx");
const REMOVED_INTEGRATIONS = /(^|\/)(DeploymentSection|VercelIntegration|SupabaseIntegration|NeonIntegration|SupabaseConnector|NeonConnector|NeonConfigure)$/;
const editor = path.resolve(__dirname, "hologram.editor.ts").split(path.sep).join("/");
const contracts = path.resolve(__dirname, "hologram.contracts.ts").split(path.sep).join("/");
const theme = fs.readFileSync(path.resolve(__dirname, "hologram.theme.css"), "utf8");
const arbitrary: Record<string, string> = JSON.parse(fs.readFileSync(path.resolve(__dirname, "hologram.arbitrary.json"), "utf8"));

// The ui components are the brand kit's shadcn/ui new-york-v4 files, verbatim (hologram.ui.mjs says how);
// the bundle is refused if an upstream copy of one of them, or Base UI, got into it anyway.
const entry = path.resolve(__dirname, "src", "renderer.tsx");
const hologramUi: Plugin = {
  name: "hologram-ui",
  enforce: "pre",
  async resolveId(id, importer) {
    const hit = resolveUi(id, importer);
    if (hit) return hit;
    // The kit's files import React, Radix and the rest by bare name; they are the renderer's packages.
    if (importer && importer.replace(/\\/g, "/").startsWith(registry) && !id.startsWith(".") && !id.startsWith("@/")) {
      return this.resolve(id, entry, { skipSelf: true });
    }
    if (id.startsWith("@/registry/") || id.replace(/\\/g, "/").startsWith(src + "/registry/")) throw new Error(`not vendored: ${id} (run node tools/live_components.mjs --vendor)`);
    return null;
  },
  // The shell's own screens and patches first (hologram.screens.mjs); then upstream's screens, which call the
  // components with Base UI's props, are rewritten for the kit's, which are Radix (hologram.radix.mjs).
  transform(code, id) {
    const file = id.replace(/\\/g, "/").split("?")[0];
    const loader = editorLoaderSource(file, code);
    if (loader !== null) {
      projectedEditorLoaders.add(file);
      return { code: loader, map: null };
    }
    if (!file.startsWith(src) || !/\.tsx?$/.test(file)) return null;
    const shell = screenSource(file, code);
    // A .ts module has no JSX to rewrite for Radix: its patches are all it gets.
    if (file.endsWith(".ts")) return shell === code.replace(/\r\n/g, "\n") ? null : { code: shell, map: null };
    if (file.includes("/components/ui/")) return shell === code ? null : { code: shell, map: null };
    const r = toRadix(shell, path.relative(__dirname, file));
    if (r.problems.length) this.error("not rewritten for Radix:\n" + r.problems.join("\n"));
    return r.code === code ? null : { code: r.code, map: null };
  },
  generateBundle() {
    if (!projectedEditorLoaders.size)
      this.error("The locked editor loader projection was not applied");
    const missed = unapplied();
    if (missed.length) this.error("patches the build never applied (their file was not read):\n" + missed.join("\n"));
    const bad = audit(this.getModuleIds(), (id) => [...(this.getModuleInfo(id)?.importers ?? [])]);
    if (bad.length) this.error("ui components refused:\n" + bad.join("\n"));
  },
};
const kitSource = path.relative(path.join(src, "styles"), kitUi).replace(/\\/g, "/");

const hologramWords: Plugin = {
  name: "hologram-words",
  enforce: "pre",
  resolveId(id, importer) {
    const from = importer ? importer.replace(/\\/g, "/") : "";
    if (id.endsWith("assets/logo.svg") && from.startsWith(src)) return mark;
    // Two providers answer here, the device and OpenRouter, so the model picker is ours: a flat list
    // of their models, nothing else. Upstream's has submenus, a recent section, effort levels, price
    // badges, a trial banner and a Pro upsell, none of which this product has.
    if (/(^|\/)ModelPicker$/.test(id) && from.startsWith(src)) return picker;
    if (/(^|\/)ChatModeSelector$/.test(id) && from.startsWith(src)) return modeSelector;
    // GitHub connects with a pasted token: Upstream's device flow is served to apps, not to web pages.
    if (/(^|\/)GitHubIntegration$/.test(id) && from.startsWith(src)) return githubIntegration;
    // Upstream's analytics are upstream's PostHog project: initialised on every load, they reached its servers
    // (and handed them the visitor's address) even with telemetry off. This product sends nothing there.
    if ((id === "posthog-js" || id === "posthog-js/react") && from.startsWith(src)) return posthogStub;
    // Import App takes a Forge export file: a web page has no folder to import from, and apps made on the
    // site Forge was served from before stay in that origin's storage until its moved page exports them.
    if (/(^|\/)ImportAppDialog$/.test(id) && from.startsWith(src)) return importDialog;
    // Vercel, Coolify, Supabase and Neon are other companies' servers: their screens draw nothing here.
    if (REMOVED_INTEGRATIONS.test(id) && from.startsWith(src)) return removedIntegrations;
    return null;
  },
  transform(code, id) {
    const file = id.replace(/\\/g, "/").split("?")[0];
    if (!file.startsWith(src)) return null;
    if (file.endsWith("/styles/globals.css")) {
      let out = code.replace(/\r\n/g, "\n").replace(/@font-face\s*\{[^}]*node_modules\/geist[^}]*\}\s*/g, "");
      const cut = (open: string) => {
        const at = out.indexOf(open);
        const end = out.indexOf("\n}\n", at);
        if (at < 0 || end < 0) throw new Error("globals.css: block not found: " + open);
        out = out.slice(0, at) + out.slice(end + 3);
      };
      cut(":root {");
      cut("\n.dark {");
      // Tailwind scans the kit's components too: they live outside this tree.
      out = out.replace('@import "tw-animate-css";', `@import "tw-animate-css";\n@source "${kitSource}";`);
      return { code: out + "\n" + theme, map: null };
    }
    if (!/\.(tsx?|jsx?|json|md)$/.test(file)) return null;
    let out = code;
    if (file.endsWith("/pages/home.tsx")) out = out.replace('className="text-4xl font-semibold tracking-tight text-foreground"', 'className="font-display text-5xl font-semibold text-foreground"');
    // Three controls the product does without: the setup pill under the home composer (providers are
    // set up by the host), the Pro selector (upstream's paid tier), and the voice to text button (Pro).
    if (file.endsWith("/pages/home.tsx")) out = out.replace(/\{!isSettingsLoading &&\s*!isLoadingLanguageModelProviders &&\s*!hasPrismProApiKey && \(/, "{false && (");
    if (file.endsWith("/components/ChatInputControls.tsx")) out = out.replace("<ProModeSelector />", "{null}");
    // The promo row under the composer rotates upstream's Pro upsells and links to upstream's own GitHub,
    // subreddit and X account: a subscription this product does not sell, and channels that are not
    // Hologram's. The row is not rendered.
    if (file.endsWith("/components/chat/ChatInput.tsx")) out = out.replace("{showPromo && <PromoMessage seed={promo.seed} />}", "{null}");
    // The setup banner's own Pro pitch goes the same way: the trial card and the "tired of waiting"
    // link are upstream's subscription, while the provider buttons under them are what this product
    // offers. The banner keeps its heading and those buttons.
    if (file.endsWith("/components/SetupBanner.tsx")) {
      out = out.replace("<SetupPrismProButton />", "{null}");
      // The trial card is one <button> element: cut it with its matching close tag.
      const at = out.indexOf("onClick={handlePrismProSetupClick}");
      if (at < 0) throw new Error("SetupBanner: the trial card was not found");
      const open = out.lastIndexOf("<button", at);
      let depth = 0, i = open;
      for (;;) {
        const next = out.indexOf("<button", i + 1), end = out.indexOf("</button>", i + 1);
        if (end < 0) throw new Error("SetupBanner: the trial card has no end");
        if (next >= 0 && next < end) { depth += 1; i = next; continue; }
        if (depth === 0) { i = end + "</button>".length; break; }
        depth -= 1; i = end;
      }
      out = out.slice(0, open) + "{null}" + out.slice(i);
    }
    // Annotating a screenshot is upstream's Pro gate on a paid budget; the annotator here is ours (it
    // hands the screenshot back as an attachment), so the gate would put a subscription screen in
    // front of a feature that works.
    if (file.endsWith("/preview_panel/PreviewIframe.tsx")) out = out.replace("{userBudget ? (", "{true ? (");
    // The contracts are published to the page so the host can check its own answers against them
    // (see hologram.contracts.ts). First import in the entry, before anything renders.
    if (file.endsWith("/renderer.tsx")) out = `import ${JSON.stringify(editor)};
import ${JSON.stringify(contracts)};
` + out;
    for (const [hex, role] of Object.entries(arbitrary)) out = out.split(`text-[${hex}]`).join(`text-${role}`).split(`bg-[${hex}]`).join(`bg-${role}`).split(`border-[${hex}]`).join(`border-${role}`);
    return out === code ? null : { code: out, map: null };
  },
};

// The Prism frame (frame/, locked by frame.lock) as the template publishes it (frame/publish.mjs): its
// stylesheets and the brand's tokens baked into their placeholders. It is a second entry with a fixed name,
// assets/prism-frame.js, which the shell imports (shell/inference.js); its panels and Prism ID are chunks.
const repo = path.resolve(__dirname, "../../..");
const FRAME_BAKES: Record<string, [string, string][]> = {
  "frame/frame.mjs": [['"/*CSS*/"', "frame/frame.css"], ['"/*BRAND*/"', "site/brand/hologram-warm.css"]],
  "frame/panels.mjs": [['"/*PANELS_CSS*/"', "frame/panels.css"]],
};
const prismFrame: Plugin = {
  name: "prism-frame",
  transform(code, id) {
    const file = path.relative(repo, id.split("?")[0]).split(path.sep).join("/");
    for (const [mark, css] of FRAME_BAKES[file] ?? []) {
      if (!code.includes(mark)) this.error(`${file} has no ${mark}`);
      code = code.replace(mark, JSON.stringify(fs.readFileSync(path.join(repo, css), "utf8")));
    }
    return FRAME_BAKES[file] ? { code, map: null } : null;
  },
};

// The words and theme transform must run before Tailwind's own transform sees globals.css, so it
// comes first in the plugin order, not appended after the vendored config's plugins.
const merged = mergeConfig(base, {
  build: {
    // dist/.vite/manifest.json: the chunk graph the Performance gate (tools/perf_budget.mjs) reads. It stays
    // in dist; stamp_shell.py copies only dist/assets.
    manifest: true,
    rollupOptions: {
      input: { index: path.resolve(__dirname, "index.html"), "prism-frame": path.join(repo, "frame/frame.mjs") },
      output: {
        entryFileNames: (chunk) => (chunk.name === "prism-frame" ? "assets/prism-frame.js" : "assets/index.js"),
        // The entry keeps its fixed name (the projected page names it); every other chunk is named by its
        // content, so the worker keeps it for good and a page never mixes two builds' chunks.
        chunkFileNames: "assets/[name]-[hash].js",
        assetFileNames: (info) => (info.names?.[0] === "index.css" ? "assets/index.css" : "assets/[name]-[hash][extname]"),
      },
    },
  },
});
merged.plugins = [hologramUi, hologramWords, prismFrame, ...(merged.plugins ?? [])];
export default merged;
