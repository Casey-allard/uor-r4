{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "UOR Harness",
  "version": "0.1.0",
  "identifier": "org.uor.r4.desktop",
  "build": {
    "frontendDist": "./runtime/studio"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; worker-src 'self'",
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "app",
    "externalBin": ["binaries/uor-chat"],
    "resources": {
      "runtime/studio/pkg/": "pkg/",
      "runtime/studio/models.json": "models.json",
      "runtime/studio/SHA256SUMS": "SHA256SUMS"
    },
    "icon": ["icons/icon.png", "icons/icon.icns"]
  }
}
