#!/usr/bin/env bash
# uor-pod — the one shared tool every UOR-R4 lab session uses to see, lease,
# create, share and delete Runpod GPU pods (#820). Rules: docs/labs/compute.md.
# Identity on every mutating command: --lab L --session S (or UOR_POD_SESSION=S).
#
#   uor-pod                                    the rules (one screen)
#   uor-pod status [--du] [--all]              rules, pods (running and stopped), leases,
#                                              per-GPU use, free GPUs, 5090 stock, volume use
#   uor-pod up --lab L --session S --purpose "..." --hours H [--gpu KEY: default ladder 5090 -> 4090 -> pro6000] [--count 2]
#              [--card URL] [--wait [--wait-hours 2]] [--ref SHA|main] [--with-ollama]
#              [--test] [--allow-off-volume] [--no-bootstrap] [--keep-on-failure] [--owner-approved]
#              [--force-retry]   every argument is checked before the Runpod API is called;
#              2 failed `up` of one lab+session within 60 min block a third without --force-retry
#   uor-pod lease   POD --lab L --session S --gpus 0,1 --purpose "..." --hours H [--card URL] [--gpu KEY]
#   uor-pod renew   POD --lab L --session S [--hours H]
#   uor-pod release POD --lab L --session S
#   uor-pod down    POD --lab L --session S [--discard-local] [--confirm-archived]
#   uor-pod run     POD --lab L --session S --gpu K[,K2] -- CMD...
#   uor-pod register POD --lab L --session S --purpose "..." [--gpu KEY] [--keep REASON]
#   uor-pod keep|unkeep POD [--purpose REASON]   protect a pod with unique data from down/reap
#   uor-pod prune-stopped [--older-than 24h] [--yes]   list (and with --yes delete) stopped pods
#   uor-pod ssh     POD [CMD...]
#   uor-pod bootstrap POD [--ref SHA|main] [--with-ollama] [--force]
#   uor-pod seed    POD [--with-ollama] [--via CANONPOD]   copy the hot set (hot-set.txt)
#   uor-pod pull|push POD PATH... [--via CANONPOD]   /workspace PATHs canonical volume <-> POD
#   uor-pod reap                               delete unleased pods idle >= 20 min
#   uor-pod log [-n N]                         tail of the shared event ledger
#   uor-pod gpus                               GPU policy and live stock by datacenter
#
# State (source of truth, shared by every session on this machine):
#   ${UOR_POD_STATE:-~/.local/share/uor-r4/compute}/leases/<pod>/<lab>-<session>.json,
#   ledger.jsonl (append-only), pods.json (cache of what the API does not say).
# Environment: UOR_POD_DRY_RUN=1 prints every mutation (pod/volume create, delete,
# remote writes, GitHub comments) instead of doing it; UOR_POD_SSH_KEY, UOR_POD_BOARD,
# UOR_POD_TEMPLATE and (for tests) UOR_POD_MAX_PODS/UOR_POD_MAX_RATE, UOR_POD_REPO_URL
# (the repository `--ref` must exist on) and UOR_POD_GIT_DIR (the checkout used to
# expand a short SHA) override defaults. Bootstrap logs: $STATE/logs/ and, on the
# pod's volume, /workspace/uor-r4/pods/bootstrap-<pod>-<UTC>.log.
# Secrets: this tool never reads ~/.runpod/config.toml and never prints pod env.
set -euo pipefail

REPO_SLUG=UOR-Foundation/uor-r4
REPO_URL=${UOR_POD_REPO_URL:-https://github.com/$REPO_SLUG.git}
STATE=${UOR_POD_STATE:-$HOME/.local/share/uor-r4/compute}
DRY=${UOR_POD_DRY_RUN:-0}
BOARD=${UOR_POD_BOARD:-2037}
SSH_KEY=${UOR_POD_SSH_KEY:-$HOME/.ssh/uor_compute}
TEMPLATE_ID=${UOR_POD_TEMPLATE:-h15vb984sw}
# Placement order: the network-volume datacenters that list RTX 5090 stock.
# EUR-NO-1's volume is the canonical store; the others get uor-shared-<DC> lazily.
VOLUME_DCS=${UOR_POD_VOLUME_DCS:-EUR-NO-1 EU-RO-1 EUR-IS-1}
# Any-region placement (owner-approved 2026-10-07): when UOR_POD_VOLUME_DCS is
# not set, `up` also tries these Secure datacenters after VOLUME_DCS, the ones
# with more stock first. `runpodctl datacenter list` reports no network-volume
# support (only id, name, location, gpuAvailability), so this is a maintained
# allowlist of datacenters known to be volume-capable on 2026-10-07. A pod here
# gets its own uor-shared-<DC> volume and is non-canonical, as in EU-RO-1.
EXTRA_VOLUME_DCS="US-CO-1 US-NC-2 US-IL-1 US-KS-2 US-TX-3 CA-MTL-1"
[ -z "${UOR_POD_VOLUME_DCS+set}" ] || EXTRA_VOLUME_DCS=''
CANONICAL_DC=EUR-NO-1
VOLUME_ID=lmd1pfah3y
NEW_VOLUME_GB=100
# Owner's spending rule (2026-10-05), not a Runpod limit: <= 4 pods, <= $8/h in
# total, so each lab can run its own 2 x 5090 pod in parallel. Only
# --owner-approved overrides it; the variables exist for the dry-run tests.
MAX_PODS=${UOR_POD_MAX_PODS:-4}
MAX_RATE=${UOR_POD_MAX_RATE:-8.00}
IDLE_MIN=${UOR_POD_IDLE_MIN:-20}
TEST_PREFIX=uor-test-                        # validation/test pods: not counted toward the pod cap
WAIT_INTERVAL=${UOR_POD_WAIT_INTERVAL:-60}
CONTAINER_DISK_GB=60
OFF_VOLUME_DISK_GB=150
SSH_WAIT_SECONDS=${UOR_POD_SSH_WAIT:-900}
HERE=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)

# ---------------------------------------------------------------- GPU policy
# key|Runpod gpuId|CUDA_COMPUTE_CAP|tier   (docs/labs/compute.md "GPU policy")
# default: the only automatic choice (owner decision 2026-10-05: 5090 is
# ~1.7-2x a 4090 per 96M step and ~25% cheaper per job); explicit: only with
# --gpu KEY; forbidden: never automatic, refused without --owner-approved (the
# FP32/TF32 trainer measured A100 at 0.6-0.75x a 4090; revisit after bf16 Phase 2).
GPU_POLICY='5090|NVIDIA GeForce RTX 5090|120|default
4090|NVIDIA GeForce RTX 4090|89|explicit
l40s|NVIDIA L40S|89|explicit
6000ada|NVIDIA RTX 6000 Ada Generation|89|explicit
pro6000|NVIDIA RTX PRO 6000 Blackwell Server Edition|120|explicit
a100|NVIDIA A100 80GB PCIe|80|forbidden
a100sxm|NVIDIA A100-SXM4-80GB|80|forbidden
h100|NVIDIA H100 80GB HBM3|90|forbidden
h100pcie|NVIDIA H100 PCIe|90|forbidden
h200|NVIDIA H200|90|forbidden
b200|NVIDIA B200|100|forbidden'

# `up` without --gpu walks this ladder (owner decision 2026-10-07: 5090, then
# 4090, then RTX PRO 6000); an explicit --gpu KEY tries that GPU only.
GPU_LADDER='5090 4090 pro6000'

gpu_field() {  # gpu_field KEY N -> field N (2 id, 3 cap, 4 tier)
  printf '%s\n' "$GPU_POLICY" | awk -F'|' -v k="$1" -v n="$2" '$1==k {print $n}'
}
gpu_key_of_name() {  # Runpod gpuId or nvidia-smi name -> policy key
  printf '%s\n' "$GPU_POLICY" | awk -F'|' -v n="$1" '
    { id=$2; short=id; sub(/^NVIDIA (GeForce )?/, "", short) }
    n==id || index(n, short) { print $1; exit }'
}

# ---------------------------------------------------------------- helpers
die()  { echo "uor-pod: $*" >&2; exit 1; }
warn() { echo "uor-pod: warning: $*" >&2; }
info() { echo "uor-pod: $*" >&2; }
now_iso() { date -u +%Y-%m-%dT%H:%M:%SZ; }
now_epoch() { date -u +%s; }
# Lease timestamps may come from other tools and hand-written files, so `ts`
# parses any RFC 3339 / ISO 8601 date-time with an explicit offset: fractional
# seconds (".875296"), "Z"/"z", "+HH:MM", "+HHMM" or "+HH", a "T" or a space,
# and plain epoch numbers. It yields null for anything else, including a time
# without an offset (its zone is ambiguous). A null `expires` counts as LIVE
# (fail safe): a malformed lease must never look expired and hand a GPU that
# another session is using to someone else. `status` warns about every such
# lease; its holder rewrites it with `uor-pod renew`. uor-pod itself only writes
# the canonical YYYY-MM-DDTHH:MM:SSZ form (now_iso, plus_hours, write_lease).
# norm_lease adds expires_epoch, live and bad (reasons) to one lease object;
# a lease whose gpus is not a list of indices is read as holding every GPU.
# shellcheck disable=SC2016  # jq source, not shell
JQ_TS='def ts:
  if type == "number" then floor
  elif type != "string" then null
  else (first(capture("^\\s*(?<d>[0-9]{4}-[0-9]{2}-[0-9]{2})[Tt ](?<h>[0-9]{2}):(?<m>[0-9]{2})(:(?<s>[0-9]{2})([.,][0-9]+)?)?\\s*(?<z>[Zz]|[+-][0-9]{2}(:?[0-9]{2})?)\\s*$")) // null) as $c
    | if $c == null then null
      else try (
        ($c.h | tonumber) as $h | ($c.m | tonumber) as $m | (($c.s // "00") | tonumber) as $s
        | if $h > 23 or $m > 59 or $s > 60 then null
          else ("\($c.d)T\($c.h):\($c.m):00Z" | fromdateiso8601) + $s
               - (if ($c.z | ascii_downcase) == "z" then 0
                  else ($c.z | gsub(":"; "")) as $o
                    | (if $o[0:1] == "-" then -1 else 1 end)
                      * (($o[1:3] | tonumber) * 3600 + ((if ($o | length) > 3 then $o[3:5] else "00" end) | tonumber) * 60)
                  end)
          end) catch null
      end
  end;
def canon_ts: ts as $t | if $t == null then null else ($t | todate) end;
def norm_lease:
  (.expires | ts) as $t
  | ((.gpus | type) == "array" and (.gpus | length) > 0 and (.gpus | all(type == "number"))) as $gok
  | . + {expires_epoch: $t,
         live: ($t == null or $t > now),
         gpus: (if $gok then .gpus else [range(0; 8)] end),
         bad: ([if $t == null then "unparseable expires \(.expires | tojson) (treated as LIVE)" else empty end,
                if $gok then empty else "gpus \(.gpus | tojson) is not a list of indices (treated as holding every GPU)" end])};'
iso_epoch() { jq -rn --arg t "$1" "$JQ_TS"'$t | ts // empty'; }
plus_hours() { jq -rn --argjson h "$1" 'now + ($h * 3600) | floor | todate'; }
is_dry() { [ "$DRY" = 1 ]; }
mut() { if is_dry; then echo "DRY-RUN: $*" >&2; else "$@"; fi; }

check_lab() {
  case $1 in ''|*[!a-z0-9-]*) die "lab must match [a-z0-9-]+ (claude, codex, deepseek...)";; esac
}
# Identity = lab + session: several sessions of one lab run at once, and each
# holds its own leases. Sets ID (file/mirror name lab-session) and WHO (lab/session).
check_who() {
  check_lab "$LAB"
  SESSION=${SESSION:-${UOR_POD_SESSION:-}}
  case $SESSION in
    '') die "--session NAME is required (or export UOR_POD_SESSION): leases belong to one session of a lab";;
    *[!a-z0-9-]*) die "session must match [a-z0-9-]+ (got '$SESSION')";;
  esac
  ID="$LAB-$SESSION" WHO="$LAB/$SESSION"
}
check_pod_id() {
  case $1 in ''|*[!a-z0-9]*) die "pod id must be alphanumeric (got '$1')";; esac
}
check_hours() {
  jq -en --arg h "$1" '($h | tonumber) > 0 and ($h | tonumber) <= 24' >/dev/null 2>&1 ||
    die "--hours must be a number in (0, 24] (renew to extend)"
}

mkdir -p "$STATE/leases" "$STATE/idle"
touch "$STATE/ledger.jsonl"
[ -f "$STATE/pods.json" ] || echo '{}' > "$STATE/pods.json"

# One global lock serialises every read-modify-write of the state directory.
# flock(1) when installed, else flock(2) through perl on the same descriptor
# (macOS ships no flock binary); closing fd 9 releases it.
lock_acquire() {
  exec 9>>"$STATE/.lock"
  if command -v flock >/dev/null 2>&1; then
    flock -w 120 9 || die "state lock busy for 120 s ($STATE/.lock)"
  else
    perl -MFcntl=:flock -e 'open(my $f, ">&=", 9) or exit 2; my $t = time + 120;
      until (flock($f, LOCK_EX | LOCK_NB)) { exit 1 if time > $t; select(undef, undef, undef, 0.2) }' ||
      die "state lock busy for 120 s ($STATE/.lock)"
  fi
}
lock_release() { exec 9>&-; }

atomic_write() {  # atomic_write PATH  (content on stdin)
  local tmp
  tmp="$1.tmp.$$"
  cat > "$tmp" && mv -f "$tmp" "$1"
}

ledger() {  # ledger EVENT LAB POD [JSON-OBJECT]  (caller holds the lock or the write is a single append)
  local extra=${4:-'{}'}
  jq -cn --arg ts "$(now_iso)" --arg ev "$1" --arg lab "$2" --arg session "${SESSION:-}" --arg pod "$3" \
    --arg by "${USER:-?}@$(hostname -s 2>/dev/null || echo host)" --argjson x "$extra" \
    '{ts: $ts, event: $ev, lab: $lab, session: $session, pod: $pod, by: $by} + $x' >> "$STATE/ledger.jsonl"
}

board() {  # board TEXT -> one-line comment on the Compute board issue
  local text="[uor-pod] $1"
  if is_dry; then echo "DRY-RUN: gh issue comment $BOARD: $text" >&2; return 0; fi
  gh issue comment "$BOARD" -R "$REPO_SLUG" --body "$text" >/dev/null 2>&1 ||
    warn "could not post to Compute board #$BOARD (event is in the ledger)"
}

# ---------------------------------------------------------------- Runpod API (env never printed)
pods_all() { runpodctl pod list --all -o json | jq '[.[] | del(.env)]'; }
pod_get()  { runpodctl pod get "$1" -o json 2>/dev/null | jq 'del(.env)'; }
gpu_stock() { runpodctl gpu list --include-unavailable -o json; }

cache_get() { jq -c --arg p "$1" '.[$p] // {}' "$STATE/pods.json"; }
cache_put() {  # cache_put POD JSON-OBJECT (merged); caller holds the lock
  jq --arg p "$1" --argjson v "$2" '.[$p] = ((.[$p] // {}) + $v)' "$STATE/pods.json" |
    atomic_write "$STATE/pods.json"
}
cache_del() { jq --arg p "$1" 'del(.[$p])' "$STATE/pods.json" | atomic_write "$STATE/pods.json"; }

# ---------------------------------------------------------------- leases
lease_file() { echo "$STATE/leases/$1/$2.json"; }
read_lease() {  # FILE -> one normalised lease object (see norm_lease); never fails
  local id
  id=$(basename "$1" .json)
  jq -cs "$JQ_TS"'if length == 1 and (.[0] | type) == "object" then .[0] | norm_lease else error("not one object") end' "$1" 2>/dev/null ||
    jq -cn --arg f "$1" --arg id "$id" '{lab: ($id | split("-") | first), session: ($id | split("-") | .[1:] | join("-")), id: $id,
      gpus: [range(0; 8)], purpose: "(unreadable lease file)", expires: null, expires_epoch: null, live: true,
      bad: ["not a JSON lease object (treated as LIVE, holding every GPU)"]}'
}
lease_live() {  # lease_live FILE -> 0 if unexpired (or unparseable: fail safe)
  [ -f "$1" ] && [ "$(read_lease "$1" | jq -r .live)" = true ]
}
all_leases_json() {  # POD -> JSON array of all lease files, normalised, with live/bad/file
  local d="$STATE/leases/$1" f
  if [ -d "$d" ] && ls "$d"/*.json >/dev/null 2>&1; then
    for f in "$d"/*.json; do read_lease "$f" | jq -c --arg f "$f" '. + {file: $f}'; done | jq -cs .
  else
    echo '[]'
  fi
}
live_leases_json() {  # POD -> JSON array of live leases
  all_leases_json "$1" | jq -c '[.[] | select(.live)]'
}
taken_gpus() {  # POD [EXCEPT_ID] -> JSON array of GPU indices under live leases
  live_leases_json "$1" | jq -c --arg ex "${2:-}" '[.[] | select((.id // .lab) != $ex) | .gpus[]] | unique'
}
expired_leases_json() {  # POD -> JSON array of expired leases
  all_leases_json "$1" | jq -c '[.[] | select(.live | not)]'
}

# ---------------------------------------------------------------- SSH
SSH_OPTS=(-o BatchMode=yes -o ConnectTimeout=10 -o ServerAliveInterval=30
  -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o LogLevel=ERROR)
# The API's runtime status sometimes flaps to "initializing" on a healthy pod and
# then omits the SSH block, so the last address seen is kept in $STATE/addr/<pod>.
pod_addr() {  # POD -> "ip port" (empty when not reachable)
  local j a
  j=$(pod_get "$1")
  a=$(echo "$j" | jq -r 'if .ssh.ip and .ssh.port then "\(.ssh.ip) \(.ssh.port)" else empty end' 2>/dev/null)
  mkdir -p "$STATE/addr"
  if [ -n "$a" ]; then
    echo "$a" > "$STATE/addr/$1"
  elif [ "$(echo "$j" | jq -r '.desiredStatus // ""' 2>/dev/null)" = RUNNING ] && [ -s "$STATE/addr/$1" ]; then
    a=$(cat "$STATE/addr/$1")
  fi
  [ -z "$a" ] || echo "$a"
}
pod_ssh() {  # pod_ssh POD CMD...   (stdin passes through)
  local addr ip port
  addr=$(pod_addr "$1"); shift
  [ -n "$addr" ] || { warn "no SSH address (pod not running?)"; return 255; }
  ip=${addr% *}; port=${addr#* }
  ssh -i "$SSH_KEY" -p "$port" "${SSH_OPTS[@]}" "root@$ip" "$@"
}
# SSH is often refused for 1-2 min after a pod reports ready (keys still being
# installed): retry with backoff before declaring failure.
wait_ssh() {  # POD SECONDS -> 0 once `ssh true` works
  local deadline delay=5
  deadline=$(( $(now_epoch) + $2 ))
  until pod_ssh "$1" true </dev/null 2>/dev/null; do
    [ "$(now_epoch)" -lt "$deadline" ] || return 1
    sleep "$delay"; [ "$delay" -ge 30 ] || delay=$((delay * 2))
  done
}

# One read-only probe: GPUs, compute apps, reaper, held GPU locks, unmirrored /root/runs.
# shellcheck disable=SC2016  # expanded on the pod, not here
PROBE='nvidia-smi --query-gpu=index,name,utilization.gpu,memory.used,uuid --format=csv,noheader,nounits 2>/dev/null | sed "s/^/gpu=/"
nvidia-smi --query-compute-apps=gpu_uuid --format=csv,noheader 2>/dev/null | sed "s/^/app=/"
[ -f /root/.uor-idle-since ] && echo "idle_since=$(cat /root/.uor-idle-since)"
if pgrep -f "uor-reaper[.]sh --loop" >/dev/null 2>&1; then echo reaper=1; else echo reaper=0; fi
for f in /root/gpu*.lock; do [ -e "$f" ] || continue; flock -n "$f" true || echo "busy_lock=$f"; done
if [ -d /root/runs ]; then echo "root_runs_kb=$(du -sk /root/runs 2>/dev/null | cut -f1)"; fi
if mountpoint -q /workspace 2>/dev/null; then echo workspace_mount=1; fi
echo probe_ok=1'
probe_pod() { pod_ssh "$1" "$PROBE" 2>/dev/null </dev/null || true; }
probe_val() { printf '%s\n' "$1" | sed -n "s/^$2=//p"; }
probe_idle() {  # PROBE-OUTPUT -> 0 when every GPU is at <=2 % and no compute process runs
  local out=$1
  [ -n "$(probe_val "$out" probe_ok)" ] || return 1
  [ -z "$(probe_val "$out" app)" ] || return 1
  [ -z "$(probe_val "$out" busy_lock)" ] || return 1
  probe_val "$out" gpu | awk -F', *' '$3 > 2 { busy = 1 } END { exit busy }'
}

# Per-GPU state from one probe: busy = >= 5 % utilisation, a compute process on
# that GPU, or a held /root/gpuK.lock. Idle time is tracked across probes in
# $STATE/gpuidle/<pod>.json. An idle GPU under a live lease is NOT free: only its
# holder (release) or expiry frees it.
gpu_states() {  # POD PROBE -> JSON [{gpu, util, mem, busy, lab, expired_by, idle_min}]
  local f="$STATE/gpuidle/$1.json" rows
  mkdir -p "$STATE/gpuidle"
  [ -s "$f" ] || echo '{}' > "$f"
  rows=$(jq -n --arg g "$(probe_val "$2" gpu)" --arg a "$(probe_val "$2" app)" --arg l "$(probe_val "$2" busy_lock)" \
    --argjson leases "$(live_leases_json "$1")" --argjson expired "$(expired_leases_json "$1")" --argjson prev "$(cat "$f")" --argjson now "$(now_epoch)" '
    ($a | split("\n") | map(select(length > 0))) as $apps
    | ($l | split("\n") | map(select(length > 0) | capture("gpu(?<k>[0-9]+)[.]lock").k | tonumber)) as $locked
    | [$g | split("\n")[] | select(length > 0) | split(", ")
       | {gpu: (.[0] | tonumber), util: (.[2] | tonumber), mem: (.[3] | tonumber), uuid: (.[4] // "")}]
    | map(. as $r
        | .busy = (.util >= 5 or (.uuid != "" and ($apps | index($r.uuid)) != null) or ($locked | index($r.gpu)) != null)
        | .lab = ([$leases[] | select(.gpus | index($r.gpu)) | "\(.lab)/\(.session // "-")"] | first // null)
        | .expired_by = ([$expired[] | select(.gpus | index($r.gpu)) | "\(.lab)/\(.session // "-")"] | first // null)
        | .since = (if .busy then null else ($prev[$r.gpu | tostring] // $now) end)
        | .idle_min = (if .since then (($now - .since) / 60 | floor) else null end))')
  echo "$rows" | jq '[.[] | select(.since) | {key: (.gpu | tostring), value: .since}] | from_entries' | atomic_write "$f"
  echo "$rows"
}
gpu_free_lines() {  # POD STATES-JSON -> "POD free K [EXPIRED-HOLDER]" lines (no live lease, not busy)
  echo "$2" | jq -r --arg p "$1" '.[] | select(.lab == null and (.busy | not))
    | "\($p) free \(.gpu) \(.expired_by // "")"'
}
free_report() {  # PODS-JSON -> human summary of GPUs a lab can use now (probes every running pod)
  local id probe lines='' st
  for id in $(echo "$1" | jq -r '.[] | select(.desiredStatus == "RUNNING") | .id'); do
    probe=$(probe_pod "$id")
    [ -n "$(probe_val "$probe" probe_ok)" ] || continue
    st=$(gpu_states "$id" "$probe")
    lines="$lines$(gpu_free_lines "$id" "$st")
"
  done
  printf '%s' "$lines" | format_free
}
format_free() {  # gpu_free_lines output on stdin -> summary lines
  awk '
    $2 == "free" { u[$1] = u[$1] (u[$1] ? "," : "") $3; if ($4 != "") x[$1] = x[$1] " gpu" $3 "<-expired lease of " $4 }
    END { for (p in u) printf "  %s gpus %s: free -> uor-pod lease %s --lab L --session S --gpus %s --purpose ... --hours H%s\n", p, u[p], p, u[p], (x[p] ? "  (takes over" x[p] ")" : "") }'
}
no_gpu_guidance() {  # printed whenever a lease/up attempt is refused
  echo "  No free GPU? If the pod/rate caps allow it, spin up your own pod: uor-pod up --lab L --session S --purpose ... --hours H" >&2
  echo "  (2 x RTX 5090; EUR-NO-1 -> EU-RO-1 -> EUR-IS-1). Never fall back to the laptop CPU, never use another session's GPU." >&2
}

mirror_lease() {  # POD ID  -> copy the laptop lease to /root/leases/<lab>-<session>.json (best effort)
  local f
  f=$(lease_file "$1" "$2")
  if is_dry; then echo "DRY-RUN: mirror $f -> $1:/root/leases/$2.json" >&2; return 0; fi
  [ "$(pod_get "$1" | jq -r '.desiredStatus // ""')" = RUNNING ] ||
    { warn "pod $1 not running; lease not mirrored"; return 0; }
  pod_ssh "$1" "mkdir -p /root/leases && cat > /root/leases/.$2.tmp && mv -f /root/leases/.$2.tmp /root/leases/$2.json" < "$f" ||
    warn "could not mirror the lease onto $1: its pod-side reaper may not see it — retry renew"
}
unmirror_lease() {
  if is_dry; then echo "DRY-RUN: remove $1:/root/leases/$2.json" >&2; return 0; fi
  [ "$(pod_get "$1" | jq -r '.desiredStatus // ""')" = RUNNING ] || return 0
  pod_ssh "$1" "rm -f /root/leases/$2.json" </dev/null || warn "could not remove the mirrored lease on $1"
}

# ---------------------------------------------------------------- argument parsing
LAB='' SESSION='' ID='' WHO='' PURPOSE='' HOURS='' CARD='' GPUS='' GPU='' COUNT='' REF=main
OWNER_OK=0 OFF_VOLUME=0 WAIT=0 WAIT_HOURS=2 NO_BOOT=0 KEEP_FAIL=0 OLLAMA=0 FORCE=0 FORCE_RETRY=0 OPTS_SEEN=''
LADDER=0 NO_MIRROR=0 DISCARD_LOCAL=0 CONFIRM_ARCHIVED=0 DU=0 NLINES=20 VIA='' UP_TEST=0 KEEP_REASON='' OLDER=24h YES=0
POS=()
parse() {
  while [ $# -gt 0 ]; do
    case $1 in -?*) [ "$1" = -- ] || OPTS_SEEN="$OPTS_SEEN $1";; esac
    case $1 in
      --lab) LAB=${2:?--lab needs a value}; shift 2;;
      --session) SESSION=${2:?--session needs a value}; shift 2;;
      --older-than) OLDER=${2:?}; shift 2;;
      --yes) YES=1; shift;;
      --all) shift;;  # status always lists stopped pods
      --purpose) PURPOSE=${2:?}; shift 2;;
      --hours) HOURS=${2:?}; shift 2;;
      --card) CARD=${2:?}; shift 2;;
      --gpus) GPUS=${2:?}; shift 2;;
      --gpu) GPU=${2:?}; shift 2;;
      --count) COUNT=${2:?}; shift 2;;
      --ref) REF=${2:?}; shift 2;;
      --via) VIA=${2:?}; shift 2;;
      -n) NLINES=${2:?}; shift 2;;
      --owner-approved) OWNER_OK=1; shift;;
      --force-retry) FORCE_RETRY=1; shift;;
      --allow-off-volume) OFF_VOLUME=1; shift;;
      --wait) WAIT=1; shift;;
      --wait-hours) WAIT_HOURS=${2:?}; shift 2
        jq -en --arg h "$WAIT_HOURS" '($h | tonumber) > 0 and ($h | tonumber) <= 24' >/dev/null 2>&1 || die "--wait-hours must be in (0, 24]";;
      --no-bootstrap) NO_BOOT=1; shift;;
      --keep-on-failure) KEEP_FAIL=1; shift;;
      --with-ollama) OLLAMA=1; shift;;
      --force) FORCE=1; shift;;
      --no-mirror) NO_MIRROR=1; shift;;
      --discard-local) DISCARD_LOCAL=1; shift;;
      --confirm-archived|--confirm-pushed) CONFIRM_ARCHIVED=1; shift;;
      --du) DU=1; shift;;
      --test) UP_TEST=1; shift;;
      --keep) KEEP_REASON=${2:?}; shift 2;;
      --) shift; POS+=("$@"); break;;
      -*) die "unknown option $1";;
      *) POS+=("$1"); shift;;
    esac
  done
}
gpus_json() {  # "0,1" -> [0,1]
  printf '%s' "$1" | jq -Rc 'split(",") | map(select(length > 0) | tonumber) | unique' 2>/dev/null ||
    die "--gpus must look like 0 or 0,1"
}

# ---------------------------------------------------------------- rules
print_rules() {
  cat <<RULES
UOR-R4 shared GPU pods — rules (docs/labs/compute.md; AGENTS.md "GPU pods")
 1. Only this tool touches pods. Run 'uor-pod status' before any GPU work.
 2. Identity = --lab L --session S (or UOR_POD_SESSION). Lease the GPUs you use:
    uor-pod lease POD --lab L --session S --gpus 0,1 --purpose ... --hours H
    renew every <= 30 min while working; release when done. Leases auto-expire.
 3. Another session's GPU is never yours, even when idle: only its holder
    (release) or expiry frees it. An EXPIRED lease may be taken over after a
    probe shows no live job. Never touch another session's lease or KEEP_ALIVE.
 4. No free GPU and caps allow (<= $MAX_PODS pods, <= \$$MAX_RATE/h, all labs together):
    uor-pod up --lab L --session S --purpose ... --hours H  (2 x RTX 5090;
    EUR-NO-1 -> EU-RO-1 -> EUR-IS-1). Never fall back to the laptop CPU.
    Caps reached and nothing free: wait for an expiry or ask the owner.
 5. One job per GPU: uor-pod run POD --lab L --session S --gpu K -- CMD (device=cuda).
 6. Durable output only on /workspace (network volume). No stopped pods as storage.
 7. Done: release, then 'uor-pod down POD' if no other session holds it.
    Never print API keys or ~/.runpod/config.toml.
RULES
}

# ---------------------------------------------------------------- status
cmd_status() {
  local pods total=0 n_run=0 n_cap=0 id states freelines='' free keep stopped=0 badlines=''
  print_rules
  echo
  pods=$(pods_all)
  echo "Pods (caps: <= $MAX_PODS running pods, <= \$$MAX_RATE/h; idle reap after $IDLE_MIN min without a live lease)"
  for id in $(echo "$pods" | jq -r '.[].id'); do
    local p name st n cost up leases cache gtype live flag probe line
    p=$(echo "$pods" | jq -c --arg i "$id" '.[] | select(.id == $i)')
    name=$(echo "$p" | jq -r .name); st=$(echo "$p" | jq -r .desiredStatus)
    n=$(echo "$p" | jq -r '.gpuCount // 0'); cost=$(echo "$p" | jq -r '.costPerHr // 0')
    up=$(echo "$p" | jq -r '((.uptimeSeconds // 0) / 3600 * 10 | floor) / 10')
    cache=$(cache_get "$id"); gtype=$(echo "$cache" | jq -r '.gpu // "?"')
    if [ "$st" = RUNNING ]; then
      n_run=$((n_run + 1)); total=$(jq -n --argjson a "$total" --argjson b "$cost" '($a + $b) * 100 | round / 100')
      case $name in "$TEST_PREFIX"*) ;; *) n_cap=$((n_cap + 1));; esac
    fi
    keep=$(echo "$cache" | jq -r '.keep // empty')
    leases=$(all_leases_json "$id")
    live=$(echo "$leases" | jq '[.[] | select(.live)] | length')
    flag=''
    if [ "$st" = RUNNING ] && [ "$live" = 0 ]; then flag='  <-- NO LIVE LEASE (reap candidate)'; fi
    if [ "$st" != RUNNING ]; then
      stopped=$((stopped + 1))
      flag="  <-- CLEANUP: stopped since $(echo "$p" | jq -r '.lastStatusChange // "?"' | sed 's/^[^:]*: //; s/ GMT.*//'); bills container disk. Copy what matters to the volume, then delete (uor-pod prune-stopped)"
    fi
    printf '%s %-24s %-8s %sx%-7s $%-5s/h up %sh vol=%s%s\n' "$id" "$name" "$st" "$n" "$gtype" "$cost" "$up" \
      "$(echo "$cache" | jq -r 'if .off_volume then "OFF" elif .volume == false then "none" elif .canonical == false then "non-canonical" elif .volume then "yes" else "?" end')" "$flag"
    [ -z "$keep" ] || echo "    KEEP (never down/reap): $keep"
    echo "$leases" | jq -r '.[] | "    lease \(.lab)/\(.session // "-") gpus=\(.gpus | map(tostring) | join(",")) until \(.expires)\(if (.bad | length) > 0 then " [MALFORMED: treated as LIVE]" else "" end) \(if .live then "" else "EXPIRED (abandoned: may be taken over once a probe shows no live job)" end) — \(.purpose)\(if (.card // "") != "" then " [" + .card + "]" else "" end)"'
    badlines="$badlines$(echo "$leases" | jq -r '.[] | select((.bad | length) > 0) | "  \(.file): \(.bad | join("; "))"')
"
    if [ "$st" = RUNNING ]; then
      probe=$(probe_pod "$id")
      if [ -n "$(probe_val "$probe" probe_ok)" ]; then
        states=$(gpu_states "$id" "$probe")
        echo "$states" | jq -r '.[] | "    gpu \(.gpu) \(.util)% \(.mem) MiB  "
          + (if .lab then "leased by \(.lab)" else "no live lease" end) + "  "
          + (if .busy then "BUSY"
             elif .lab == null then "idle -> FREE, lease it" + (if .expired_by then " (expired lease of \(.expired_by))" else "" end)
             else "leased but idle \(.idle_min // 0) min (not free: only the holder or expiry frees it)" end)'
        freelines="$freelines$(gpu_free_lines "$id" "$states")
"
        line="    reaper=$(probe_val "$probe" reaper)"
        [ -n "$(probe_val "$probe" idle_since)" ] && line="$line idle_since=$(probe_val "$probe" idle_since)"
        [ -n "$(probe_val "$probe" busy_lock)" ] && line="$line busy_locks=$(probe_val "$probe" busy_lock | tr '\n' ' ')"
        [ -n "$(probe_val "$probe" root_runs_kb)" ] && line="$line /root/runs=$(probe_val "$probe" root_runs_kb)KB"
        echo "$line"
        if [ "$gtype" = '?' ]; then
          gtype=$(gpu_key_of_name "$(probe_val "$probe" gpu | head -1 | awk -F', *' '{print $2}')")
          if [ -n "$gtype" ]; then lock_acquire; cache_put "$id" "{\"gpu\":\"$gtype\"}"; lock_release; fi
        fi
      else
        echo "    (SSH probe failed: GPU use unknown)"
      fi
    fi
  done
  # lease files of pods the API no longer lists: archive them (the ledger keeps the history)
  local d gone
  for d in "$STATE"/leases/*/; do
    [ -d "$d" ] || continue
    gone=$(basename "$d")
    if ! echo "$pods" | jq -e --arg i "$gone" 'any(.[]; .id == $i)' >/dev/null; then
      if ls "$d"*.json >/dev/null 2>&1 && ! is_dry; then
        lock_acquire
        mkdir -p "$STATE/gone"; mv "$d" "$STATE/gone/$gone-$(date -u +%Y%m%dT%H%M%SZ)"
        ledger gone '' "$gone" '{"note": "pod no longer listed by Runpod; lease files archived"}'
        lock_release
        echo "$gone: gone from Runpod; its lease files were archived under $STATE/gone/"
      fi
    fi
  done
  # stray temporary files (an interrupted write); leases are written only by this tool
  local strays
  strays=$(find "$STATE" \( -name '*.tmp*' -o -name '*.new' \) -mmin +2 2>/dev/null | head -5)
  [ -z "$strays" ] || echo "WARNING: stray temporary files in the state directory (interrupted writes; leases must be written only by uor-pod): $strays"
  if [ -n "$badlines" ]; then
    echo "WARNING: MALFORMED LEASE FILE(S) — each is treated as LIVE (fail safe), so its GPUs stay blocked until it is fixed."
    echo "  The holder fixes it with 'uor-pod renew POD --lab L --session S' (rewrites the canonical form); leases are written only by uor-pod:"
    printf '%s\n' "$badlines" | sed '/^$/d'
    printf '%s\n' "$badlines" | sed '/^$/d; s/^/uor-pod: warning: malformed lease /' >&2
  fi
  echo "Running: $n_run pod(s) ($n_cap counted toward the cap of $MAX_PODS; $TEST_PREFIX* pods are not), \$$total/h of \$$MAX_RATE/h"
  [ "$stopped" = 0 ] || echo "Stopped pods: $stopped (cleanup items: do not keep stopped pods as storage)"
  free=$(printf '%s' "$freelines" | format_free)
  if [ -n "$free" ]; then
    echo "Free GPUs you can lease now:"
    echo "$free"
  elif [ "$n_cap" -ge "$MAX_PODS" ]; then
    echo "Free GPUs you can lease now: none, and the pod cap is reached: wait for a lease to expire or ask the owner. Never fall back to the laptop CPU."
  else
    echo "Free GPUs you can lease now: none. Spin up your own pod: uor-pod up --lab L --session S --purpose ... --hours H. Never fall back to the laptop CPU."
  fi
  print_stock_table "$(gpu_stock)" "5090 4090"
  if [ "$DU" = 1 ]; then
    local vp
    vp=$(volume_pod "$pods") || { echo "Volume $VOLUME_ID: no running pod mounts it; usage unknown"; return 0; }
    echo "Volume $VOLUME_ID usage (du via $vp; quota 200 GB):"
    pod_ssh "$vp" 'timeout 300 du -sh /workspace/* 2>/dev/null | sort -h; timeout 300 du -sh /workspace 2>/dev/null' </dev/null |
      sed 's/^/    /' || echo "    du failed"
  else
    echo "Volume $VOLUME_ID: run 'uor-pod status --du' for usage (du over the network volume takes a while)"
  fi
}

# Stopped pods bill container-disk storage and hide unsaved files. Durable data
# lives on the network volume; a stopped pod is copied now or accepted as lost.
cmd_prune_stopped() {
  local pods secs list id
  secs=$(echo "$OLDER" | awk '/^[0-9]+h$/ { print $0 * 3600; next } /^[0-9]+d$/ { print $0 * 86400; next } /^[0-9]+m$/ { print $0 * 60; next } { print -1 }')
  [ "$secs" -ge 0 ] 2>/dev/null || die "--older-than takes e.g. 24h, 2d or 90m"
  pods=$(pods_all)
  list=$(echo "$pods" | jq -r '.[] | select(.desiredStatus != "RUNNING") | .id')
  [ -n "$list" ] || { echo "No stopped pods."; return 0; }
  for id in $list; do
    local p since age keep
    p=$(echo "$pods" | jq -c --arg i "$id" '.[] | select(.id == $i)')
    since=$(echo "$p" | jq -r '.lastStatusChange // ""' | sed -n 's/^[^:]*: [A-Z][a-z][a-z] \([A-Z][a-z][a-z] [0-9]* [0-9]* [0-9:]*\).*/\1/p')
    age=$(jq -rn --arg s "$since" 'try (($s | strptime("%b %d %Y %H:%M:%S") | mktime) as $t | (now - $t) | floor) catch -1')
    keep=$(cache_get "$id" | jq -r '.keep // empty')
    printf '%s %-24s %s stopped %s (%s h)%s\n' "$id" "$(echo "$p" | jq -r .name)" "$(echo "$p" | jq -r .desiredStatus)" \
      "${since:-?}" "$( [ "$age" -ge 0 ] && echo $((age / 3600)) || echo '?')" "${keep:+  KEEP: $keep}"
    if [ "$YES" != 1 ]; then continue; fi
    if [ -n "$keep" ]; then echo "  skipped: marked KEEP"; continue; fi
    if [ "$age" -lt "$secs" ]; then echo "  skipped: stopped for less than $OLDER"; continue; fi
    mut runpodctl pod delete "$id" >/dev/null
    lock_acquire; ledger prune-stopped "${LAB:-}" "$id" "{\"stopped_s\": $age}"; lock_release
    board "prune-stopped $id (stopped $((age / 3600)) h; durable data belongs on the volume)${LAB:+ by=$LAB/${SESSION:-}}"
    echo "  deleted"
  done
  [ "$YES" = 1 ] || echo "Listed only. Confirm nothing unique is on them (owner approval for pods with data), then re-run with --yes."
}

volume_pod() {  # PODS-JSON -> id of a running pod mounting the shared volume
  local id
  for id in $(echo "$1" | jq -r '.[] | select(.desiredStatus == "RUNNING") | .id'); do
    if [ "$(pod_get "$id" | jq -r '.networkVolumeId // ""')" = "$VOLUME_ID" ]; then echo "$id"; return 0; fi
  done
  return 1
}

# ---------------------------------------------------------------- up
stock_in() {  # STOCK-JSON GPU-ID DC -> stock status ('' when none)
  echo "$1" | jq -r --arg g "$2" --arg dc "$3" \
    '.[] | select(.gpuId == $g) | .dataCenterAvailability[]? | select(.dataCenterId == $dc) | .stockStatus // ""
     | select(. != "none" and . != "")' | head -1
}
extra_dcs_by_stock() {  # STOCK-JSON GPU-ID -> the EXTRA_VOLUME_DCS with stock, High before Medium before Low
  [ -n "$EXTRA_VOLUME_DCS" ] || return 0
  echo "$1" | jq -r --arg g "$2" --arg x " $EXTRA_VOLUME_DCS " \
    '[.[] | select(.gpuId == $g) | .dataCenterAvailability[]?
      | .dataCenterId as $d | select((.stockStatus // "") != "none" and (.stockStatus // "") != "" and ($x | contains(" " + $d + " ")))
      | {d: .dataCenterId, r: ({"High": 0, "Medium": 1, "Low": 2}[.stockStatus] // 3)}]
     | sort_by(.r) | .[].d'
}
price_of() { echo "$1" | jq -r --arg g "$2" '.[] | select(.gpuId == $g) | .securePricePerHr // empty' | head -1; }
print_stock_table() {  # STOCK-JSON [KEYS]
  local stock=$1 k
  echo "Stock by datacenter (secure \$/GPU/h; * = volume datacenter, placement order $VOLUME_DCS):"
  for k in ${2:-5090 4090 pro6000 l40s 6000ada}; do
    echo "$stock" | jq -r --arg g "$(gpu_field "$k" 2)" --arg k "$k" --arg vdcs " $VOLUME_DCS " \
      '.[] | select(.gpuId == $g) | "  \($k) $\(.securePricePerHr // "?"): \([.dataCenterAvailability[]? | select(.stockStatus != "none" and .stockStatus != "")
        | .dataCenterId as $d | "\($d)\(if ($vdcs | contains(" " + $d + " ")) then "*" else "" end)=\(.stockStatus)"] | join(" ") | if . == "" then "no stock" else . end)"'
  done
}

volume_for_dc() {  # DC -> id of the lab volume uor-shared-<DC> ('' when none)
  if [ "$1" = "$CANONICAL_DC" ]; then echo "$VOLUME_ID"; return 0; fi
  runpodctl network-volume list -o json | jq -r --arg n "uor-shared-$1" --arg dc "$1" \
    '.[] | select(.name == $n and .dataCenterId == $dc) | .id' | head -1
}
ensure_volume() {  # DC -> volume id; creates uor-shared-<DC> (100 GB, owner-approved 2026-10-05) on first use
  local v
  v=$(volume_for_dc "$1")
  if [ -n "$v" ]; then echo "$v"; return 0; fi
  if is_dry; then
    echo "DRY-RUN: runpodctl network-volume create --name uor-shared-$1 --size $NEW_VOLUME_GB --data-center-id $1" >&2
    echo "dryrunvolume"; return 0
  fi
  v=$(runpodctl network-volume create --name "uor-shared-$1" --size "$NEW_VOLUME_GB" --data-center-id "$1" -o json | jq -r '.id // empty')
  [ -n "$v" ] || return 1
  ledger volume-create "$LAB" '' "$(jq -cn --arg v "$v" --arg dc "$1" --argjson gb "$NEW_VOLUME_GB" '{volume: $v, dc: $dc, gb: $gb}')"
  board "volume-create $v uor-shared-$1 ($NEW_VOLUME_GB GB) for $WHO — non-canonical: seed the hot set, archive results to $CANONICAL_DC"
  echo "$v"
}

# One placement attempt (caller holds the lock). Sets UP_* or returns 2 when no stock.
up_attempt() {
  local req=$1 count=$2 pods stock id free gtype probe states n_run rate gid price dc='' off=0 add
  UP_CAPMSG=''
  pods=$(pods_all); stock=$(gpu_stock)

  # 1. a free leased-compatible GPU already exists? (same GPU type, or type not yet known)
  for id in $(echo "$pods" | jq -r '.[] | select(.desiredStatus == "RUNNING") | .id'); do
    gtype=$(cache_get "$id" | jq -r '.gpu // "?"')
    [ "$gtype" = "$req" ] || [ "$gtype" = '?' ] || continue
    # A missing/expired lease alone is not evidence that a GPU is idle.
    # Use the same live process/utilisation/lock admission as status.
    probe=$(probe_pod "$id")
    [ -n "$(probe_val "$probe" probe_ok)" ] || continue
    states=$(gpu_states "$id" "$probe") || continue
    free=$(echo "$states" | jq -c '[.[] | select(.lab == null and .busy == false) | .gpu] | unique') || continue
    # (a --test pod validates pod creation itself, so free GPUs elsewhere do not stop it)
    if [ "$(echo "$free" | jq length)" -ge "$count" ] 2>/dev/null && [ "$OWNER_OK" != 1 ] && [ "$UP_TEST" != 1 ]; then
      lock_release
      echo "Free GPUs already exist: pod $id ($gtype) gpus $(echo "$free" | jq -r 'map(tostring) | join(",")')"
      echo "Lease them instead:  uor-pod lease $id --lab $LAB --session $SESSION --gpus $(echo "$free" | jq -r 'map(tostring) | join(",")') --purpose \"...\" --hours $HOURS"
      [ "$gtype" = '?' ] && echo "(GPU type of $id unknown to the cache; 'uor-pod status' records it)"
      exit 3
    fi
  done

  # 2. caps
  n_run=$(echo "$pods" | jq --arg t "$TEST_PREFIX" '[.[] | select(.desiredStatus == "RUNNING" and ((.name // "") | startswith($t) | not))] | length')
  rate=$(echo "$pods" | jq '[.[] | select(.desiredStatus == "RUNNING") | .costPerHr // 0] | (add // 0) * 100 | round / 100')
  if [ "$UP_TEST" != 1 ] && [ $((n_run + 1)) -gt "$MAX_PODS" ] && [ "$OWNER_OK" != 1 ]; then
    lock_release
    local free
    free=$(free_report "$pods")
    if [ -n "$free" ]; then
      echo "cap reached ($n_run of $MAX_PODS pods) — free GPUs exist; lease those:"
      echo "$free"
      exit 4
    fi
    die "cap reached ($n_run of $MAX_PODS pods) and no GPU is free: wait for a lease to expire (uor-pod status) or ask the owner. Do not fall back to the laptop CPU because of the cap."
  fi
  gid=$(gpu_field "$req" 2); price=$(price_of "$stock" "$gid")
  if [ -z "$price" ] && [ "$LADDER" = 1 ]; then info "no secure-cloud listing for $gid"; UP_STOCK=$(print_stock_table "$stock"); return 2; fi
  [ -n "$price" ] || { lock_release; die "no secure-cloud price listed for $gid"; }
  add=$(jq -n --argjson p "$price" --argjson c "$count" '$p * $c')
  if jq -en --argjson r "$rate" --argjson a "$add" --argjson m "$MAX_RATE" '$r + $a > $m' >/dev/null && [ "$OWNER_OK" != 1 ]; then
    # ladder: a rung that busts the rate cap is a miss like a rung without stock,
    # so the next (cheaper) rung or the 1x fallback still gets its chance
    UP_CAPMSG="cap: running \$$rate/h + new \$$add/h exceeds \$$MAX_RATE/h; needs --owner-approved"
    if [ "$LADDER" = 1 ]; then info "$count x $req: $UP_CAPMSG"; return 2; fi
    lock_release; die "$UP_CAPMSG"
  fi

  # 3. placement candidates: the volume datacenters that list stock, in policy
  # order, never silently elsewhere. Stock can vanish between this listing and
  # `pod create`, so up_create tries every candidate in turn.
  local cands=''
  for dc in $VOLUME_DCS; do
    if [ -n "$(stock_in "$stock" "$gid" "$dc")" ]; then cands="$cands $dc:0"; else info "no $req stock in $dc"; fi
  done
  for dc in $(extra_dcs_by_stock "$stock" "$gid"); do cands="$cands $dc:0"; done
  if [ -z "$cands" ] && [ "$OFF_VOLUME" = 1 ]; then
    for dc in $(echo "$stock" | jq -r --arg g "$gid" '.[] | select(.gpuId == $g) | .dataCenterAvailability[]?
      | select(.stockStatus != "none" and .stockStatus != "") | .dataCenterId'); do
      cands="$cands $dc:1"
    done
    [ -n "$cands" ] && warn "OFF-VOLUME placement: $req in${cands//:1/} with a local /workspace"
  fi
  UP_STOCK=$(print_stock_table "$stock")
  [ -n "$cands" ] || return 2
  UP_CANDS=$cands UP_GID=$gid UP_ADD=$add
  return 0
}

# Stock errors from `pod create`: the datacenter ran out between the stock
# listing and the request. Anything else is a real failure and stops `up`.
NO_STOCK_RE='no longer any instances available|no instances (are )?(currently )?available|not enough (free )?(gpus|instances)|insufficient (capacity|resources)|out of stock|no available (gpus|machines)'

# Create the pod in the first candidate datacenter that accepts it (caller holds
# the lock). Sets POD_JSON, UP_DC, UP_OFF, UP_VOL. Returns 0 when created, 2 when
# every candidate reported no stock; any other create error is fatal.
up_create() {  # COUNT NAME REQ
  local count=$1 name=$2 req=$3 cand dc off vol args created tried='' where new_vol
  for cand in $UP_CANDS; do
    dc=${cand%:*} off=${cand#*:} vol='' new_vol=0
    if [ "$off" = 0 ]; then
      is_dry || [ -n "$(volume_for_dc "$dc")" ] || new_vol=1  # created by this call, not pre-existing
      vol=$(ensure_volume "$dc") || { lock_release; die "could not find or create volume uor-shared-$dc"; }
    fi
    args=(pod create --template-id "$TEMPLATE_ID" --name "$name" --gpu-id "$UP_GID" --gpu-count "$count"
      --data-center-ids "$dc" --cloud-type SECURE --min-cuda-version 12.8
      --container-disk-in-gb "$CONTAINER_DISK_GB" --ports 22/tcp -o json)
    if [ "$off" = 1 ]; then args+=(--volume-in-gb "$OFF_VOLUME_DISK_GB"); else args+=(--network-volume-id "$vol"); fi
    UP_DC=$dc UP_OFF=$off UP_VOL=$vol where=$dc
    if [ "$off" = 1 ]; then where="$dc OFF-VOLUME"; elif [ "$dc" != "$CANONICAL_DC" ]; then where="$dc volume $vol (non-canonical)"; fi
    echo "Creating $count x $req$( [ "${LADDER:-0}" = 1 ] && echo ' (ladder)') (\$$UP_ADD/h) in $where for $WHO: $PURPOSE"
    if is_dry; then
      echo "DRY-RUN: runpodctl ${args[*]}" >&2
      echo "DRY-RUN: if $dc reports no instances available, try next:${UP_CANDS#*"$cand"}" >&2
      POD_JSON='{"id":"dryrunpod"}'
      return 0
    fi
    # stdout alone is the pod JSON (a warning on stderr must not hide the new id)
    if created=$(runpodctl "${args[@]}" 2>"$STATE/.create-err.$$"); then
      rm -f "$STATE/.create-err.$$"
      POD_JSON=$created
      return 0
    fi
    created=$(printf '%s\n%s\n' "$created" "$(cat "$STATE/.create-err.$$" 2>/dev/null)" | sed '/^[[:space:]]*$/d')
    rm -f "$STATE/.create-err.$$"
    if printf '%s' "$created" | grep -qiE "$NO_STOCK_RE"; then
      warn "pod create in $dc: no instances available any more ($(printf '%s' "$created" | tail -1)); trying the next datacenter"
      tried="$tried $dc"
      # a volume this call just created for a datacenter that then had no stock
      # would bill for nothing: remove it (never a pre-existing volume)
      if [ "$new_vol" = 1 ]; then
        if runpodctl network-volume delete "$vol" >/dev/null 2>&1; then
          info "deleted the volume $vol created for $dc (no stock there)"
          ledger volume-delete "$LAB" '' "$(jq -cn --arg v "$vol" --arg dc "$dc" '{volume: $v, dc: $dc, reason: "no stock after create"}')"
        else
          warn "DELETE FAILED for the new volume $vol (uor-shared-$dc) — delete it by hand: runpodctl network-volume delete $vol"
        fi
      fi
      continue
    fi
    lock_release; die "pod create failed in $dc: $(printf '%s' "$created" | tail -3)"
  done
  UP_STOCK="${UP_STOCK:-}
pod create found no instances in:$tried (stock changed after the listing)"
  return 2
}

# Options `up` accepts. Anything else (a typo, an option of another subcommand,
# a stray positional word) is refused before the Runpod API is called: it would
# otherwise be ignored silently or surface only on the billed pod.
UP_OPTS=' --lab --session --purpose --hours --card --gpu --count --wait --wait-hours --ref --with-ollama --test --allow-off-volume --no-bootstrap --keep-on-failure --owner-approved --force-retry '
check_up_args() {
  local o
  for o in $OPTS_SEEN; do
    case $UP_OPTS in *" $o "*) ;; *) die "up does not take $o (nothing was created; uor-pod help)";; esac
  done
  [ ${#POS[@]} = 0 ] || die "up takes no positional arguments (got '${POS[*]}'; nothing was created)"
}

# Circuit breaker (incident 2026-10-05: one session ran `up` 14 times in 2 h; every
# bootstrap failed the same way and each pod was created, billed and deleted).
# BREAKER_MAX `up-failed` events of this lab+session within BREAKER_WINDOW_MIN
# refuse the next `up` until the cause is fixed, unless --force-retry.
BREAKER_MAX=2 BREAKER_WINDOW_MIN=60
breaker_check() {
  local since fails n
  since=$(( $(now_epoch) - BREAKER_WINDOW_MIN * 60 ))
  fails=$(jq -cR --arg lab "$LAB" --arg s "$SESSION" --argjson since "$since" '
    fromjson? | select(type == "object" and .event == "up-failed" and .lab == $lab and .session == $s)
    | select(((.ts // "") | try fromdateiso8601 catch 0) >= $since)' "$STATE/ledger.jsonl")
  n=$(printf '%s' "$fails" | grep -c . || true)
  [ "$n" -ge "$BREAKER_MAX" ] || return 0
  if [ "$FORCE_RETRY" = 1 ]; then
    warn "$WHO had $n failed 'up' attempts in the last $BREAKER_WINDOW_MIN min; retrying because of --force-retry"
    lock_acquire; ledger up-force-retry "$LAB" '' "$(jq -cn --argjson n "$n" --argjson w "$BREAKER_WINDOW_MIN" '{failures: $n, window_min: $w}')"; lock_release
    return 0
  fi
  {
    echo "uor-pod: up refused (circuit breaker): $WHO had $n failed 'up' attempts in the last $BREAKER_WINDOW_MIN min;"
    echo "  each one created, billed and deleted a pod. Failures:"
    printf '%s\n' "$fails" | jq -r '"  \(.ts) pod \(.pod): \(.reason)"
      + (if (.last // "") != "" then "\n    last output: \(.last)" else "" end)
      + (if (.local_log // "") != "" then "\n    log: \(.local_log)" else "" end)
      + (if (.log // "") != "" then "\n    on the pod volume: \(.log)" else "" end)'
    echo "  Read the log and fix the cause first (or test it with 'uor-pod bootstrap POD' on a running pod),"
    echo "  then retry with --force-retry."
  } >&2
  lock_acquire
  ledger up-refused "$LAB" '' "$(jq -cn --argjson n "$n" --argjson w "$BREAKER_WINDOW_MIN" --arg p "$PURPOSE" \
    '{reason: "circuit-breaker", failures: $n, window_min: $w, purpose: $p}')"
  lock_release
  exit 5
}

cmd_up() {
  check_up_args
  [ -n "$LAB" ] && [ -n "$PURPOSE" ] && [ -n "$HOURS" ] || die "up needs --lab, --session, --purpose and --hours"
  check_who; check_hours "$HOURS"
  local req=${GPU:-5090} count=${COUNT:-2} tier rc deadline waited=0 rungs=${GPU:-$GPU_LADDER} want
  LADDER=0; [ -n "$GPU" ] || LADDER=1
  want=$req; [ "$LADDER" = 0 ] || want="ladder ${GPU_LADDER// / -> }"
  tier=$(gpu_field "$req" 4)
  [ -n "$tier" ] || die "unknown --gpu '$req' (policy keys: $(printf '%s\n' "$GPU_POLICY" | cut -d'|' -f1 | tr '\n' ' '))"
  if [ "$tier" = forbidden ] && [ "$OWNER_OK" != 1 ]; then
    die "$req is not used for this trainer (FP32/TF32: measured A100 at 0.6-0.75x an RTX 4090; revisit after bf16 Phase 2); needs --owner-approved citing an owner decision"
  fi
  case $count in 1|2|3|4|5|6|7|8) ;; *) die "--count must be 1..8";; esac
  # every helper `up` will upload is checked before anything is created or paid for
  preflight_helpers
  breaker_check
  # resolve the commit and check the exact bootstrap arguments before anything is
  # created, so a bad ref or argument costs nothing (dry runs check them too)
  if [ "$NO_BOOT" != 1 ]; then
    local ref_in=$REF
    REF=$(resolve_ref "$REF")
    RESOLVED_REF=$REF RESOLVED_SHA=$REF
    [ "$ref_in" = "$REF" ] || info "--ref $ref_in -> $REF"
    preflight_bootstrap_args "$REF"
  fi
  deadline=$(jq -rn --argjson h "$WAIT_HOURS" 'now + $h * 3600 | floor')
  local name canon=false t_create
  name="uor-$LAB-$(date -u +%m%d-%H%M)"
  if [ "$UP_TEST" = 1 ]; then name="$TEST_PREFIX$LAB-$(date -u +%m%d-%H%M)"; fi

  local cap_only
  while :; do
    cap_only=1
    # ladder: the first rung with stock wins; a rung without stock (rc 2) passes
    # to the next. Caps, free-GPU and create errors stop `up` as before.
    for req in $rungs; do
      lock_acquire
      rc=0; up_attempt "$req" "$count" || rc=$?
      if [ "$rc" = 2 ] && [ -n "$UP_CAPMSG" ]; then :; else cap_only=0; fi
      if [ "$rc" = 0 ]; then
        t_create=$(now_epoch)
        up_create "$count" "$name" "$req" || rc=$?
        [ "$rc" = 0 ] && break 2
      fi
      lock_release
      [ "$LADDER" = 0 ] || info "ladder: no $count x $req placed; trying the next rung"
    done
    # "Low" stock usually means one free card per host: without an explicit
    # --count, settle for one GPU rather than wait for a 2-GPU host
    if [ -z "$COUNT" ] && [ "$count" -gt 1 ]; then
      warn "no $count x $want on one host; falling back to 1 x $want (start another pod for a second job)"
      count=1; continue
    fi
    # every rung (and the 1x fallback) failed only on the rate cap
    [ "$cap_only" = 0 ] || die "$UP_CAPMSG"
    echo "$UP_STOCK"
    if [ "$WAIT" != 1 ]; then
      die "no $want stock in $VOLUME_DCS${EXTRA_VOLUME_DCS:+ $EXTRA_VOLUME_DCS}. Re-run with --wait (retries every minute for --wait-hours, default 2)$([ "$req" = 5090 ] && echo ', or choose --gpu 4090 explicitly'); --allow-off-volume places it without a volume"
    fi
    if is_dry; then echo "DRY-RUN: would retry every $((WAIT_INTERVAL / 60)) min until $(jq -rn --argjson t "$deadline" '$t | todate')"; return 0; fi
    if [ "$(now_epoch)" -ge "$deadline" ]; then
      lock_acquire; ledger up-gave-up "$LAB" '' "{\"gpu\": \"$want\", \"count\": $count, \"waited_s\": $waited}"; lock_release
      board "up gave up: no $count x $want in $VOLUME_DCS after $((waited / 60)) min (by=$WHO — $PURPOSE)"
      die "no $want stock after waiting $((waited / 60)) min"
    fi
    if [ "$waited" = 0 ]; then
      lock_acquire; ledger up-waiting "$LAB" '' "{\"gpu\": \"$want\", \"count\": $count, \"wait_hours\": $WAIT_HOURS}"; lock_release
      board "up waiting: no $count x $want in $VOLUME_DCS; by=$WHO retries every $((WAIT_INTERVAL / 60)) min for up to ${WAIT_HOURS} h — $PURPOSE"
    fi
    info "retrying in $((WAIT_INTERVAL / 60)) min (until $(jq -rn --argjson t "$deadline" '$t | todate'))"
    sleep "$WAIT_INTERVAL"; waited=$((waited + WAIT_INTERVAL))
  done

  if is_dry; then lock_release; return 0; fi
  [ "$UP_DC" = "$CANONICAL_DC" ] && [ "$UP_OFF" = 0 ] && canon=true
  local where="$UP_DC"
  if [ "$UP_OFF" = 1 ]; then where="$UP_DC OFF-VOLUME"; elif [ "$canon" = false ]; then where="$UP_DC volume $UP_VOL (non-canonical)"; fi
  local created=$POD_JSON pod
  pod=$(echo "$created" | jq -r '.id // empty' 2>/dev/null)
  [ -n "$pod" ] || { lock_release; die "pod create returned no id: $(echo "$created" | head -3)"; }
  cache_put "$pod" "$(jq -cn --arg g "$req" --argjson cap "$(gpu_field "$req" 3)" --arg dc "$UP_DC" --arg v "$UP_VOL" \
    --argjson off "$( [ "$UP_OFF" = 1 ] && echo true || echo false)" --argjson canon "$canon" --arg lab "$LAB" --arg t "$(now_iso)" \
    '{gpu: $g, cap: $cap, dc: $dc, volume_id: $v, volume: ($off | not), off_volume: $off, canonical: $canon, tool: true, created_by: $lab, created: $t}')"
  mkdir -p "$STATE/leases/$pod"
  write_lease "$pod" "$ID" "$(jq -cn --argjson c "$count" '[range(0; $c)]')"
  ledger up "$LAB" "$pod" "$(jq -cn --arg g "$req" --argjson c "$count" --arg dc "$UP_DC" --argjson usd "$UP_ADD" \
    --arg purpose "$PURPOSE" --arg card "$CARD" --arg v "$UP_VOL" --argjson canon "$canon" --arg sel "$( [ "$LADDER" = 1 ] && echo ladder || echo explicit)" \
    '{gpu: $g, count: $c, dc: $dc, volume: $v, canonical: $canon, usd_per_h: $usd, purpose: $purpose, card: $card, gpu_choice: $sel}')"
  lock_release
  board "up $pod ($count x $req$( [ "$LADDER" = 1 ] && echo ' via ladder'), $where, \$$UP_ADD/h) by=$WHO hours=$HOURS — $PURPOSE${CARD:+ [$CARD]}"
  echo "Pod $pod created; waiting for SSH (up to $SSH_WAIT_SECONDS s)"

  local deadline addr t_ssh
  deadline=$(( $(now_epoch) + SSH_WAIT_SECONDS ))
  # A healthy draw is SSH-ready in ~20-40 s. A stalled one sits at
  # runtimeStatus=initializing / awaiting_container forever: the host rented but
  # never started the container, which no amount of waiting fixes. Detect that
  # early and redraw, instead of burning the full SSH_WAIT_SECONDS per draw
  # (four stalls cost an hour that way on 2026-10-07).
  local stall_after stall_until runtime retries attempt
  stall_after=${UOR_POD_STALL_SECONDS:-180}
  stall_until=$(( $(now_epoch) + stall_after ))
  while :; do
    addr=$(pod_addr "$pod" || true)
    if [ -n "$addr" ] && pod_ssh "$pod" true </dev/null 2>/dev/null; then break; fi
    if [ "$(now_epoch)" -ge "$stall_until" ] && [ -z "$addr" ]; then
      runtime=$(pod_get "$pod" 2>/dev/null | jq -r '.runtimeStatus // "unknown"' 2>/dev/null || echo unknown)
      if [ "$runtime" = "initializing" ] || [ "$runtime" = "unknown" ]; then
        warn "pod $pod stalled: runtimeStatus=$runtime, no SSH after ${stall_after}s (host never started the container)"
        up_failed "$pod" "stalled in $runtime with no SSH after ${stall_after}s"
        return 1
      fi
    fi
    if [ "$(now_epoch)" -ge "$deadline" ]; then
      up_failed "$pod" "SSH not reachable after $SSH_WAIT_SECONDS s"
      return 1
    fi
    sleep 10
  done
  t_ssh=$(( $(now_epoch) - t_create ))
  echo "SSH ready after ${t_ssh}s: $(addr_line "$pod")"
  lock_acquire; ledger ssh-ready "$LAB" "$pod" "{\"create_to_ssh_s\": $t_ssh}"; lock_release
  mirror_lease "$pod" "$ID"
  # the Hugging Face token (private store caseyallard/uor-r4-store) goes over
  # stdin, never on a command line or in a log
  if ! is_dry && [ -f "$HOME/.cache/huggingface/token" ]; then
    if pod_ssh "$pod" 'mkdir -p /root/.cache/huggingface && umask 077 && cat > /root/.cache/huggingface/token' < "$HOME/.cache/huggingface/token"; then
      info "hf token copied"
    else
      warn "hf token copy to $pod failed (the bootstrap's store fetch will be skipped)"
    fi
  fi
  if [ "$canon" = false ]; then
    # a non-canonical /workspace starts empty: copy the hot set before bootstrap
    # (toolchain and cached binaries make the bootstrap warm). Best effort.
    do_seed "$pod" || warn "hot-set seeding incomplete: run 'uor-pod seed $pod' once a canonical pod is up, or copy from the laptop"
  fi
  if [ "$NO_BOOT" = 1 ]; then return 0; fi
  if ! do_bootstrap "$pod"; then
    if [ "$KEEP_FAIL" = 1 ]; then
      print_boot_tail
      warn "bootstrap failed; pod $pod kept under $WHO's lease (until $(jq -r .expires "$(lease_file "$pod" "$ID")")) — fix or 'uor-pod down $pod --lab $LAB --session $SESSION'"
      return 1
    fi
    up_failed "$pod" "bootstrap failed"
    return 1
  fi
  echo "Ready: $(addr_line "$pod")   lease: $WHO gpus 0..$((count - 1)) until $(jq -r .expires "$(lease_file "$pod" "$ID")")"
}
addr_line() { local a; a=$(pod_addr "$1"); echo "ssh -i $SSH_KEY -p ${a#* } root@${a% *}"; }

print_boot_tail() {  # the end of the last bootstrap's output, so the reason survives the pod
  [ -n "$BOOT_LOG_LOCAL" ] && [ -s "$BOOT_LOG_LOCAL" ] || return 0
  {
    echo "---- last 30 lines of the bootstrap output (full log: $BOOT_LOG_LOCAL$([ -n "$BOOT_LOG_REMOTE" ] && echo "; on the pod volume: $BOOT_LOG_REMOTE")) ----"
    grep -v '^UOR_POD_BOOTSTRAP_RC=' "$BOOT_LOG_LOCAL" | tail -n 30 | sed 's/^/  | /'
    echo "----"
  } >&2
}
boot_last_line() { [ -s "$BOOT_LOG_LOCAL" ] && grep -v -e '^UOR_POD_BOOTSTRAP_RC=' -e '^[[:space:]]*$' "$BOOT_LOG_LOCAL" | tail -1 | cut -c1-300; }
up_failed() {  # POD REASON -> show why, keep the log, delete the new pod so nothing idles
  local last=''
  print_boot_tail
  if [ -n "$BOOT_LOG_LOCAL" ]; then last=$(boot_last_line || true); fi
  warn "$2: deleting pod $1"
  runpodctl pod delete "$1" >/dev/null 2>&1 || warn "DELETE FAILED for $1 — delete it by hand now: runpodctl pod delete $1"
  lock_acquire
  rm -rf "${STATE:?}/leases/$1"; cache_put "$1" '{"deleted": true}'
  ledger up-failed "$LAB" "$1" "$(jq -cn --arg r "$2" --arg l "$BOOT_LOG_REMOTE" --arg ll "$BOOT_LOG_LOCAL" --arg last "$last" \
    --argjson vol "$( [ "$BOOT_LOG_ON_VOLUME" = 1 ] && echo true || echo false)" \
    '{reason: $r} + (if $ll != "" then {log: $l, log_on_volume: $vol, local_log: $ll, last: $last} else {} end)')"
  lock_release
  board "up-failed $1 by=$WHO: $2${last:+ — $last} (pod deleted)"
}

write_lease() {  # POD ID GPUS-JSON  (caller holds the lock; LAB/SESSION from the identity)
  local f started
  f=$(lease_file "$1" "$2")
  mkdir -p "$(dirname "$f")"
  started=$(now_iso)
  if [ -f "$f" ] && lease_live "$f"; then  # keep the start, rewritten in the canonical form
    started=$(jq -r "$JQ_TS"'.started | canon_ts // empty' "$f" 2>/dev/null || true)
    [ -n "$started" ] || started=$(now_iso)
  fi
  jq -n --arg lab "$LAB" --arg session "$SESSION" --arg id "$2" --arg pod "$1" --argjson gpus "$3" --arg purpose "$PURPOSE" --arg card "$CARD" \
    --arg started "$started" --arg expires "$(plus_hours "$HOURS")" --arg renewed "$(now_iso)" --argjson hours "$HOURS" \
    '{lab: $lab, session: $session, id: $id, pod: $pod, gpus: $gpus, purpose: $purpose, card: $card, started: $started, expires: $expires, renewed: $renewed, hours: $hours}' |
    atomic_write "$f"
}

# ---------------------------------------------------------------- lease / renew / release
cmd_lease() {
  local pod=${POS[0]:-}
  check_pod_id "$pod"; check_who
  [ -n "$GPUS" ] && [ -n "$PURPOSE" ] && [ -n "$HOURS" ] || die "lease needs POD --lab L --session S --gpus 0,1 --purpose ... --hours H"
  check_hours "$HOURS"
  local want p n clash
  want=$(gpus_json "$GPUS")
  p=$(pod_get "$pod"); [ -n "$p" ] && [ "$p" != null ] || die "no pod $pod in the account"
  n=$(echo "$p" | jq -r '.gpuCount // 0')
  echo "$want" | jq -e --argjson n "$n" 'all(.[]; . >= 0 and . < $n)' >/dev/null || die "pod $pod has $n GPU(s); --gpus $GPUS is out of range"
  local states='[]' probe expired_clash
  # GPUs under another session's EXPIRED lease may be taken over, but only after
  # a fresh probe shows no live job on them.
  expired_clash=$(jq -cn --argjson a "$want" --argjson b "$(expired_leases_json "$pod" | jq -c --arg me "$ID" '[.[] | select((.id // .lab) != $me) | .gpus[]] | unique')" '[$a[] | select(. as $g | $b | index($g))]')
  if [ "$expired_clash" != '[]' ]; then  # read-only probe, also in dry runs
    probe=$(probe_pod "$pod")
    [ -n "$(probe_val "$probe" probe_ok)" ] || die "GPU(s) $expired_clash are under an expired lease; taking over needs a live SSH probe of $pod (no live job), which failed"
    states=$(gpu_states "$pod" "$probe")
    if [ "$(echo "$states" | jq -c --argjson c "$expired_clash" '[.[] | select(.busy and (.gpu as $g | $c | index($g))) | .gpu]')" != '[]' ]; then
      die "GPU(s) $expired_clash are under an EXPIRED lease but still running a job: ask its session, do not take it over"
    fi
  fi
  lock_acquire
  clash=$(jq -cn --argjson a "$want" --argjson b "$(taken_gpus "$pod" "$ID")" '[$a[] | select(. as $g | $b | index($g))]')
  if [ "$clash" != '[]' ]; then
    lock_release
    live_leases_json "$pod" | jq -r '.[] | "  held: \(.lab)/\(.session // "-") gpus=\(.gpus) until \(.expires) — \(.purpose)"' >&2
    echo "uor-pod: GPU(s) $clash on $pod are under another session's live lease. An idle leased GPU is not free: only its holder (release) or expiry frees it." >&2
    local free
    free=$(free_report "$(pods_all)")
    if [ -n "$free" ]; then echo "Free GPUs you can lease now:" >&2; echo "$free" >&2; fi
    no_gpu_guidance
    exit 1
  fi
  if [ "$expired_clash" != '[]' ]; then
    local lf left holder nl
    for lf in "$STATE/leases/$pod"/*.json; do
      [ -f "$lf" ] || continue
      nl=$(read_lease "$lf")
      [ "$(echo "$nl" | jq -r .live)" != true ] || continue
      [ "$(echo "$nl" | jq -r '.id // .lab')" != "$ID" ] || continue
      left=$(echo "$nl" | jq -c --argjson c "$expired_clash" '[.gpus[] | select(. as $g | $c | index($g) | not)]')
      [ "$left" != "$(echo "$nl" | jq -c .gpus)" ] || continue
      holder=$(echo "$nl" | jq -r '"\(.lab)/\(.session // "-")"')
      if [ "$left" = '[]' ]; then rm -f "$lf"; else jq --argjson g "$left" '.gpus = $g' "$lf" | atomic_write "$lf"; fi
      ledger takeover "$LAB" "$pod" "$(jq -cn --argjson t "$expired_clash" --arg from "$holder" '{gpus: $t, from_expired: $from}')"
      board "takeover $pod GPU(s) $expired_clash from the EXPIRED lease of $holder by=$WHO (no live job on them)"
    done
  fi
  write_lease "$pod" "$ID" "$want"
  if [ "$(cache_get "$pod")" = '{}' ]; then
    cache_put "$pod" "$(jq -cn --arg net "$(echo "$p" | jq -r '.networkVolumeId // ""')" '{tool: false, volume: ($net != "")}')"
  fi
  if [ -n "$GPU" ]; then  # optional --gpu KEY records the type of a pod the API does not describe
    [ -n "$(gpu_field "$GPU" 4)" ] || { lock_release; die "unknown --gpu '$GPU'"; }
    cache_put "$pod" "{\"gpu\": \"$GPU\", \"cap\": $(gpu_field "$GPU" 3)}"
  fi
  ledger lease "$LAB" "$pod" "$(jq -cn --argjson g "$want" --arg p "$PURPOSE" --arg c "$CARD" --argjson h "$HOURS" '{gpus: $g, purpose: $p, card: $c, hours: $h}')"
  lock_release
  [ "$NO_MIRROR" = 1 ] || mirror_lease "$pod" "$ID"
  board "lease $pod gpus=$GPUS by=$WHO hours=$HOURS — $PURPOSE${CARD:+ [$CARD]}"
  echo "Leased $pod gpus $GPUS to $WHO until $(jq -r .expires "$(lease_file "$pod" "$ID")")"
}

# Backfill a pod made outside `up`: lease only the GPUs that are busy right now,
# for at most 1 h (the lab renews if it is really working). Idle GPUs stay free.
cmd_register() {
  local pod=${POS[0]:-} p probe states busy
  check_pod_id "$pod"; check_who
  [ -n "$PURPOSE" ] || die "register needs POD --lab L --purpose \"...\" [--gpu KEY] [--keep REASON]"
  p=$(pod_get "$pod"); [ -n "$p" ] && [ "$p" != null ] || die "no pod $pod in the account"
  lock_acquire
  cache_put "$pod" "$(jq -cn --arg net "$(echo "$p" | jq -r '.networkVolumeId // ""')" '{tool: false, volume: ($net != "")}' )"
  [ -z "$GPU" ] || cache_put "$pod" "{\"gpu\": \"$GPU\", \"cap\": $(gpu_field "$GPU" 3)}"
  [ -z "$KEEP_REASON" ] || cache_put "$pod" "$(jq -cn --arg r "$KEEP_REASON" '{keep: $r}')"
  lock_release
  if [ "$(echo "$p" | jq -r .desiredStatus)" != RUNNING ]; then
    echo "$pod is $(echo "$p" | jq -r .desiredStatus): no GPU in use, no lease written${KEEP_REASON:+ (marked KEEP: $KEEP_REASON)}"
    return 0
  fi
  probe=$(probe_pod "$pod")
  [ -n "$(probe_val "$probe" probe_ok)" ] || die "cannot probe $pod over SSH; lease by hand only the GPUs you know are busy (--hours 1)"
  states=$(gpu_states "$pod" "$probe")
  busy=$(echo "$states" | jq -r '[.[] | select(.busy) | .gpu | tostring] | join(",")')
  if [ -z "$busy" ]; then echo "$pod: no busy GPU; nothing leased (its GPUs are free to lease)"; return 0; fi
  GPUS=$busy HOURS=1 KEEP_REASON='' cmd_lease
}

cmd_keep() {  # keep POD --purpose REASON | unkeep POD : protect a pod from down/reap (unique data)
  local pod=${POS[0]:-}
  check_pod_id "$pod"
  lock_acquire
  if [ "$1" = keep ]; then
    [ -n "$PURPOSE" ] || { lock_release; die "keep needs --purpose REASON"; }
    cache_put "$pod" "$(jq -cn --arg r "$PURPOSE" '{keep: $r}')"
    ledger keep "${LAB:-?}" "$pod" "$(jq -cn --arg r "$PURPOSE" '{reason: $r}')"
  else
    jq --arg p "$pod" 'del(.[$p].keep)' "$STATE/pods.json" | atomic_write "$STATE/pods.json"
    ledger unkeep "${LAB:-?}" "$pod"
  fi
  lock_release
  board "$1 $pod by ${LAB:-a lab}${PURPOSE:+ — $PURPOSE}"
}

cmd_renew() {
  local pod=${POS[0]:-} f
  check_pod_id "$pod"; check_who
  f=$(lease_file "$pod" "$ID")
  [ -f "$f" ] || die "$WHO holds no lease on $pod (use lease)"
  lock_acquire
  local gpus clash
  gpus=$(read_lease "$f" | jq -c .gpus)
  if ! lease_live "$f"; then
    clash=$(jq -cn --argjson a "$gpus" --argjson b "$(taken_gpus "$pod" "$ID")" '[$a[] | select(. as $g | $b | index($g))]')
    [ "$clash" = '[]' ] || { lock_release; die "your lease expired and GPU(s) $clash were taken over; lease free GPUs instead"; }
    warn "lease had expired at $(jq -r .expires "$f"); renewing (no other lab took the GPUs)"
  fi
  HOURS=${HOURS:-$(jq -r '.hours // 2' "$f")}; check_hours "$HOURS"
  PURPOSE=$(jq -r .purpose "$f"); CARD=$(jq -r '.card // ""' "$f")
  write_lease "$pod" "$ID" "$gpus"
  ledger renew "$LAB" "$pod" "{\"hours\": $HOURS}"
  lock_release
  [ "$NO_MIRROR" = 1 ] || mirror_lease "$pod" "$ID"
  echo "Renewed $WHO on $pod until $(jq -r .expires "$f")"
}

cmd_release() {
  local pod=${POS[0]:-} f
  check_pod_id "$pod"; check_who
  f=$(lease_file "$pod" "$ID")
  [ -f "$f" ] || die "$WHO holds no lease on $pod"
  lock_acquire
  rm -f "$f"
  ledger release "$LAB" "$pod"
  lock_release
  unmirror_lease "$pod" "$ID"
  board "release $pod by=$WHO"
  echo "Released $WHO's lease on $pod. If nobody else holds it, 'uor-pod down $pod --lab $LAB --session $SESSION' now (the reaper deletes it after $IDLE_MIN idle min)."
}

# ---------------------------------------------------------------- down
cmd_down() {
  local pod=${POS[0]:-} others p cache probe kb
  check_pod_id "$pod"; check_who
  p=$(pod_get "$pod"); [ -n "$p" ] && [ "$p" != null ] || die "no pod $pod in the account"
  others=$(live_leases_json "$pod" | jq -c --arg l "$ID" '[.[] | select((.id // .lab) != $l)]')
  if [ "$others" != '[]' ]; then
    echo "$others" | jq -r '.[] | "  live lease: \(.lab)/\(.session // "-") gpus=\(.gpus) until \(.expires) — \(.purpose)"' >&2
    die "refusing: another session holds a live lease on $pod (wait for release or expiry)"
  fi
  cache=$(cache_get "$pod")
  if [ -n "$(echo "$cache" | jq -r '.keep // empty')" ]; then
    die "$pod is marked KEEP ($(echo "$cache" | jq -r .keep)); 'uor-pod unkeep $pod' first, with the owner's or holder's agreement"
  fi
  if [ "$(echo "$p" | jq -r .desiredStatus)" = RUNNING ]; then
    probe=$(probe_pod "$pod")
    if [ -z "$(probe_val "$probe" probe_ok)" ]; then
      [ "$FORCE" = 1 ] || die "cannot probe $pod over SSH (jobs/unsaved results unknown); re-run with --force to delete anyway"
    fi
    if [ -n "$(probe_val "$probe" busy_lock)" ]; then
      die "jobs still hold $(probe_val "$probe" busy_lock | tr '\n' ' ')— stop or wait for them first"
    fi
    kb=$(probe_val "$probe" root_runs_kb)
    if [ -n "$kb" ] && [ "$kb" -gt 4 ] && [ "$DISCARD_LOCAL" != 1 ]; then
      die "/root/runs holds ${kb} KB on the container disk (lost on delete). Copy what matters to /workspace, then re-run with --discard-local"
    fi
  fi
  if [ "$CONFIRM_ARCHIVED" != 1 ]; then
    local net
    net=$(echo "$p" | jq -r '.networkVolumeId // ""')
    if [ -z "$net" ]; then
      die "$pod has no network volume: its /workspace dies with it. Archive results to the canonical volume ('uor-pod push $pod PATH...') or the laptop, record where, then re-run with --confirm-archived"
    fi
    if [ "$net" != "$VOLUME_ID" ]; then
      die "$pod uses non-canonical volume $net: archive its results to the canonical $CANONICAL_DC volume ('uor-pod push $pod PATH...') or the laptop, record where, then re-run with --confirm-archived"
    fi
  fi
  mut runpodctl pod delete "$pod" >/dev/null
  lock_acquire
  if ! is_dry; then rm -rf "${STATE:?}/leases/$pod" "$STATE/idle/$pod"; cache_put "$pod" '{"deleted": true}'; fi
  ledger down "$LAB" "$pod" "$(jq -cn --argjson usd "$(echo "$p" | jq '.costPerHr // 0')" --argjson up "$(echo "$p" | jq '.uptimeSeconds // 0')" '{usd_per_h: $usd, uptime_s: $up}')"
  lock_release
  board "down $pod by=$WHO (was \$$(echo "$p" | jq -r '.costPerHr // 0')/h, up $(echo "$p" | jq -r '((.uptimeSeconds // 0) / 60 | floor)') min)"
  echo "Deleted $pod"
}

# ---------------------------------------------------------------- reap
cmd_reap() {
  local pods id probe since now f deleted=0
  pods=$(pods_all); now=$(now_epoch)
  for id in $(echo "$pods" | jq -r '.[] | select(.desiredStatus == "RUNNING") | .id'); do
    if [ -n "$(cache_get "$id" | jq -r '.keep // empty')" ]; then echo "$id: marked KEEP, never reaped"; continue; fi
    if [ "$(live_leases_json "$id")" != '[]' ]; then echo "$id: live lease, kept"; rm -f "$STATE/idle/$id"; continue; fi
    probe=$(probe_pod "$id")
    if [ -z "$(probe_val "$probe" probe_ok)" ]; then echo "$id: no live lease but SSH probe failed — NOT reaped (check by hand)"; continue; fi
    f="$STATE/idle/$id"
    if ! probe_idle "$probe"; then echo "$id: no live lease, GPUs busy — kept (lease it!)"; rm -f "$f"; continue; fi
    since=$(probe_val "$probe" idle_since)
    if [ -z "$since" ]; then
      [ -f "$f" ] || echo "$now" > "$f"
      since=$(cat "$f")
    fi
    if [ $(( now - since )) -lt $(( IDLE_MIN * 60 )) ]; then
      echo "$id: no live lease, idle $(( (now - since) / 60 )) min (< $IDLE_MIN) — kept for now"
      continue
    fi
    echo "$id: no live lease, idle $(( (now - since) / 60 )) min — deleting"
    mut runpodctl pod delete "$id" >/dev/null
    lock_acquire
    if ! is_dry; then rm -f "$f"; cache_put "$id" '{"deleted": true}'; fi
    ledger reap "${LAB:-any}" "$id" "{\"idle_min\": $(( (now - since) / 60 ))}"
    lock_release
    board "reap $id (no live lease, GPUs idle $(( (now - since) / 60 )) min) by ${LAB:-a lab}"
    deleted=$((deleted + 1))
  done
  echo "reap: $deleted pod(s) deleted"
}

# ---------------------------------------------------------------- run / ssh / bootstrap / transfer
cmd_run() {
  local pod=${POS[0]:-} f cmd ks k b64 locks='' lockcmd=''
  check_pod_id "$pod"; check_who
  [ -n "$GPU" ] || die "run needs --gpu K (or K1,K2)"
  [ ${#POS[@]} -ge 2 ] || die "run needs -- CMD..."
  cmd=${POS[*]:1}
  f=$(lease_file "$pod" "$ID")
  lease_live "$f" || die "$WHO holds no live lease on $pod (lease or renew first)"
  ks=$(gpus_json "$GPU")
  echo "$ks" | jq -e --argjson have "$(read_lease "$f" | jq -c .gpus)" 'all(.[]; . as $g | $have | index($g))' >/dev/null ||
    die "GPU(s) $GPU are not in $WHO's lease ($(jq -c .gpus "$f"))"
  for k in $(echo "$ks" | jq -r '.[]'); do
    locks="$locks /root/gpu$k.lock"
    lockcmd="$lockcmd exec $((20 + k))>/root/gpu$k.lock; flock $((20 + k));"
  done
  b64=$(printf '%s' "$cmd" | base64 | tr -d '\n')
  local remote
  remote="set -e; ts=\$(date -u +%Y%m%dT%H%M%SZ); d=/workspace/uor-r4/jobs/$LAB; mkdir -p \$d; log=\$d/\$ts-$SESSION-gpu${GPU//,/-}.log
cat > /tmp/uor-job-\$ts.sh <<'JOB'
CMD=\$(echo $b64 | base64 -d)
echo \"# uor-pod job by=$WHO pod=$pod gpu=$GPU queued \$(date -u +%FT%TZ)\"
echo \"# cmd: \$CMD\"
$lockcmd
echo \"# start \$(date -u +%FT%TZ) (holding$locks)\"
[ -f /root/.uor-pod-env ] && . /root/.uor-pod-env
set +e
CUDA_VISIBLE_DEVICES=$GPU bash -c \"\$CMD\"
rc=\$?
echo \"# exit=\$rc end=\$(date -u +%FT%TZ)\"
JOB
nohup setsid bash /tmp/uor-job-\$ts.sh > \$log 2>&1 < /dev/null &
echo \$log"
  if is_dry; then echo "DRY-RUN: on $pod: $remote" >&2; return 0; fi
  local log
  log=$(pod_ssh "$pod" "$remote" </dev/null) || die "could not start the job"
  lock_acquire; ledger run "$LAB" "$pod" "$(jq -cn --arg g "$GPU" --arg c "$cmd" --arg l "$log" '{gpu: $g, cmd: $c, log: $l}')"; lock_release
  echo "Started on $pod gpu $GPU (queues behind any job holding the GPU lock). Log: $log"
  echo "Follow: uor-pod ssh $pod tail -f $log"
}

cmd_ssh() {
  local pod=${POS[0]:-} addr
  check_pod_id "$pod"
  addr=$(pod_addr "$pod"); [ -n "$addr" ] || die "pod $pod has no SSH address (not running?)"
  if [ ${#POS[@]} -ge 2 ]; then
    exec ssh -i "$SSH_KEY" -p "${addr#* }" "${SSH_OPTS[@]}" "root@${addr% *}" "${POS[*]:1}"
  fi
  exec ssh -t -i "$SSH_KEY" -p "${addr#* }" "${SSH_OPTS[@]}" "root@${addr% *}"
}

# --ref -> the full 40-character commit the pod will fetch. Branch and tag names
# are looked up on $REPO_URL; a SHA (7-40 hex) is accepted when it is a branch tip
# there, or else expanded and checked in this checkout after fetching the remote's
# branches into refs/uor-pod/origin/* (it must be on one of them: the pod fetches
# from GitHub, so a commit that exists only here would fail on the billed pod).
RESOLVED_REF='' RESOLVED_SHA=''
resolve_ref() {  # REF -> full SHA on stdout; dies with the reason otherwise
  local ref=$1 lc refs sha='' gd
  if [ -n "$RESOLVED_SHA" ] && { [ "$ref" = "$RESOLVED_REF" ] || [ "$ref" = "$RESOLVED_SHA" ]; }; then echo "$RESOLVED_SHA"; return 0; fi
  case $ref in ''|-*|*[!A-Za-z0-9._/-]*) die "--ref '$ref' is not a branch, tag or commit (nothing was created)";; esac
  refs=$(git ls-remote --heads --tags "$REPO_URL" 2>&1) || die "cannot list $REPO_URL to check --ref $ref: $(printf '%s' "$refs" | tail -1) (nothing was created)"
  sha=$(printf '%s\n' "$refs" | awk -v h="refs/heads/$ref" -v t="refs/tags/$ref^{}" '$2 == h || $2 == t {print $1; exit}')
  [ -n "$sha" ] || sha=$(printf '%s\n' "$refs" | awk -v t="refs/tags/$ref" '$2 == t {print $1; exit}')
  if [ -z "$sha" ]; then
    lc=$(printf '%s' "$ref" | tr 'A-F' 'a-f')
    case $lc in *[!0-9a-f]*) die "--ref '$ref' is not a branch or tag of $REPO_URL, nor a commit SHA (nothing was created)";; esac
    [ ${#lc} -ge 7 ] && [ ${#lc} -le 40 ] || die "--ref '$ref': a commit SHA needs 7 to 40 hex characters (nothing was created)"
    sha=$(printf '%s\n' "$refs" | awk -v s="$lc" '$1 == s {print $1; exit}')
    if [ -z "$sha" ]; then
      gd=${UOR_POD_GIT_DIR:-$(git -C "$HERE" rev-parse --show-toplevel 2>/dev/null || true)}
      [ -n "$gd" ] || die "--ref $ref is not a branch tip of $REPO_URL and no git checkout is available to expand it; give a branch name (nothing was created)"
      git -C "$gd" fetch -q --prune --no-tags "$REPO_URL" '+refs/heads/*:refs/uor-pod/origin/*' >/dev/null 2>&1 ||
        die "cannot fetch $REPO_URL into $gd to check --ref $ref (nothing was created)"
      sha=$(git -C "$gd" rev-parse -q --verify "$lc^{commit}" 2>/dev/null) ||
        die "--ref $ref: unknown or ambiguous commit (not found after fetching $REPO_URL); push it, or give a longer SHA or a branch (nothing was created)"
      [ -n "$(git -C "$gd" for-each-ref --contains "$sha" --count=1 refs/uor-pod/origin/)" ] ||
        die "--ref $ref ($sha) is on no branch of $REPO_URL: push it first — the pod fetches from GitHub (nothing was created)"
    fi
  fi
  case $sha in *[!0-9a-f]*|'') die "--ref $ref resolved to '$sha', not a commit SHA (nothing was created)";; esac
  [ ${#sha} = 40 ] || die "--ref $ref resolved to '$sha', not a full 40-character commit (nothing was created)"
  echo "$sha"
}

# The pod-side bootstrap's argument vector, built in one place for the preflight
# and the real run, and checked by the bootstrap's own parser (--check-args).
BOOT_ARGS=()
bootstrap_args() {  # SHA POD OFF-VOLUME(true|false) [CANONICAL(true|false)] -> BOOT_ARGS
  BOOT_ARGS=(--sha "$1" --pod "$2")
  if [ "$OLLAMA" = 1 ]; then BOOT_ARGS+=(--with-ollama); fi
  if [ "$3" = true ]; then BOOT_ARGS+=(--off-volume); fi
  if [ "${4:-true}" = false ]; then BOOT_ARGS+=(--non-canonical); fi
}
preflight_bootstrap_args() {  # SHA -> dies unless the bootstrap accepts every argument vector `up` may pass
  local off out
  local canon
  for off in false $( [ "$OFF_VOLUME" = 1 ] && echo true ); do
    for canon in true false; do  # placement decides canonical only after create
      bootstrap_args "$1" preflightpod "$off" "$canon"
      out=$(bash "$HERE/uor-pod-bootstrap.sh" --check-args "${BOOT_ARGS[@]}" 2>&1) ||
        die "the bootstrap rejects the arguments up would pass (${BOOT_ARGS[*]}): $out (nothing was created)"
    done
  done
}

# Helper files `up`/`bootstrap`/`seed` upload from next to this script. A missing
# or broken one used to surface only after the pod was created (and then deleted):
# check them all first, so a bad checkout costs nothing.
HELPERS_BOOT='uor-pod-bootstrap.sh uor-reaper.sh'
HELPERS_SEED='hot-set.txt'
preflight_helpers() {  # [FILES...] (default: what `up` needs) -> dies listing every problem
  local f p problems=''
  # shellcheck disable=SC2086  # word lists
  if [ $# = 0 ]; then
    set -- $HELPERS_SEED
    [ "$NO_BOOT" = 1 ] || set -- "$@" $HELPERS_BOOT
  fi
  for f in "$@"; do
    p=$HERE/$f
    if [ ! -f "$p" ]; then problems="$problems $p (missing);"
    elif [ ! -r "$p" ]; then problems="$problems $p (unreadable);"
    elif [ ! -s "$p" ]; then problems="$problems $p (empty);"
    else
      case $f in *.sh) bash -n "$p" 2>/dev/null || problems="$problems $p (bash syntax error);";; esac
    fi
  done
  [ -z "$problems" ] || die "helper file check failed before creating anything:$problems restore them (git checkout scripts/pod) and retry"
}

BOOT_LOG_LOCAL='' BOOT_LOG_REMOTE='' BOOT_LOG_ON_VOLUME=0
do_bootstrap() {  # POD -> copy reaper + bootstrap, mirror leases, run bootstrap (output logged)
  local pod=$1 sha l cache off ts result ollama out
  # (a subshell: after `up` created the pod, a failure must reach up_failed, not exit)
  # shellcheck disable=SC2086
  ( preflight_helpers $HELPERS_BOOT ) || return 1
  cache=$(cache_get "$pod")
  if [ "$(echo "$cache" | jq -r '.tool // false')" != true ] && [ "$FORCE" != 1 ]; then
    die "$pod was not created by 'uor-pod up' (no reaper/bootstrap on hand-made pods); --force overrides"
  fi
  sha=$(resolve_ref "$REF") || return 1
  off=$(echo "$cache" | jq -r '.off_volume // false')
  bootstrap_args "$sha" "$pod" "$off" "$(echo "$cache" | jq -r 'if .canonical == false then "false" else "true" end')"
  out=$(bash "$HERE/uor-pod-bootstrap.sh" --check-args "${BOOT_ARGS[@]}" 2>&1) ||
    { warn "the bootstrap rejects its arguments (${BOOT_ARGS[*]}): $out"; return 1; }
  ts=$(date -u +%Y%m%dT%H%M%SZ)
  BOOT_LOG_REMOTE=/workspace/uor-r4/pods/bootstrap-$pod-$ts.log
  BOOT_LOG_LOCAL=$STATE/logs/bootstrap-$pod-$ts.log
  BOOT_LOG_ON_VOLUME=1; [ "$off" != true ] || BOOT_LOG_ON_VOLUME=0
  echo "Bootstrapping $pod at $sha (log: $BOOT_LOG_LOCAL; pod volume: $BOOT_LOG_REMOTE)"
  if is_dry; then echo "DRY-RUN: copy uor-pod-bootstrap.sh + uor-reaper.sh to $pod and run: bash /root/uor-pod-bootstrap.sh ${BOOT_ARGS[*]} | tee $BOOT_LOG_REMOTE" >&2; return 0; fi
  wait_ssh "$pod" 300 || { warn "SSH to $pod still refused after 300 s"; return 1; }
  pod_ssh "$pod" 'mkdir -p /root/leases && cat > /root/uor-reaper.sh && chmod 755 /root/uor-reaper.sh' < "$HERE/uor-reaper.sh" || return 1
  pod_ssh "$pod" 'cat > /root/uor-pod-bootstrap.sh && chmod 755 /root/uor-pod-bootstrap.sh' < "$HERE/uor-pod-bootstrap.sh" || return 1
  for l in "$STATE/leases/$pod"/*.json; do
    [ -f "$l" ] || continue
    mirror_lease "$pod" "$(basename "$l" .json)"
  done
  local t0 rc
  t0=$(now_epoch)
  mkdir -p "$STATE/logs"
  # The pod tees the output onto its volume and appends its exit status; this
  # side keeps a full copy, so the reason survives the pod's deletion.
  pod_ssh "$pod" "mkdir -p /workspace/uor-r4/pods; { bash /root/uor-pod-bootstrap.sh ${BOOT_ARGS[*]} 2>&1; echo \"UOR_POD_BOOTSTRAP_RC=\$?\"; } | tee $BOOT_LOG_REMOTE" \
    </dev/null 2>&1 | tee "$BOOT_LOG_LOCAL" || true
  rc=$(sed -n 's/^UOR_POD_BOOTSTRAP_RC=\([0-9][0-9]*\)$/\1/p' "$BOOT_LOG_LOCAL" | tail -1)
  [ -n "$rc" ] || { rc=255; warn "the bootstrap on $pod reported no exit status (SSH dropped?)"; }
  result=$(sed -n 's/^BOOTSTRAP_RESULT //p' "$BOOT_LOG_LOCAL" | tail -1)
  ollama=$(printf '%s' "$result" | jq -r '.ollama // empty' 2>/dev/null || true)
  if [ "$OLLAMA" = 1 ] && [ "$rc" = 0 ] && [ "$ollama" != ready ]; then
    warn "Ollama on $pod: ${ollama:-status unknown} — the pod is kept (training is unaffected); see /root/ollama*.log on the pod and $BOOT_LOG_LOCAL"
  fi
  lock_acquire
  ledger bootstrap "${LAB:-?}" "$pod" "$(jq -cn --arg s "$sha" --argjson rc "$rc" --argjson t "$(( $(now_epoch) - t0 ))" \
    --arg l "$BOOT_LOG_REMOTE" --arg ll "$BOOT_LOG_LOCAL" --arg o "$ollama" \
    '{sha: $s, rc: $rc, seconds: $t, log: $l, local_log: $ll} + (if $o != "" then {ollama: $o} else {} end)')"
  cache_put "$pod" '{"reaper": true}'
  lock_release
  [ "$rc" = 0 ]
}
cmd_bootstrap() { check_pod_id "${POS[0]:-}"; do_bootstrap "${POS[0]}"; }

transfer() {  # DIRECTION POD PATH...  relays /workspace paths through this laptop
  local dir=$1 pod=$2 vp src dst
  shift 2
  [ $# -ge 1 ] || die "$dir needs at least one path relative to /workspace"
  for p in "$@"; do case $p in /*|*..*) die "paths are relative to /workspace without '..' (got $p)";; esac; done
  vp=${VIA:-$(volume_pod "$(pods_all)")} || die "no running pod mounts volume $VOLUME_ID; start one (uor-pod up) or copy from the laptop"
  [ "$vp" != "$pod" ] || die "$pod already mounts the volume"
  if [ "$dir" = pull ]; then src=$vp; dst=$pod; else src=$pod; dst=$vp; fi
  echo "Relaying $* : $src:/workspace -> $dst:/workspace (via this laptop)"
  if is_dry; then echo "DRY-RUN: tar from $src | tar into $dst" >&2; return 0; fi
  local q
  q=$(printf '%q ' "$@")
  pod_ssh "$src" "cd /workspace && tar -cf - $q" </dev/null | pod_ssh "$dst" "mkdir -p /workspace && cd /workspace && tar -xf -"
  lock_acquire; ledger "$dir" "${LAB:-?}" "$pod" "$(jq -cn --arg v "$vp" --arg p "$*" '{via: $v, paths: $p}')"; lock_release
}

do_seed() {  # POD -> copy the missing hot-set paths from the canonical volume (or $UOR_POD_HOT_MIRROR)
  local pod=$1 want=() line path tag cap sha missing vp
  ( preflight_helpers "$HELPERS_SEED" ) || return 1
  while IFS= read -r line; do
    line=${line%%#*}; [ -n "${line// /}" ] || continue
    path=$(echo "$line" | awk '{print $1}'); tag=$(echo "$line" | awk '{print $2}')
    if [ "$tag" = ollama ] && [ "$OLLAMA" != 1 ]; then continue; fi
    want+=("$path")
  done < "$HERE/hot-set.txt"
  cap=$(cache_get "$pod" | jq -r '.cap // empty')
  if [ -n "$cap" ]; then
    sha=$(resolve_ref "$REF" 2>/dev/null || true)
    [ -n "$sha" ] && want+=("bin/$sha-sm$cap")
  fi
  if is_dry; then echo "DRY-RUN: seed $pod with: ${want[*]}" >&2; return 0; fi
  missing=$(pod_ssh "$pod" "cd /workspace 2>/dev/null || exit 0; for p in ${want[*]}; do [ -e \"\$p\" ] || echo \"\$p\"; done" </dev/null) || return 1
  [ -n "$missing" ] || { echo "Hot set already present on $pod"; return 0; }
  # shellcheck disable=SC2086  # one path per word
  set -- $missing
  if vp=${VIA:-$(volume_pod "$(pods_all)")}; then
    local have
    have=$(pod_ssh "$vp" "cd /workspace && for p in $*; do [ -e \"\$p\" ] && echo \"\$p\"; done" </dev/null) || return 1
    [ -n "$have" ] || { echo "Nothing of the hot set exists on the canonical volume yet"; return 0; }
    # shellcheck disable=SC2086
    VIA=$vp transfer pull "$pod" $have
  elif [ -n "${UOR_POD_HOT_MIRROR:-}" ] && [ -d "$UOR_POD_HOT_MIRROR" ]; then
    echo "No canonical pod running: seeding $pod from the laptop mirror $UOR_POD_HOT_MIRROR"
    local p have=()
    for p in "$@"; do [ -e "$UOR_POD_HOT_MIRROR/$p" ] && have+=("$p"); done
    [ ${#have[@]} -gt 0 ] || return 1
    tar -C "$UOR_POD_HOT_MIRROR" -cf - "${have[@]}" | pod_ssh "$pod" "mkdir -p /workspace && cd /workspace && tar -xf -"
  else
    warn "no running pod mounts the canonical volume and UOR_POD_HOT_MIRROR is unset; missing on $pod: $*"
    return 1
  fi
}
cmd_seed() { check_pod_id "${POS[0]:-}"; do_seed "${POS[0]}"; }

cmd_log() { tail -n "$NLINES" "$STATE/ledger.jsonl" | jq -r '"\(.ts) \(.event) \(.lab) \(.pod) \(del(.ts, .event, .lab, .pod, .by) | tostring) (\(.by))"'; }

cmd_gpus() {
  echo "GPU policy (key, CUDA_COMPUTE_CAP, tier):"
  printf '%s\n' "$GPU_POLICY" | awk -F'|' '{printf "  %-8s cap %-4s %-10s %s\n", $1, $3, $4, $2}'
  print_stock_table "$(gpu_stock)" 2>&1
}

# ---------------------------------------------------------------- main
sub=${1:-rules}; [ $# -gt 0 ] && shift
case $sub in
  status|up|lease|renew|release|down|reap|run|ssh|bootstrap|seed|register|keep|unkeep|pull|push|log|gpus|prune-stopped) parse "$@";;
esac
case $sub in
  status) cmd_status;;
  up) cmd_up;;
  lease) cmd_lease;;
  renew) cmd_renew;;
  release) cmd_release;;
  down) cmd_down;;
  reap) cmd_reap;;
  run) cmd_run;;
  ssh) cmd_ssh;;
  bootstrap) cmd_bootstrap;;
  seed) cmd_seed;;
  pull|push) check_pod_id "${POS[0]:-}"; transfer "$sub" "${POS[@]}";;
  register) cmd_register;;
  keep|unkeep) cmd_keep "$sub";;
  prune-stopped) cmd_prune_stopped;;
  log) cmd_log;;
  gpus) cmd_gpus;;
  rules) print_rules; echo; echo "Commands: uor-pod help";;
  help|-h|--help) sed -n '2,/^set -euo/{/^set -euo/d;p;}' "$0";;
  *) die "unknown subcommand '$sub' (uor-pod help)";;
esac
