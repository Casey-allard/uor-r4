#!/usr/bin/env bash
# uor-hygiene: keep the laptop lean (owner direction, 9 October 2026; one-clone layout, 20 October 2026;
# CHARTER section 5 item 9; docs/labs/workspace.md).
#
#   uor-hygiene            report what would be freed (dry run, the default)
#   uor-hygiene --apply    do it
#   uor-hygiene --help     every rule and the guard on each
#
# The rules and their guards live in the Rust harness, crates/uor-r4-harness/src/hygiene.rs
# (`uor-harness hygiene`). This path stays because the charter names it. The harness is built from
# the checkout this script is in, so the rules that run are the ones beside it.
set -euo pipefail

# Follow symbolic links to this script (e.g. ~/bin/uor-hygiene), so the checkout is the real one.
src=$0
while [ -L "$src" ]; do
  dir=$(cd -P "$(dirname "$src")" && pwd)
  src=$(readlink "$src")
  case $src in /*) ;; *) src=$dir/$src ;; esac
done
root=$(cd -P "$(dirname "$src")/../.." && pwd)
# ~/.cargo/bin first: /opt/homebrew/bin/cargo shadows the Rust toolchain's cargo on this Mac.
cargo=$HOME/.cargo/bin/cargo
[ -x "$cargo" ] || cargo=cargo
target=${CARGO_TARGET_DIR:-$root/target/hygiene}
bin=$target/debug/uor-harness
[ -x "$bin" ] || echo "uor-hygiene: building the harness into $target (first run only)" >&2
# --locked: building the tool must never rewrite Cargo.lock in the checkout it tidies.
"$cargo" build -q --locked --manifest-path "$root/Cargo.toml" -p uor-r4-harness --bin uor-harness \
  --target-dir "$target"
exec "$bin" hygiene "$@"
