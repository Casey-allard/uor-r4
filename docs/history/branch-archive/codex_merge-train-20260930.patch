+fn fold_columns(weights: &mut [f32], cols: usize, gain: &[f32]) {
+    assert_eq!(weights.len() % cols, 0);
+    assert_eq!(gain.len(), cols);
+    for row in weights.chunks_exact_mut(cols) {
+        for (w, &g) in row.iter_mut().zip(gain) {
+            *w *= g;
+        }
+    }
+}
