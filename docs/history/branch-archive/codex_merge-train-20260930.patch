+        let rot = rht_transform_matrix(&weights, rows, cols, 42, 99).unwrap();
+        let inv = rht_inverse_matrix(&rot, rows, cols, 42, 99).unwrap();
+        for i in 0..weights.len() {
+            assert!(
+                (inv[i] - weights[i]).abs() < 1e-5,
