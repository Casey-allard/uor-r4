+// ---------------------------------------------------------------------------
+// 3. Scale and Quantization Primitives
+// ---------------------------------------------------------------------------
+
+pub fn encode_scale_fp16(scale: f32) -> u16 {
+    half::f16::from_f32(scale).to_bits()
+}
+
+pub fn decode_scale_fp16(bits: u16) -> f32 {
+    half::f16::from_bits(bits).to_f32()
+}
