new file mode 100644
index 0000000000000000000000000000000000000000..1beb814e5c2c2fd324b5a1aaf545099a85585840
--- /dev/null
+++ b/crates/uor-r4-training/src/whole_path_law.rs
@@ -0,0 +1,35 @@
+//! Non-exponential laws for the bound geometric decision graph.
+use candle_core::{DType, Tensor};
+use crate::{invalid, Result};
+
+/// Squared nonnegative score slack with a positive floor. The minimum remains
+/// in the graph: its derivative belongs to this law, rather than a detached
+/// exponential surrogate. Temperature controls the floor, not a second pooling.
+pub(super) fn choice_weights(scores: &Tensor, temperature: f32) -> Result<Tensor> {
+    if scores.dtype() != DType::F32 || scores.dims().len() != 1
+        || scores.elem_count() == 0 || !temperature.is_finite() || temperature <= 0. {
+        return Err(invalid("geometric choice score/floor admission"));
+    }
+    let slack = scores.broadcast_sub(&scores.min(0)?)?.affine(1., f64::from(temperature))?;
+    let scaled = slack.broadcast_div(&slack.max(0)?)?;
+    Ok(scaled.sqr()?)
+}
+
+pub(super) fn probabilities(weights: &Tensor, exploration: f32) -> Result<Tensor> {
+    if !(0. ..1.).contains(&exploration) || exploration == 0. {
+        return Err(invalid("geometric exploration admission"));
+    }
+    Ok(weights.broadcast_div(&weights.sum_all()?)?.affine(
+        1. - f64::from(exploration), f64::from(exploration) / weights.elem_count() as f64,
+    )?)
+}
+
+/// Same fixed absolute score gauge as the integer shift/add emission reducer.
+/// Packing uses floor; this continuous shadow supplies the declared local STE.
+pub(super) fn emission_weights(scores: &Tensor) -> Result<Tensor> {
+    Ok(scores.clamp(-8f32, 8f32)?.affine(256., 2049.)?)
+}
+
+pub(super) fn ranking_loss(margin: &Tensor) -> Result<Tensor> {
+    Ok(margin.affine(-1., 1.)?.relu()?.sqr()?)
+}
