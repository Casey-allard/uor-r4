+}
+
+fn fold_columns(values: &mut [f32], cols: usize, gain: &[f32]) {
+    for row in values.chunks_exact_mut(cols) {
+        for (val, &g) in row.iter_mut().zip(gain) {
+            *val *= g;
+        }
+    }
+}
