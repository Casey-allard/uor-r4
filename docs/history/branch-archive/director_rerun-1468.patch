+fn pad(
+    values: &[f32],
+    in_rows: usize,
+    in_cols: usize,
+    out_rows: usize,
+    out_cols: usize,
+) -> Vec<f32> {
+    let mut out = vec![0.0f32; out_rows * out_cols];
+    for r in 0..in_rows {
+        out[r * out_cols..r * out_cols + in_cols]
+            .copy_from_slice(&values[r * in_cols..(r + 1) * in_cols]);
+    }
+    out
+}
