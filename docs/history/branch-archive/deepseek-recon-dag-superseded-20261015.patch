+//! The reader, exercised against fixtures this file builds.
+//!
+//! The experiment's fixtures are generated by a JS script from pinned sources, so this file builds the format
+//! itself: a leaf holds 32 bytes, a parent holds three child ids, and the manifest's scale ladder is derived
+//! from the atom count exactly as `parse_manifest` requires.
+//!
+//! **Records are serialized in dfs-post order** (children before parents, left to right, first occurrence
+//! wins). That is not cosmetic: iterating a `HashMap` randomises the record order per process, which made the
+//! isolation test below flaky (~2%) because "the last record" was a different node every run. Deterministic
+//! order also lets the four retained `recordSha256` values be pinned as known-answer tests.
+
+use std::collections::HashMap;
+use std::path::{Path, PathBuf};
+use uor_r4_recon_dag::*;
+
+struct Fixture {
+    _dir: tempfile::TempDir,
+    manifest: Manifest,
+    digest: [u8; 32],
+    records: PathBuf,
+    /// Nodes in **serialization order**, which is the order they appear in the records file.
+    nodes: Vec<(Id, Node)>,
+}
+
+fn hex(id: &Id) -> String {
+    id.iter().map(|b| format!("{b:02x}")).collect()
+}
+
+fn hex32(d: &[u8; 32]) -> String {
+    d.iter().map(|b| format!("{b:02x}")).collect()
+}
+
+/// `grow` in dfs-post order, deduplicating by id (first occurrence wins, as a content-addressed store does).
+fn grow(atoms: &[u8], scale: u8, out: &mut Vec<(Id, Node)>) -> Id {
+    let data = if scale == 0 {
+        atoms[..32].to_vec()
+    } else {
+        let step = span(scale - 1).expect("span");
+        let mut d = Vec::with_capacity(36);
+        for j in 0..3 {
+            let child = grow(&atoms[j * step..], scale - 1, out);
+            d.extend_from_slice(&child);
+        }
+        d
+    };
+    let node = Node { scale, data };
+    let id = id_for(&node);
+    if !out.iter().any(|(seen, _)| *seen == id) {
+        out.push((id, node));
+    }
+    id
+}
+
+/// Build the DAG for `raw`, writing a manifest and a records file into a temp directory.
+fn build(raw: &[u8]) -> Fixture {
+    let atoms = raw.len().div_ceil(32);
+    let mut padded = raw.to_vec();
+    padded.resize(atoms * 32, 0);
+
+    let mut scales = vec![];
+    let (mut n, mut s) = (atoms, 0u8);
+    while n > 0 {
+        for _ in 0..n % 3 {
+            scales.push(s)
+        }
+        n /= 3;
+        s += 1;
+    }
+    scales.reverse();
+
+    let mut nodes: Vec<(Id, Node)> = Vec::new();
+    let mut roots = vec![];
+    let mut at = 0usize;
+    for scale in &scales {
+        let id = grow(&padded[at..], *scale, &mut nodes);
+        roots.push((id, *scale));
+        at += span(*scale).expect("span");
+    }
+
+    let dir = tempfile::tempdir().expect("tempdir");
+    let records = dir.path().join("obj.records");
+    let mut bytes = Vec::new();
+    for (id, node) in &nodes {
+        bytes.push(node.scale);
+        bytes.extend_from_slice(id);
+        bytes.extend_from_slice(&node.data);
+    }
+    std::fs::write(&records, &bytes).expect("write records");
+
+    let mut text = format!("{} {atoms} {}", raw.len(), roots.len());
+    for (id, scale) in &roots {
+        text.push_str(&format!(" {} {scale}", hex(id)));
+    }
+    std::fs::write(dir.path().join("obj.manifest"), &text).expect("write manifest");
+
+    Fixture {
+        _dir: dir,
+        manifest: parse_manifest(&text).expect("parse"),
+        digest: whole_object_digest(raw),
+        records,
+        nodes,
+    }
+}
+
+fn eager(f: &Fixture) -> EagerBackend {
+    EagerBackend {
+        nodes: f.nodes.iter().cloned().collect::<HashMap<_, _>>(),
+    }
+}
+
+/// The offset of a record's DATA within the records file, found by walking the headers.
+fn offset_of(path: &Path, want: Id) -> Option<usize> {
+    let bytes = std::fs::read(path).ok()?;
+    let mut at = 0usize;
+    while at < bytes.len() {
+        let scale = bytes[at];
+        let size = data_size(scale);
+        let id: Id = bytes[at + 1..at + 13].try_into().ok()?;
+        if id == want {
+            return Some(at + 13);
+        }
+        at += 13 + size;
+    }
+    None
+}
+#[test]
+fn both_backends_agree_byte_for_byte() {
+    let raw: Vec<u8> = (0..1024u32).map(|i| (i % 251) as u8).collect();
+    let f = build(&raw);
+    let indexed = IndexedBackend::open(&f.records).expect("index");
+    assert_eq!(
+        indexed.indexed(),
+        f.nodes.len(),
+        "every record indexed once"
+    );
+    let e = eager(&f);
+    let mut ranges = vec![(0, 0), (0, raw.len()), (raw.len(), raw.len())];
+    for i in 0..200usize {
+        let a = (i * 7919 + 31) % (raw.len() + 1);
+        let b = (a + (i * 17) % 129).min(raw.len());
+        ranges.push((a, b));
+    }
+    for &(a, b) in &ranges {
+        let want = read_range(&f.manifest, &e, a, b).expect("eager");
+        let got = read_range(&f.manifest, &indexed, a, b).expect("indexed");
+        assert_eq!(got.bytes, want.bytes, "{a}..{b}");
+        assert_eq!(got.bytes, &raw[a..b], "{a}..{b}");
+    }
+}
+
+#[test]
+fn a_range_read_reports_what_it_did_not_cover() {
+    let raw: Vec<u8> = (0..1024u32).map(|i| (i % 251) as u8).collect();
+    let f = build(&raw);
+    let indexed = IndexedBackend::open(&f.records).expect("index");
+    let r = read_range(&f.manifest, &indexed, 100, 140).expect("read");
+    match r.verification {
+        Verification::RangeVerified {
+            nodes,
+            unverified_nodes,
+        } => {
+            assert!(nodes > 0, "some nodes were authenticated");
+            assert!(
+                unverified_nodes > 0,
+                "a 40-byte range cannot cover the whole store"
+            );
+            assert_eq!(nodes + unverified_nodes, f.nodes.len());
+        }
+        other => panic!("expected the weaker claim, got {other:?}"),
+    }
+    assert!(
+        !r.whole_object_verified(),
+        "a range read is not object integrity"
+    );
+}
+
+#[test]
+fn a_whole_object_read_is_the_strong_claim() {
+    let raw: Vec<u8> = (0..1024u32).map(|i| (i % 251) as u8).collect();
+    let f = build(&raw);
+    let indexed = IndexedBackend::open(&f.records).expect("index");
+    let r = read_whole_object(&f.manifest, &indexed, f.digest).expect("whole object");
+    assert_eq!(r.bytes, raw);
+    assert!(r.whole_object_verified());
+    assert_eq!(
+        read_whole_object(&f.manifest, &indexed, [0u8; 32]),
+        Err(Error::WholeObject)
+    );
+}
+
+/// The reason this crate exists: two fixtures built the same way from bytes that differ in one bit are BOTH
+/// internally consistent, so node-id verification cannot tell them apart and only a declared whole-object
+/// digest refuses the wrong one.
+#[test]
+fn a_consistent_dag_can_still_reconstruct_the_wrong_object() {
+    let raw: Vec<u8> = (0..1024u32).map(|i| (i % 251) as u8).collect();
+    let mut other = raw.clone();
+    other[0] ^= 1;
+    let want = build(&raw);
+    let got = build(&other);
+    let e = eager(&got);
+    let r = read_range(&got.manifest, &e, 0, raw.len()).expect("internally consistent");
+    assert_ne!(r.bytes, raw, "the object really is different");
+    assert!(
+        !r.whole_object_verified(),
+        "and the read does not claim otherwise"
+    );
+    let indexed = IndexedBackend::open(&got.records).expect("index");
+    assert_eq!(
+        read_whole_object(&got.manifest, &indexed, want.digest),
+        Err(Error::WholeObject),
+        "a node id cannot make this claim; the object digest can"
+    );
+    assert!(
+        read_whole_object(&got.manifest, &indexed, got.digest)
+            .expect("its own digest")
+            .whole_object_verified(),
+        "a consistent DAG verifies against its own object"
+    );
+}
+
+#[test]
+fn a_corrupt_record_is_caught() {
+    let raw: Vec<u8> = (0..256u32).map(|i| (i % 251) as u8).collect();
+    let f = build(&raw);
+    let mut broken: HashMap<Id, Node> = f.nodes.iter().cloned().collect();
+    let id = *broken.keys().next().expect("a node");
+    broken.get_mut(&id).expect("node").data[0] ^= 1;
+    let e = EagerBackend { nodes: broken };
+    assert_eq!(
+        read_range(&f.manifest, &e, 0, raw.len()),
+        Err(Error::Integrity)
+    );
+}
+/// The on-demand claim, proved rather than asserted, and no longer flaky. The victim is named explicitly -
+/// the leaf covering bytes 4096..4128, chosen because the requested range is 0..64 and the two cannot
+/// overlap - instead of the last byte of the file, which in HashMap order was a different node every run
+/// and landed inside the range about 2% of the time.
+#[test]
+fn the_indexed_backend_does_not_read_records_outside_the_range() {
+    let raw: Vec<u8> = (0..8192u32).map(|i| (i % 251) as u8).collect();
+    let f = build(&raw);
+    let victim = id_for(&Node {
+        scale: 0,
+        data: raw[4096..4128].to_vec(),
+    });
+    let at = offset_of(&f.records, victim).expect("the victim is stored");
+    let mut bytes = std::fs::read(&f.records).expect("read records");
+    bytes[at] ^= 1;
+    std::fs::write(&f.records, &bytes).expect("rewrite records");
+
+    let indexed = IndexedBackend::open(&f.records).expect("index");
+    let r = read_range(&f.manifest, &indexed, 0, 64).expect("the range never read the victim");
+    assert_eq!(r.bytes, &raw[0..64]);
+    assert_eq!(
+        read_whole_object(&f.manifest, &indexed, f.digest),
+        Err(Error::Integrity),
+        "the corruption is real: the whole-object read finds it"
+    );
+}
+
+/// Check one retained case: the input, the node count and the serialized records.
+fn retained_case(name: &str, bytes: &[u8], input_sha: &str, record_sha: &str, nodes: usize) {
+    assert_eq!(
+        hex32(&whole_object_digest(bytes)),
+        input_sha,
+        "{name}: the input is not the retained one"
+    );
+    let f = build(bytes);
+    assert_eq!(f.nodes.len(), nodes, "{name}: node count");
+    let records = std::fs::read(&f.records).expect("read records");
+    assert_eq!(
+        hex32(&whole_object_digest(&records)),
+        record_sha,
+        "{name}: the serialized records differ from the retained artifact"
+    );
+}
+
+/// The retained evidence, pinned. The four cases are rebuilt from the constructions in make-fixtures.cjs and
+/// checked against the inputSha256 and recordSha256 recorded in construction.json. This is the strongest
+/// claim this file makes: the format, the id function and the dfs-post serialization reproduce the retained
+/// artifact byte for byte, and the node counts match results.txt.
+#[test]
+fn the_retained_fixtures_reproduce_byte_for_byte() {
+    let unique: Vec<u8> = (0..1024)
+        .flat_map(|i| whole_object_digest(format!("CS_RANGE_ATOM_{i}").as_bytes()).to_vec())
+        .collect();
+    retained_case(
+        "unique",
+        &unique,
+        "8d2791644fd2ae279fca2163c4866b4228f40a4881201928f9a17b4f8c95af58",
+        "fc17b3ca7e4f55fdab0a6bf8ca186fd9ff1f6c131b3c2a4ac1b004baabcec354",
+        1532,
+    );
+
+    let repeated: Vec<u8> = (0..243)
+        .flat_map(|i| vec![[65u8, 66, 67][i % 3]; 32])
+        .collect();
+    retained_case(
+        "repeated",
+        &repeated,
+        "6b147ee2354189f0918fb4d2764d20720c81cecb0ee69332d48337fc79529810",
+        "208da620e502d69c090b2fe955f3048482120e984a1f20f070bc4d70efe34821",
+        8,
+    );
+
+    let mut utf8 = String::new();
+    utf8.push_str(&"a".repeat(31));
+    utf8.push('\u{1f300}');
+    utf8.push_str(&"b".repeat(28));
+    utf8.push_str("\u{97f3}\u{697d}");
+    utf8.push_str(&"\u{e9}\0tail\0".repeat(67));
+    retained_case(
+        "utf8",
+        &utf8.into_bytes(),
+        "f8e731b5a8530aad332bc0052e7e7feebb6c07872f72892766dfed4740b97aaf",
+        "67b6a6595cddcadfaec007342ad5e105445ff960e69c3ba5f6995f4f5242df82",
+        9,
+    );
+
+    retained_case(
+        "empty",
+        &[],
+        "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
+        "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
+        0,
+    );
+}
+/// **The seam must not be able to abort a caller.** A backend handing back a node whose data does not match
+/// its scale is malformed, and the reader answers `Err(Format)` rather than panicking at the child slice -
+/// this is the integration point a future store plugs into.
+#[test]
+fn a_short_record_is_an_error_not_a_panic() {
+    struct Short(Node);
+    impl Backend for Short {
+        fn node(&self, _id: Id) -> Result<Node, Error> {
+            Ok(self.0.clone())
+        }
+        fn stored(&self) -> usize {
+            1
+        }
+    }
+    let raw: Vec<u8> = (0..128u32).map(|i| i as u8).collect();
+    let f = build(&raw);
+    let (root, scale) = f.manifest.roots[0];
+    assert!(scale > 0, "this fixture's first root is a parent");
+    let bad = Short(
+        root,
+        Node {
+            scale,
+            data: vec![0u8; 12],
+        },
+    );
+    assert_eq!(read_range(&f.manifest, &bad, 0, 32), Err(Error::Format));
+}
+
+/// A node larger than the digest's buffer is truncated rather than panicking, so `id_for` cannot abort a
+/// process on a malformed store.
+#[test]
+fn id_for_does_not_panic_on_an_oversized_node() {
+    let node = Node {
+        scale: 0,
+        data: vec![7u8; 500],
+    };
+    let _ = id_for(&node);
+}
