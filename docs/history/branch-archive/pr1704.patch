+        KeyShift::AddToInit.apply(&mut plain, true)?;
+        assert!(plain.read_key_shift());
+        assert!(KeyShift::Off.apply(&mut plain, true).is_err());
+        assert!(KeyShift::AddToInit.apply(&mut plain, true).is_err());
