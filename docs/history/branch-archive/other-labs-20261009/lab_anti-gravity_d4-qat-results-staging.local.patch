+
+        println!("Identified {} weight maps to evaluate.", map_specs.len());
+
+        // 4. Extract Float Folded Weights (W) and Dequantized Artifact Weights (W_hat)
+        let mut float_folded: BTreeMap<String, Vec<f32>> = BTreeMap::new();
