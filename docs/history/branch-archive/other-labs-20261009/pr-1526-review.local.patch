+    match candle_core::Device::new_metal(0) {
+        Ok(device) => {
+            println!("Metal device 0 initialized successfully: {:?}", device);
+            Ok(())
+        }
+        Err(e) => {
+            println!("Metal device unavailable (skipping GPU tests): {e}");
+            Ok(())
+        }
+    }
+}
