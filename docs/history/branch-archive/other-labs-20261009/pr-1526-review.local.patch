+        .expect("dd_cpu")
+        .flatten_all()?
+        .to_vec1::<f32>()?;
+
+    let t_metal = candle_core::Var::from_tensor(&candle_core::Tensor::from_vec(
+        trans_data, shape, &metal_dev,
+    )?)?;
+    let d_metal = candle_core::Var::from_tensor(&candle_core::Tensor::from_vec(
