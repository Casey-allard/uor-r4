+            height: 1,
+            depth: 1,
+        };
+        encoder.use_resource(logits, MTLResourceUsage::Read);
+        encoder.use_resource(targets, MTLResourceUsage::Read);
+        encoder.use_resource(loss_per_row, MTLResourceUsage::Write);
