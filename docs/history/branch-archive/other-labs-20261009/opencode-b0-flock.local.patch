+        let mut keys = Vec::with_capacity(visible * 4);
+        for source in 0..visible {
+            for lane in 0..4 {
+                keys.push((source as f32) * 0.2 + (lane as f32) * 0.1 - 0.7);
+            }
+        }
+        keys
