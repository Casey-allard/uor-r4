+            .chunks_exact(2)
+            .map(|b| u32::from(u16::from_le_bytes([b[0], b[1]])))
+            .collect();
+        if tokens.iter().any(|&t| t as usize >= vocab) {
+            return Err(invalid("token file has an out-of-vocabulary token"));
+        }
+        Ok(tokens)
+    }
 }
