+
+fn set_model_var(
+    model: &StackModel,
+    name: &str,
+    values: Vec<f32>,
+) -> Result<(), Box<dyn std::error::Error>> {
+    let var = model
+        .variables()
+        .get(name)
+        .ok_or_else(|| format!("model has no variable {name}"))?;
+    var.set(&Tensor::from_vec(
+        values,
+        var.as_tensor().shape(),
+        var.as_tensor().device(),
+    )?)?;
+    Ok(())
+}
