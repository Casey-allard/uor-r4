+            .map(|(&v, &d)| (f64::from(v) - f64::from(d)).powi(2))
+            .sum();
+        assert!(
+            mse_opt <= mse_rtn + 1e-6,
+            "Optimal scale search must achieve equal or lower MSE: opt {mse_opt} vs rtn {mse_rtn}"
+        );
+
+        Ok(())
+    }
