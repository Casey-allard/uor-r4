+fn world_of(args: &Args) -> Result<World> {
+    match args.optional("world").as_deref() {
+        None | Some("v1") => {
+            for key in V2_ONLY {
+                if args.0.contains_key(key) {
+                    return Err(invalid(format!("{key}= applies to world=v2 only")));
