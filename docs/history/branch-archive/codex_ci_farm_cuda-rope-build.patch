+    let x_data: Vec<f32> = (0..total).map(|i| (i as f32 * 0.05).sin()).collect();
+    let w_data: Vec<f32> = (0..width).map(|i| i as f32 * 0.02 + 0.8).collect();
+    let grad_data: Vec<f32> = (0..total).map(|i| (i as f32 * 0.03).cos()).collect();
