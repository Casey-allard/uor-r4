+    let preparation_audit = preparation_audit(c)?;
+    let report = read(&c.recomposition_root.join("report.json"))?;
+    if report["schema"] != "uor-r4.bank-generate-panel/1"
+        || report["status"] != "COMPLETED"
+        || report["cases"] != 512
