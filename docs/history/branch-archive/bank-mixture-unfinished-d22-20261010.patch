+        "diagnostic_report_sha256":BASELINE_REPORT_SHA,"diagnostic_manifest_sha256":BASELINE_MANIFEST_SHA,
+        "diagnostic_scope":"opened #2164 panel; no training bank overlap; not fresh qualification"});
