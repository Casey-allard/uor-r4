+fn packet_set(episodes: &[Episode]) -> Result<BTreeSet<String>> {
+    episodes
+        .iter()
+        .map(|e| {
+            let mut value = serde_json::to_value(&e.packet)?;
+            value
+                .as_object_mut()
+                .ok_or_else(|| bad("packet object absent"))?
+                .remove("id");
+            Ok(sha256_bytes(&serde_json::to_vec(&value)?))
+        })
+        .collect()
