+// Peel only exact structural zeros: permutations give B'=[T E;0 F]. T and E
+// retain original dyadic coefficients; no Schur arithmetic or row is dropped.
+fn triangular_exact_factorize(basis: &crate::repair::Basis) -> Result<Option<LUFactors>, Error> {
+    let n = basis.columns.len();
+    let mut active_rows = vec![true; n];
+    let mut active_cols = vec![true; n];
+    let mut peeled = Vec::new();
+    loop {
+        let before = peeled.len();
+        for c in 0..n {
+            if !active_cols[c] {
+                continue;
+            }
+            let (rows, values) = &basis.columns[c];
+            let mut entries = rows
+                .iter()
+                .zip(values)
+                .filter(|&(&r, &v)| active_rows[r] && v != 0.0);
+            let Some((&r, &diagonal)) = entries.next() else {
+                crate::repair::count(|s| s.exact_singular += 1);
+                return Err(Error::SingularMatrix);
+            };
+            if entries.next().is_none() {
+                peeled.push((c, r, diagonal));
+                active_rows[r] = false;
+                active_cols[c] = false;
+            }
+        }
+        if before == peeled.len() {
+            break;
+        }
+    }
+    let p = peeled.len();
+    if p == 0 {
+        return Ok(None);
+    }
+    let core_rows = (0..n).filter(|&r| active_rows[r]).collect::<Vec<_>>();
+    let core_cols = (0..n).filter(|&c| active_cols[c]).collect::<Vec<_>>();
+    let m = n - p;
+    if core_rows.len() != m || core_cols.len() != m {
+        return Err(Error::UnreliableFactorization);
+    }
+    let mut row_to_core = vec![None; n];
+    for (i, &r) in core_rows.iter().enumerate() {
+        row_to_core[r] = Some(i);
+    }
+    let columns = core_cols
+        .iter()
+        .map(|&c| {
+            let (rows, values) = &basis.columns[c];
+            rows.iter()
+                .zip(values)
+                .filter_map(|(&r, &v)| row_to_core[r].filter(|_| v != 0.0).map(|i| (i, v)))
+                .unzip()
+        })
+        .collect::<Vec<(Vec<usize>, Vec<f64>)>>();
+    let core_basis = crate::repair::Basis::new(m, |c| (&columns[c].0, &columns[c].1))?;
+    let core = dense_exact_factorize(&core_basis)?;
+    let mut row_new2orig = peeled.iter().map(|&(_, r, _)| r).collect::<Vec<_>>();
+    let mut col_new2orig = peeled.iter().map(|&(c, _, _)| c).collect::<Vec<_>>();
+    for i in 0..m {
+        let r = core.row_perm.as_ref().map_or(i, |perm| perm.new2orig[i]);
+        let c = core.col_perm.as_ref().map_or(i, |perm| perm.new2orig[i]);
+        row_new2orig.push(core_rows[r]);
+        col_new2orig.push(core_cols[c]);
+    }
+    let inverse = |new2orig: &[usize]| {
+        let mut orig2new = vec![0; n];
+        for (i, &old) in new2orig.iter().enumerate() {
+            orig2new[old] = i;
+        }
+        orig2new
+    };
+    let row_orig2new = inverse(&row_new2orig);
+    let col_orig2new = inverse(&col_new2orig);
+    let core_diagonal = core
+        .upper
+        .diag
+        .as_ref()
+        .ok_or(Error::UnreliableFactorization)?;
+    let mut lower = SparseMat::new(n);
+    let mut upper = SparseMat::new(n);
+    let mut diagonal = Vec::with_capacity(n);
+    for c in 0..n {
+        let original_c = col_new2orig[c];
+        let (rows, values) = &basis.columns[original_c];
+        let mut top = rows
+            .iter()
+            .zip(values)
+            .filter_map(|(&r, &v)| {
+                let i = row_orig2new[r];
+                (i < p && i != c && v != 0.0).then_some((i, v))
+            })
+            .collect::<Vec<_>>();
+        top.sort_unstable_by_key(|&(r, _)| r);
+        for (r, v) in top {
+            if r >= c {
+                return Err(Error::UnreliableFactorization);
+            }
+            upper.push(r, v);
+        }
+        if c < p {
+            diagonal.push(peeled[c].2);
+        } else {
+            let j = c - p;
+            for (r, &v) in core.upper.nondiag.col_iter(j) {
+                upper.push(p + r, v);
+            }
+            for (r, &v) in core.lower.nondiag.col_iter(j) {
+                lower.push(p + r, v);
+            }
+            diagonal.push(core_diagonal[j]);
+        }
+        upper.seal_column();
+        lower.seal_column();
+    }
+    if std::env::var_os("UOR_MICROLP_PROGRESS").is_some() {
+        eprintln!("d22-numerics event=exact-triangular-split rows={n} peeled={p} core={m}");
+    }
+    Ok(Some(LUFactors {
+        lower: TriangleMat {
+            nondiag: lower,
+            diag: None,
+        },
+        upper: TriangleMat {
+            nondiag: upper,
+            diag: Some(diagonal),
+        },
+        row_perm: Some(Perm {
+            orig2new: row_orig2new,
+            new2orig: row_new2orig,
+        }),
+        col_perm: Some(Perm {
+            orig2new: col_orig2new,
+            new2orig: col_new2orig,
+        }),
+    }))
+}
