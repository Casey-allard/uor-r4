+            assert_eq!(
+                weight > 0.0,
+                kept.contains(&position) || position == terminal,
+                "weight at response position {position} (kept {kept:?}, terminal {terminal})"
+            );
+        }
+        // The counts are the mask's own accounting, and the terminal target and
+        // every query keep the value they were materialized with.
+        assert_eq!(mask.kept_weights, queries.len() + 1);
+        assert_eq!(mask.zeroed_weights, response_tokens - queries.len() - 1);
+        for &position in &kept {
+            assert_eq!(weights[position], before[row * time + position]);
+        }
+        assert_eq!(weights[terminal], before[row * time + terminal]);
+        // The unlabelled row is untouched, weight for weight.
+        let other = 1 - row;
+        assert_eq!(
+            &batch.weights[other * time..(other + 1) * time],
+            &before[other * time..(other + 1) * time]
+        );
+        // The answer span is a PROPER subset here: the sentence around it and
+        // the value's own neighbours lost their weight.
+        assert!(mask.zeroed_weights >= 2);
+        let _ = fs::remove_dir_all(&directory);
+    }
+
+    #[test]
+    fn answer_span_supervision_leaves_a_batch_without_labels_byte_identical() {
+        let directory = std::env::temp_dir().join(format!(
+            "uor-r4-stack-answer-span-none-{}-{}",
+            std::process::id(),
+            line!()
+        ));
+        let _ = fs::remove_dir_all(&directory);
+        fs::create_dir_all(&directory).unwrap();
+        let tokenizer = tokenizer();
+        let split = split(&directory, &tokenizer);
+        // Labels for the OTHER source: the sampled rows carry none.
+        write_labels(&directory, &split, "sounds", &test_label_rows(&split, "sounds"));
+        let labels = ReadBindingLabels::load(&directory, &split, "sounds").unwrap();
+        let (_, contract) = episode_contract(&tokenizer, split.vocab_size()).unwrap();
+        let index = split.index(contract).unwrap();
+        let mut batch = index
+            .materialize(&[0, 1], PrefixPolicy::FullPrefix)
+            .unwrap();
+        let before = batch.weights.clone();
+        let time = batch.time;
+        let mask = labels.restrict_to_answer_spans(&mut batch, time).unwrap();
+        assert_eq!(mask, AnswerSpanMask::default());
+        assert_eq!(batch.weights, before);
+        let _ = fs::remove_dir_all(&directory);
+    }
 }
