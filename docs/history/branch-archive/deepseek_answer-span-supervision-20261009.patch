+    fn write_labels(
+        directory: &Path,
+        split: &DialogueSplit,
+        source: &str,
+        rows: &[(usize, Vec<usize>, Vec<usize>, Vec<usize>)],
+    ) {
+        use sha2::Digest;
+        let range = split.source_range(source).unwrap();
+        let tokens = &split.reader.as_slice()[range.clone()];
+        let mut digest = sha2::Sha256::new();
+        for token in tokens {
+            digest.update(token.to_le_bytes());
+        }
