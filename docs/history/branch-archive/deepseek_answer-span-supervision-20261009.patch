+            lines.push_str(
+                &json!({"r": start, "b": bound, "c": competing, "q": queries}).to_string(),
+            );
+            lines.push('\n');
+        }
+        fs::write(directory.join("binding_labels.jsonl"), lines).unwrap();
+        fs::write(
+            directory.join("binding_labels.json"),
+            json!({
+                "schema": "uor-r4.read-binding-labels/1",
+                "tokens": tokens.len(),
+                "tokens_payload_sha256": hex,
+            })
+            .to_string(),
+        )
+        .unwrap();
+    }
