+    /// The two source-local label rows of the test split: for each source, one
+    /// response whose answer's last two content tokens are its value, and the
+    /// position before the response ("bound") as the premise occurrence.
+    fn test_label_rows(split: &DialogueSplit, source: &str) -> Vec<(usize, Vec<usize>, Vec<usize>, Vec<usize>)> {
+        let range = split.source_range(source).unwrap();
+        let mut rows = Vec::new();
+        for start in range.start + 1..range.end {
+            if split.mask[start] == 1 && split.mask[start - 1] == 0 && rows.is_empty() {
+                let local = start - range.start;
+                let end = (start..range.end)
+                    .find(|&p| split.mask[p] == 0)
+                    .unwrap_or(range.end);
+                // `end - 1` is the terminating EOS, so the last two content
+                // tokens are predicted at `end - 4` and `end - 3`.
+                assert!(end - start >= 5, "a response with room for a value");
+                let queries = vec![end - 4 - range.start, end - 3 - range.start];
+                rows.push((local, vec![local - 1], vec![], queries));
+            }
+        }
+        assert_eq!(rows.len(), 1, "one labelled response per source");
+        rows
