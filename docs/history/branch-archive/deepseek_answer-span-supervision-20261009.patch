+/// What [`ReadBindingLabels::restrict_to_answer_spans`] changed in one batch.
+#[derive(Clone, Copy, Debug, Default, Eq, PartialEq)]
+pub struct AnswerSpanMask {
+    /// Batch rows whose response carries a label and holds at least one answer
+    /// position inside this window.
+    pub labelled_rows: usize,
+    /// Response weights left at their materialized value: the answer span and
+    /// the response's terminating target.
+    pub kept_weights: usize,
+    /// Response weights zeroed: every other supervised position of a labelled
+    /// response.
+    pub zeroed_weights: usize,
+}
+
+impl ReadBindingLabels {
+    /// Restrict the language-loss weights of every labelled response to its
+    /// `answer` span: the positions whose next token is a token of the
+    /// answer's expected value (`queries`, the same positions the read-binding
+    /// loss supervises) plus the response's terminating target, which keeps its
+    /// weight so the run can still learn to stop. Every other supervised
+    /// position of a labelled response - the sentence around the value - is
+    /// zeroed. Rows without a label, and the prefix and padding of every row,
+    /// are untouched, so `time` must be the batch's own row stride.
+    pub fn restrict_to_answer_spans(
+        &self,
+        batch: &mut EpisodeBatch,
+        time: usize,
+    ) -> Result<AnswerSpanMask> {
+        if time != batch.time || batch.weights.len() != batch.rows.len() * time {
+            return Err(invalid("answer-span weights need the batch's own time"));
+        }
+        let mut mask = AnswerSpanMask::default();
+        for (row_index, row) in batch.rows.iter().enumerate() {
+            let Some(label) = self.by_response.get(&row.response_start) else {
+                continue;
+            };
+            if label
+                .queries
+                .iter()
+                .chain(&label.bound)
+                .chain(&label.competing)
+                .any(|&p| p < row.document_start)
+            {
+                return Err(invalid("a binding label points before its document"));
+            }
+            let terminal = row
+                .counts
+                .real_input_positions
+                .checked_sub(1)
+                .ok_or_else(|| invalid("an answer-span row has no terminal target"))?;
+            let mut keep = vec![false; time];
+            keep[terminal] = true;
+            let mut queries = 0usize;
+            for &query in &label.queries {
+                let query = query - row.document_start;
+                if query < row.counts.real_input_positions && query < time {
+                    keep[query] = true;
+                    queries += 1;
+                }
+            }
+            if queries == 0 {
+                continue;
+            }
+            mask.labelled_rows += 1;
+            let row_weights = &mut batch.weights[row_index * time..(row_index + 1) * time];
+            for (position, weight) in row_weights.iter_mut().enumerate() {
+                if *weight <= 0.0 {
+                    continue;
+                }
+                if keep[position] {
+                    mask.kept_weights += 1;
+                } else {
+                    *weight = 0.0;
+                    mask.zeroed_weights += 1;
+                }
+            }
+        }
+        Ok(mask)
+    }
+}
