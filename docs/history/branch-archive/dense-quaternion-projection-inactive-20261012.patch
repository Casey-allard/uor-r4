-        operator_kappa: report.operator_kappa,
-        composition_kappa: table
-            .reproduce_kappa()
-            .map_err(|e| invalid(e.to_string()))?,
-        roots,
-        axes,
-        compose,
-        root_of_state,
-        bfs_actions,
-        bfs_edges,
-        branch_targets,
-        identity,
