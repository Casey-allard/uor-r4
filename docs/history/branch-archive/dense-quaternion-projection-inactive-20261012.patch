+                        f64::from(w[1]),
+                        f64::from(w[2]),
+                        f64::from(w[3]),
+                    ],
+                    [
+                        f64::from(x[0]),
+                        f64::from(x[1]),
+                        f64::from(x[2]),
+                        f64::from(x[3]),
+                    ],
