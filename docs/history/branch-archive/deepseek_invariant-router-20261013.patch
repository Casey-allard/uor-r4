From caef102cccf07efa7b1d3a8bb344490f9244d772 Mon Sep 17 00:00:00 2001
From: Casey Allard <casey.allard@amnhealthcare.com>
Date: Mon, 12 Oct 2026 03:38:57 -0400
Subject: [PATCH 2/2] Optimize CellTree::route: drop the O(k) duplicate scan
 (References #2029)

---
 crates/uor-r4-training/src/stack_address.rs | 8 +++++++-
 1 file changed, 7 insertions(+), 1 deletion(-)

diff --git a/crates/uor-r4-training/src/stack_address.rs b/crates/uor-r4-training/src/stack_address.rs
index 0322a6297..ea95d7b69 100644
--- a/crates/uor-r4-training/src/stack_address.rs
+++ b/crates/uor-r4-training/src/stack_address.rs
@@ -474,10 +474,16 @@ impl CellTree {
             };
         }
         order.extend(self.children[query as usize].iter().copied());
+        // order is the query's path (query -> root) plus its children: each
+        // cell appears exactly once, so a candidate (one cell) matches at most
+        // one cell and no duplicate check is needed. The linear contains scan
+        // over the written prefix was O(k) per candidate, which made the walk
+        // O(|order| * window * k); without it the walk is O(|order| * window),
+        // still not O(1).
         let mut written = 0usize;
         for cell in order {
             for (index, &candidate) in candidates.iter().enumerate() {
-                if candidate == cell && !out[..written].contains(&index) {
+                if candidate == cell {
                     if written == out.len() {
                         return written;
                     }
-- 
