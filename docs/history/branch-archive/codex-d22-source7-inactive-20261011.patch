+#[cfg(test)]
+mod tests {
+    use super::*;
+    const PRIMES: [u32; 3] = [2_147_483_647, 2_147_483_629, 2_147_483_587];
+
+    #[test]
+    fn invalid_moduli_are_rejected() {
+        for p in [0, 1, 2, 4, 9, 25, 341, 561, 2_147_483_645, 1 << 31] {
+            assert_eq!(validate_prime(p), Err(Error::InvalidPrime));
+        }
+        for p in PRIMES {
+            assert_eq!(validate_prime(p), Ok(()));
+        }
+    }
+    #[test]
+    fn exact_ieee_residues_include_signed_zero_subnormal_and_large_exponents() -> Result<()> {
+        for p in PRIMES {
+            for value in [
+                0.0,
+                -0.0,
+                0.1,
+                -0.1,
+                f64::from_bits(1),
+                -f64::from_bits(1),
+                f64::MIN_POSITIVE,
+                f64::MAX,
+                -f64::MAX,
+                7.0,
+                -14.0,
+            ] {
+                let q = BigRational::from_float(value).ok_or(Error::NonFinite)?;
+                let expected = mul_mod(
+                    mod_u32(q.numer(), p)?,
+                    pow_mod(mod_u32(q.denom(), p)?, p - 2, p),
+                    p,
+                );
+                assert_eq!(dyadic_residue(value, p)?, expected);
+            }
+            for value in [f64::NAN, f64::INFINITY, f64::NEG_INFINITY] {
+                assert_eq!(dyadic_residue(value, p), Err(Error::NonFinite));
+            }
+        }
+        Ok(())
+    }
+    #[test]
+    fn crt_reconstructs_signed_rationals_and_rejects_duplicates() -> Result<()> {
+        for (numerator, denominator) in [(0, 1), (1, 3), (-17, 19), (123_456, 789)] {
+            let expected = BigRational::new(numerator.into(), denominator.into());
+            let mut reconstruction = Reconstruction::new(128)?;
+            for p in PRIMES {
+                let residue = mul_mod(
+                    mod_u32(expected.numer(), p)?,
+                    pow_mod(mod_u32(expected.denom(), p)?, p - 2, p),
+                    p,
+                );
+                reconstruction.append(residue, p)?;
+            }
+            assert_eq!(reconstruction.candidate(64)?, expected);
+            assert_eq!(
+                reconstruction.append(0, PRIMES[0]),
+                Err(Error::DuplicatePrime)
+            );
+        }
+        Ok(())
+    }
+    #[test]
+    fn an_insufficient_modulus_is_not_an_exact_witness() -> Result<()> {
+        let expected = BigRational::new(1.into(), BigInt::one() << 60);
+        let p = PRIMES[0];
+        let residue = pow_mod(mod_u32(expected.denom(), p)?, p - 2, p);
+        let mut reconstruction = Reconstruction::new(128)?;
+        reconstruction.append(residue, p)?;
+        let candidate = reconstruction.candidate(64)?;
+        assert_ne!(candidate, expected);
+        assert_eq!(
+            verify_solution(&[2_f64.powi(60)], 1, &[1.0], &[candidate]),
+            Err(Error::InvalidWitness)
+        );
+        Ok(())
+    }
+    #[test]
+    fn original_problem_witness_rejects_a_rounded_near_solution() -> Result<()> {
+        let matrix = [1.0, 0.5, 0.0, 2.0];
+        let rhs = [1.0, 1.0];
+        let exact = [
+            BigRational::new(3.into(), 4.into()),
+            BigRational::new(1.into(), 2.into()),
+        ];
+        verify_solution(&matrix, 2, &rhs, &exact)?;
+        let wrong = [
+            BigRational::from_float(0.75 + f64::EPSILON).ok_or(Error::NonFinite)?,
+            exact[1].clone(),
+        ];
+        assert_eq!(
+            verify_solution(&matrix, 2, &rhs, &wrong),
+            Err(Error::InvalidWitness)
+        );
+        Ok(())
+    }
+    #[test]
+    fn crt_storage_limit_is_explicit_and_transactional() -> Result<()> {
+        let mut reconstruction = Reconstruction::new(32)?;
+        reconstruction.append(1, PRIMES[0])?;
+        assert_eq!(
+            reconstruction.append(1, PRIMES[1]),
+            Err(Error::ResourceLimit)
+        );
+        assert_eq!(reconstruction.candidate(32)?, BigRational::one());
+        Ok(())
+    }
+
+    #[test]
+    fn factor_decode_preserves_pivot_permutation_and_never_calls_it_a_certificate() -> Result<()> {
+        let raw = [3.0, 4.0, 0.0, 2.0];
+        let mut residues = FactorResidues {
+            n: 2,
+            primes: PRIMES.to_vec(),
+            packed: Vec::new(),
+            permutations: vec![1, 0, 1, 0, 1, 0],
+            rejected: vec![0, 0, 0],
+        };
+        for p in PRIMES {
+            for value in raw {
+                residues.packed.push(dyadic_residue(value, p)?);
+            }
+        }
+        let candidate = residues.candidate(128, 64)?;
+        assert_eq!(candidate.packed, raw);
+        assert_eq!(candidate.new_to_original, [1, 0]);
+        // A different pivot pattern is not mixed into the same LU reconstruction.
+        residues.permutations[4..].copy_from_slice(&[0, 1]);
+        assert_eq!(residues.candidate(128, 64)?.participating_primes.len(), 2);
+        residues.permutations[..2].copy_from_slice(&[1, 1]);
+        assert!(matches!(
+            residues.candidate(128, 64),
+            Err(Error::InvalidWitness)
+        ));
+        Ok(())
+    }
+
+    #[test]
+    fn modular_singularity_is_only_a_reconstruction_blocker() {
+        let residues = FactorResidues {
+            n: 1,
+            primes: vec![PRIMES[0]],
+            packed: vec![0],
+            permutations: vec![0],
+            rejected: vec![1],
+        };
+        assert!(matches!(
+            residues.candidate(64, 64),
+            Err(Error::ReconstructionPending)
+        ));
+        let malformed = BigRational::new_raw(1.into(), 0.into());
+        assert_eq!(
+            verify_solution(&[1.0], 1, &[1.0], &[malformed]),
+            Err(Error::InvalidWitness)
+        );
+    }
+
+    #[test]
+    fn shared_crt_plan_matches_scalar_accumulation_and_rejects_bad_shapes() -> Result<()> {
+        let plan = CrtPlan::new(&PRIMES, 128)?;
+        for (numerator, denominator) in [(1, 3), (-17, 19), (0, 1)] {
+            let value = BigRational::new(numerator.into(), denominator.into());
+            let residues = PRIMES
+                .iter()
+                .map(|&p| {
+                    Ok(mul_mod(
+                        mod_u32(value.numer(), p)?,
+                        pow_mod(mod_u32(value.denom(), p)?, p - 2, p),
+                        p,
+                    ))
+                })
+                .collect::<Result<Vec<_>>>()?;
+            assert_eq!(plan.candidate(residues, 64)?, value);
+        }
+        assert_eq!(plan.candidate([0, 0], 64), Err(Error::Shape));
+        assert_eq!(plan.candidate([0, 0, 0, 0], 64), Err(Error::Shape));
+        assert_eq!(
+            plan.candidate([PRIMES[0], 0, 0], 64),
+            Err(Error::InvalidWitness)
+        );
+        Ok(())
+    }
+}
