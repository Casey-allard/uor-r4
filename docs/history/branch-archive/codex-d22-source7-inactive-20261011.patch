+//! Inactive GPU numerical component, not LP or model qualification.
+//! Modular elimination proposes rationals; original-input checks admit them.
+#![cfg_attr(not(feature = "cuda"), forbid(unsafe_code))]
+
+use num_bigint::BigInt;
+use num_rational::BigRational;
+use num_traits::{One, Signed, ToPrimitive, Zero};
+
+#[cfg(feature = "cuda")]
+pub mod cuda;
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub enum Error {
+    Shape,
+    NonFinite,
+    InvalidPrime,
+    DuplicatePrime,
+    ResourceLimit,
+    ReconstructionPending,
+    InvalidWitness,
+    Device(String),
+}
+impl std::fmt::Display for Error {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        write!(f, "GPU exact numerics: {self:?}")
+    }
+}
+impl std::error::Error for Error {}
+pub type Result<T> = std::result::Result<T, Error>;
+
+#[derive(Debug)]
+pub struct FactorResidues {
+    pub n: usize,
+    pub primes: Vec<u32>,
+    pub packed: Vec<u32>,
+    pub permutations: Vec<u32>,
+    pub rejected: Vec<u32>,
+}
+#[derive(Debug)]
+pub struct CandidateFactors {
+    /// Row-major unit-diagonal L below the diagonal, U on and above it.
+    pub packed: Vec<f64>,
+    pub new_to_original: Vec<usize>,
+    pub participating_primes: Vec<u32>,
+}
+impl FactorResidues {
+    /// Only an original-basis certificate can admit these rounded factors.
+    pub fn candidate(&self, raw_bits: u64, result_bits: u64) -> Result<CandidateFactors> {
+        let n = self.n;
+        let count = self.primes.len();
+        let square = n.checked_mul(n).ok_or(Error::Shape)?;
+        let cells = square.checked_mul(count).ok_or(Error::Shape)?;
+        if n == 0
+            || n > 1_040
+            || count == 0
+            || count > 4_096
+            || cells > 64 * 1024 * 1024
+            || self.packed.len() != cells
+            || self.permutations.len() != n * count
+            || self.rejected.len() != count
+            || self.rejected.iter().any(|&v| v > 1)
+        {
+            return Err(Error::Shape);
+        }
+        let (raw_cap, result_cap) = if n <= 512 {
+            (65_536, 16_384)
+        } else {
+            (4_096, 4_096)
+        };
+        if raw_bits == 0 || result_bits == 0 || raw_bits > raw_cap || result_bits > result_cap {
+            return Err(Error::ResourceLimit);
+        }
+        let mut unique = std::collections::BTreeSet::new();
+        for &p in &self.primes {
+            validate_prime(p)?;
+            if !unique.insert(p) {
+                return Err(Error::DuplicatePrime);
+            }
+        }
+        let reference = self
+            .rejected
+            .iter()
+            .position(|&v| v == 0)
+            .ok_or(Error::ReconstructionPending)?;
+        let permutation = &self.permutations[reference * n..(reference + 1) * n];
+        let mut seen = vec![false; n];
+        for &row in permutation {
+            let index = usize::try_from(row).map_err(|_| Error::Shape)?;
+            if index >= n || seen[index] {
+                return Err(Error::InvalidWitness);
+            }
+            seen[index] = true;
+        }
+        let participating = (0..count)
+            .filter(|&i| {
+                self.rejected[i] == 0 && &self.permutations[i * n..(i + 1) * n] == permutation
+            })
+            .collect::<Vec<_>>();
+        let participating_primes = participating
+            .iter()
+            .map(|&i| self.primes[i])
+            .collect::<Vec<_>>();
+        let plan = CrtPlan::new(&participating_primes, raw_bits)?;
+        let mut packed = Vec::with_capacity(square);
+        for cell in 0..square {
+            let rational = plan.candidate(
+                participating
+                    .iter()
+                    .map(|&i| self.packed[i * square + cell]),
+                result_bits,
+            )?;
+            let value = rational.to_f64().ok_or(Error::NonFinite)?;
+            if !value.is_finite() || (value == 0.0 && !rational.is_zero()) {
+                return Err(Error::InvalidWitness);
+            }
+            packed.push(value);
+        }
+        Ok(CandidateFactors {
+            packed,
+            new_to_original: permutation.iter().map(|&r| r as usize).collect(),
+            participating_primes,
+        })
+    }
+}
+
+pub fn mul_mod(a: u32, b: u32, p: u32) -> u32 {
+    ((u64::from(a) * u64::from(b)) % u64::from(p)) as u32
+}
+pub fn pow_mod(mut a: u32, mut exponent: u32, p: u32) -> u32 {
+    let mut out = 1;
+    while exponent != 0 {
+        if exponent & 1 != 0 {
+            out = mul_mod(out, a, p);
+        }
+        a = mul_mod(a, a, p);
+        exponent >>= 1;
+    }
+    out
+}
+
+/// Deterministic primality for the admitted range p < 2^31.
+pub fn validate_prime(p: u32) -> Result<()> {
+    if p < 3 || p >= 1 << 31 || p & 1 == 0 {
+        return Err(Error::InvalidPrime);
+    }
+    let shift = (p - 1).trailing_zeros();
+    let odd = (p - 1) >> shift;
+    for base in [2, 3, 5, 7, 11] {
+        if base >= p {
+            continue;
+        }
+        let mut x = pow_mod(base, odd, p);
+        if x == 1 || x == p - 1 {
+            continue;
+        }
+        let mut passed = false;
+        for _ in 1..shift {
+            x = mul_mod(x, x, p);
+            if x == p - 1 {
+                passed = true;
+                break;
+            }
+        }
+        if !passed {
+            return Err(Error::InvalidPrime);
+        }
+    }
+    Ok(())
+}
+
+/// IEEE f64 is a signed integer mantissa times an exact power of two.
+/// An odd prime never divides its denominator, including for subnormals.
+pub fn dyadic_residue(value: f64, p: u32) -> Result<u32> {
+    validate_prime(p)?;
+    let bits = value.to_bits();
+    let exponent = ((bits >> 52) & 0x7ff) as i32;
+    if exponent == 0x7ff {
+        return Err(Error::NonFinite);
+    }
+    let mut mantissa = bits & ((1_u64 << 52) - 1);
+    let shift = if exponent == 0 {
+        -1074
+    } else {
+        mantissa |= 1_u64 << 52;
+        exponent - 1075
+    };
+    let mut out = (mantissa % u64::from(p)) as u32;
+    let power = if shift < 0 {
+        pow_mod((p + 1) / 2, (-shift) as u32, p)
+    } else {
+        pow_mod(2, shift as u32, p)
+    };
+    out = mul_mod(out, power, p);
+    if bits >> 63 != 0 && out != 0 {
+        out = p - out;
+    }
+    Ok(out)
+}
+
+fn mod_u32(x: &BigInt, p: u32) -> Result<u32> {
+    let modulus = BigInt::from(p);
+    let mut reduced = x % &modulus;
+    if reduced.is_negative() {
+        reduced += modulus;
+    }
+    reduced.to_u32().ok_or(Error::InvalidWitness)
+}
+
+struct CrtStep {
+    prime: u32,
+    prefix: BigInt,
+    inverse: u32,
+}
+/// Prime validation and prefix inverses are shared across all matrix cells.
+pub struct CrtPlan {
+    steps: Vec<CrtStep>,
+    modulus: BigInt,
+    raw_bits: u64,
+}
+impl CrtPlan {
+    pub fn new(primes: &[u32], raw_bits: u64) -> Result<Self> {
+        if primes.is_empty() {
+            return Err(Error::ReconstructionPending);
+        }
+        if primes.len() > 4_096 || raw_bits == 0 || raw_bits > 131_072 {
+            return Err(Error::ResourceLimit);
+        }
+        let mut unique = std::collections::BTreeSet::new();
+        let mut modulus = BigInt::one();
+        let mut steps = Vec::with_capacity(primes.len());
+        for &prime in primes {
+            validate_prime(prime)?;
+            if !unique.insert(prime) {
+                return Err(Error::DuplicatePrime);
+            }
+            if modulus.bits() + u64::from(32 - prime.leading_zeros()) > raw_bits {
+                return Err(Error::ResourceLimit);
+            }
+            steps.push(CrtStep {
+                prime,
+                prefix: modulus.clone(),
+                inverse: pow_mod(mod_u32(&modulus, prime)?, prime - 2, prime),
+            });
+            modulus *= prime;
+        }
+        Ok(Self {
+            steps,
+            modulus,
+            raw_bits,
+        })
+    }
+    pub fn candidate(
+        &self,
+        residues: impl IntoIterator<Item = u32>,
+        result_bits: u64,
+    ) -> Result<BigRational> {
+        let mut input = residues.into_iter();
+        let mut value = BigInt::zero();
+        for step in &self.steps {
+            let residue = input.next().ok_or(Error::Shape)?;
+            if residue >= step.prime {
+                return Err(Error::InvalidWitness);
+            }
+            let current = mod_u32(&value, step.prime)?;
+            let difference = ((u64::from(residue) + u64::from(step.prime) - u64::from(current))
+                % u64::from(step.prime)) as u32;
+            value += &step.prefix * BigInt::from(mul_mod(difference, step.inverse, step.prime));
+        }
+        if input.next().is_some() {
+            return Err(Error::Shape);
+        }
+        Reconstruction {
+            residue: value,
+            modulus: self.modulus.clone(),
+            primes: vec![self.steps[0].prime],
+            max_modulus_bits: self.raw_bits,
+        }
+        .candidate(result_bits)
+    }
+}
+
+#[derive(Clone, Debug)]
+pub struct Reconstruction {
+    residue: BigInt,
+    modulus: BigInt,
+    primes: Vec<u32>,
+    max_modulus_bits: u64,
+}
+impl Reconstruction {
+    pub fn new(max_modulus_bits: u64) -> Result<Self> {
+        if max_modulus_bits == 0 || max_modulus_bits > 131_072 {
+            return Err(Error::ResourceLimit);
+        }
+        Ok(Self {
+            residue: BigInt::zero(),
+            modulus: BigInt::one(),
+            primes: Vec::new(),
+            max_modulus_bits,
+        })
+    }
+    pub fn append(&mut self, residue: u32, prime: u32) -> Result<()> {
+        validate_prime(prime)?;
+        if residue >= prime {
+            return Err(Error::InvalidWitness);
+        }
+        if self.primes.contains(&prime) {
+            return Err(Error::DuplicatePrime);
+        }
+        if self.modulus.bits() + u64::from(32 - prime.leading_zeros()) > self.max_modulus_bits {
+            return Err(Error::ResourceLimit);
+        }
+        let modulus = mod_u32(&self.modulus, prime)?;
+        let current = mod_u32(&self.residue, prime)?;
+        let difference = ((u64::from(residue) + u64::from(prime) - u64::from(current))
+            % u64::from(prime)) as u32;
+        let correction = mul_mod(difference, pow_mod(modulus, prime - 2, prime), prime);
+        self.residue += &self.modulus * BigInt::from(correction);
+        self.modulus *= prime;
+        self.primes.push(prime);
+        Ok(())
+    }
+
+    /// Unique only inside this modulus-dependent rectangle. A candidate is
+    /// never asserted to be the original rational without a witness check.
+    pub fn candidate(&self, max_result_bits: u64) -> Result<BigRational> {
+        if max_result_bits == 0 || max_result_bits > 16_384 {
+            return Err(Error::ResourceLimit);
+        }
+        if self.primes.is_empty() {
+            return Err(Error::ReconstructionPending);
+        }
+        if self.residue.is_zero() {
+            return Ok(BigRational::zero());
+        }
+        let bound = ((&self.modulus - 1_u32) / 2_u32).sqrt();
+        let (mut old_r, mut r) = (self.modulus.clone(), self.residue.clone());
+        let (mut old_t, mut t) = (BigInt::zero(), BigInt::one());
+        while r.abs() > bound {
+            let quotient = &old_r / &r;
+            let next_r = old_r - &quotient * &r;
+            let next_t = old_t - quotient * &t;
+            old_r = r;
+            r = next_r;
+            old_t = t;
+            t = next_t;
+        }
+        if t.is_zero() || t.abs() > bound {
+            return Err(Error::ReconstructionPending);
+        }
+        let candidate = BigRational::new(r, t);
+        if candidate.numer().bits() > max_result_bits || candidate.denom().bits() > max_result_bits
+        {
+            return Err(Error::ResourceLimit);
+        }
+        if (candidate.numer() - &self.residue * candidate.denom()) % &self.modulus != BigInt::zero()
+        {
+            return Err(Error::ReconstructionPending);
+        }
+        Ok(candidate)
+    }
+}
+
+/// The same stored dyadic matrix and right-hand side, not rounded LU factors.
+pub fn verify_solution(matrix: &[f64], n: usize, rhs: &[f64], x: &[BigRational]) -> Result<()> {
+    if n == 0
+        || n > 1_040
+        || matrix.len() != n.checked_mul(n).ok_or(Error::Shape)?
+        || rhs.len() != n
+        || x.len() != n
+    {
+        return Err(Error::Shape);
+    }
+    let (raw_cap, result_cap) = if n <= 512 {
+        (65_536, 16_384)
+    } else {
+        (4_096, 4_096)
+    };
+    fn gcd(mut a: BigInt, mut b: BigInt) -> BigInt {
+        while !b.is_zero() {
+            let remainder = &a % &b;
+            a = b;
+            b = remainder;
+        }
+        a.abs()
+    }
+    fn bounded_product(a: &BigInt, b: &BigInt, cap: u64) -> Result<BigInt> {
+        if !a.is_zero() && !b.is_zero() && a.bits().saturating_add(b.bits()) > cap {
+            return Err(Error::ResourceLimit);
+        }
+        Ok(a * b)
+    }
+    // Reuse a common denominator instead of performing an expensive normalized
+    // rational reduction after every matrix term. This is a witness, not a solver.
+    let mut common = BigInt::one();
+    for value in x {
+        if value.denom() <= &BigInt::zero() {
+            return Err(Error::InvalidWitness);
+        }
+        if value.numer().bits() > result_cap || value.denom().bits() > result_cap {
+            return Err(Error::ResourceLimit);
+        }
+        let divisor = gcd(common.clone(), value.denom().clone());
+        common = bounded_product(&(&common / divisor), value.denom(), raw_cap)?;
+    }
+    let numerators = x
+        .iter()
+        .map(|value| bounded_product(value.numer(), &(&common / value.denom()), raw_cap))
+        .collect::<Result<Vec<_>>>()?;
+    for r in 0..n {
+        let target = BigRational::from_float(rhs[r]).ok_or(Error::NonFinite)?;
+        let coefficients = matrix[r * n..(r + 1) * n]
+            .iter()
+            .map(|&v| BigRational::from_float(v).ok_or(Error::NonFinite))
+            .collect::<Result<Vec<_>>>()?;
+        let scale = coefficients
+            .iter()
+            .map(BigRational::denom)
+            .chain(std::iter::once(target.denom()))
+            .max()
+            .ok_or(Error::Shape)?;
+        let mut actual = BigInt::zero();
+        for c in 0..n {
+            let coefficient = &coefficients[c];
+            if !coefficient.is_zero() {
+                let scaled =
+                    bounded_product(coefficient.numer(), &(scale / coefficient.denom()), raw_cap)?;
+                let term = bounded_product(&scaled, &numerators[c], raw_cap)?;
+                if actual.bits().max(term.bits()).saturating_add(1) > raw_cap {
+                    return Err(Error::ResourceLimit);
+                }
+                actual += term;
+            }
+        }
+        let target = bounded_product(
+            &bounded_product(target.numer(), &(scale / target.denom()), raw_cap)?,
+            &common,
+            raw_cap,
+        )?;
+        if actual != target {
+            return Err(Error::InvalidWitness);
+        }
+    }
+    Ok(())
+}
