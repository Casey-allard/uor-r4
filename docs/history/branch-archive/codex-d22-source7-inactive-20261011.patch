+//! Device-resident modular LU and triangular solves. No CPU elimination fallback.
+#![allow(unsafe_code)]
+use crate::{validate_prime, verify_solution, CrtPlan, Error, FactorResidues, Result};
+use cudarc::driver::{CudaContext, CudaModule, CudaSlice, CudaStream, LaunchConfig, PushKernelArg};
+use num_rational::BigRational;
+use std::sync::Arc;
+
+const MAX_CELLS: usize = 64 * 1024 * 1024;
+const SOURCE: &str = include_str!("exact_modular.cu");
+fn device_error(e: impl std::fmt::Display) -> Error {
+    Error::Device(e.to_string())
+}
+
+pub struct DeviceNumerics {
+    context: Arc<CudaContext>,
+    stream: Arc<CudaStream>,
+    module: Arc<CudaModule>,
+}
+pub struct ModularFactors {
+    stream: Arc<CudaStream>,
+    module: Arc<CudaModule>,
+    n: usize,
+    original: Vec<f64>,
+    primes: Vec<u32>,
+    primes_device: CudaSlice<u32>,
+    packed: CudaSlice<u32>,
+    permutations: CudaSlice<u32>,
+    rejected: CudaSlice<u32>,
+}
+impl DeviceNumerics {
+    pub fn new(ordinal: usize) -> Result<Self> {
+        let context = CudaContext::new(ordinal).map_err(device_error)?;
+        let stream = context.default_stream();
+        let ptx = cudarc::nvrtc::compile_ptx_with_opts(
+            SOURCE,
+            cudarc::nvrtc::CompileOptions {
+                use_fast_math: Some(false),
+                name: Some("d22_exact_modular.cu".into()),
+                ..Default::default()
+            },
+        )
+        .map_err(device_error)?;
+        let module = context.load_module(ptx).map_err(device_error)?;
+        Ok(Self {
+            context,
+            stream,
+            module,
+        })
+    }
+
+    pub fn factor(&self, matrix: &[f64], n: usize, primes: &[u32]) -> Result<ModularFactors> {
+        let square = n.checked_mul(n).ok_or(Error::Shape)?;
+        let cells = square
+            .checked_mul(primes.len())
+            .ok_or(Error::ResourceLimit)?;
+        if n == 0
+            || n > 1_040
+            || matrix.len() != square
+            || primes.is_empty()
+            || primes.len() > 4_096
+            || cells > MAX_CELLS
+        {
+            return Err(Error::Shape);
+        }
+        if matrix.iter().any(|x| !x.is_finite()) {
+            return Err(Error::NonFinite);
+        }
+        let mut unique = std::collections::BTreeSet::new();
+        for &p in primes {
+            validate_prime(p)?;
+            if !unique.insert(p) {
+                return Err(Error::DuplicatePrime);
+            }
+        }
+        let bit_patterns = matrix.iter().map(|x| x.to_bits()).collect::<Vec<_>>();
+        let bits = self
+            .stream
+            .clone_htod(&bit_patterns)
+            .map_err(device_error)?;
+        let primes_device = self.stream.clone_htod(primes).map_err(device_error)?;
+        let mut packed = self
+            .stream
+            .alloc_zeros::<u32>(cells)
+            .map_err(device_error)?;
+        let mut permutations = self
+            .stream
+            .alloc_zeros::<u32>(n * primes.len())
+            .map_err(device_error)?;
+        let mut rejected = self
+            .stream
+            .alloc_zeros::<u32>(primes.len())
+            .map_err(device_error)?;
+        let initialize = self
+            .module
+            .load_function("initialize")
+            .map_err(device_error)?;
+        let eliminate = self
+            .module
+            .load_function("eliminate_column")
+            .map_err(device_error)?;
+        let width = n as u32;
+        let config = LaunchConfig {
+            grid_dim: (primes.len() as u32, 1, 1),
+            block_dim: (256, 1, 1),
+            shared_mem_bytes: 0,
+        };
+        let mut launch = self.stream.launch_builder(&initialize);
+        launch
+            .arg(&bits)
+            .arg(&primes_device)
+            .arg(&mut packed)
+            .arg(&mut permutations)
+            .arg(&width);
+        // SAFETY: one block owns one admitted n*n matrix and n permutation entries.
+        unsafe { launch.launch(config) }.map_err(device_error)?;
+        for column in 0..width {
+            let mut launch = self.stream.launch_builder(&eliminate);
+            launch
+                .arg(&mut packed)
+                .arg(&primes_device)
+                .arg(&mut permutations)
+                .arg(&mut rejected)
+                .arg(&width)
+                .arg(&column);
+            // SAFETY: stream order completes each column before the next; bounds
+            // above cover all block-owned entries and the fixed shared workspace.
+            unsafe { launch.launch(config) }.map_err(device_error)?;
+        }
+        self.context.bind_to_thread().map_err(device_error)?;
+        Ok(ModularFactors {
+            stream: self.stream.clone(),
+            module: self.module.clone(),
+            n,
+            original: matrix.to_vec(),
+            primes: primes.to_vec(),
+            primes_device,
+            packed,
+            permutations,
+            rejected,
+        })
+    }
+}
+impl ModularFactors {
+    pub fn factor_residues(&self) -> Result<FactorResidues> {
+        Ok(FactorResidues {
+            n: self.n,
+            primes: self.primes.clone(),
+            packed: self.stream.clone_dtoh(&self.packed).map_err(device_error)?,
+            permutations: self
+                .stream
+                .clone_dtoh(&self.permutations)
+                .map_err(device_error)?,
+            rejected: self
+                .stream
+                .clone_dtoh(&self.rejected)
+                .map_err(device_error)?,
+        })
+    }
+
+    pub fn solve_exact(
+        &self,
+        rhs: &[f64],
+        raw_bits: u64,
+        result_bits: u64,
+    ) -> Result<Vec<BigRational>> {
+        if rhs.len() != self.n {
+            return Err(Error::Shape);
+        }
+        if rhs.iter().any(|x| !x.is_finite()) {
+            return Err(Error::NonFinite);
+        }
+        let (raw_cap, result_cap) = if self.n <= 512 {
+            (65_536, 16_384)
+        } else {
+            (4_096, 4_096)
+        };
+        if raw_bits == 0 || result_bits == 0 || raw_bits > raw_cap || result_bits > result_cap {
+            return Err(Error::ResourceLimit);
+        }
+        let rhs_bits = rhs.iter().map(|x| x.to_bits()).collect::<Vec<_>>();
+        let input = self.stream.clone_htod(&rhs_bits).map_err(device_error)?;
+        let mut output = self
+            .stream
+            .alloc_zeros::<u32>(self.n * self.primes.len())
+            .map_err(device_error)?;
+        let solve = self
+            .module
+            .load_function("solve_rhs")
+            .map_err(device_error)?;
+        let width = self.n as u32;
+        let mut launch = self.stream.launch_builder(&solve);
+        launch
+            .arg(&self.packed)
+            .arg(&self.primes_device)
+            .arg(&self.permutations)
+            .arg(&self.rejected)
+            .arg(&input)
+            .arg(&mut output)
+            .arg(&width);
+        // SAFETY: admitted buffers have one n-entry result per prime; the kernel
+        // skips every rejected modular factorization, and reads exactly n RHS bits.
+        unsafe {
+            launch.launch(LaunchConfig {
+                grid_dim: (self.primes.len() as u32, 1, 1),
+                block_dim: (256, 1, 1),
+                shared_mem_bytes: 0,
+            })
+        }
+        .map_err(device_error)?;
+        let residues = self.stream.clone_dtoh(&output).map_err(device_error)?;
+        let rejected = self
+            .stream
+            .clone_dtoh(&self.rejected)
+            .map_err(device_error)?;
+        let good = (0..self.primes.len())
+            .filter(|&i| rejected[i] == 0)
+            .collect::<Vec<_>>();
+        let primes = good.iter().map(|&i| self.primes[i]).collect::<Vec<_>>();
+        let plan = CrtPlan::new(&primes, raw_bits)?;
+        let mut values = Vec::with_capacity(self.n);
+        for c in 0..self.n {
+            values
+                .push(plan.candidate(good.iter().map(|&i| residues[i * self.n + c]), result_bits)?);
+        }
+        // A modular candidate alone is never an exact solve or a singularity proof.
+        verify_solution(&self.original, self.n, rhs, &values)?;
+        Ok(values)
+    }
+}
