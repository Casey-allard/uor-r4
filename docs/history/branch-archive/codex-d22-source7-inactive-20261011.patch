+// Offline numerical kernel. Every block owns a separate prime-field matrix.
+__device__ unsigned product(unsigned a, unsigned b, unsigned p) {
+    return (unsigned)(((unsigned long long)a * b) % p);
+}
+__device__ unsigned power(unsigned a, unsigned e, unsigned p) {
+    unsigned x = 1;
+    while (e) {
+        if (e & 1) x = product(x, a, p);
+        a = product(a, a, p);
+        e >>= 1;
+    }
+    return x;
+}
+__device__ unsigned subtract(unsigned a, unsigned b, unsigned p) {
+    return a >= b ? a - b : p - (b - a);
+}
+__device__ unsigned dyadic(unsigned long long bits, unsigned p) {
+    int exponent = (int)((bits >> 52) & 2047);
+    unsigned long long mantissa = bits & ((1ull << 52) - 1);
+    int shift = -1074;
+    if (exponent) {
+        mantissa |= 1ull << 52;
+        shift = exponent - 1075;
+    }
+    unsigned a = (unsigned)(mantissa % p);
+    unsigned scale = shift < 0 ? power((p + 1) / 2, (unsigned)-shift, p)
+                              : power(2, (unsigned)shift, p);
+    a = product(a, scale, p);
+    return (bits >> 63) && a ? p - a : a;
+}
+extern "C" __global__ void initialize(const unsigned long long *bits,
+    const unsigned *primes, unsigned *packed, unsigned *permutation, unsigned n) {
+    unsigned index = blockIdx.x, p = primes[index];
+    unsigned *a = packed + (unsigned long long)index * n * n;
+    for (unsigned i = threadIdx.x; i < n * n; i += blockDim.x) a[i] = dyadic(bits[i], p);
+    for (unsigned i = threadIdx.x; i < n; i += blockDim.x) permutation[index * n + i] = i;
+}
+extern "C" __global__ void eliminate_column(unsigned *packed, const unsigned *primes,
+    unsigned *permutation, unsigned *rejected, unsigned n, unsigned k) {
+    unsigned index = blockIdx.x, p = primes[index];
+    if (rejected[index]) return;
+    unsigned *a = packed + (unsigned long long)index * n * n;
+    unsigned *perm = permutation + index * n;
+    __shared__ unsigned selected, inverse, multipliers[1040];
+    if (threadIdx.x == 0) {
+        selected = n;
+        for (unsigned r = k; r < n; ++r) {
+            if (a[r * n + k]) { selected = r; break; }
+        }
+        if (selected == n) rejected[index] = 1;
+        else {
+            inverse = power(a[selected * n + k], p - 2, p);
+            unsigned old = perm[k]; perm[k] = perm[selected]; perm[selected] = old;
+        }
+    }
+    __syncthreads();
+    if (selected == n) return;
+    if (selected != k) {
+        for (unsigned c = threadIdx.x; c < n; c += blockDim.x) {
+            unsigned old = a[k * n + c];
+            a[k * n + c] = a[selected * n + c];
+            a[selected * n + c] = old;
+        }
+    }
+    __syncthreads();
+    for (unsigned r = k + 1 + threadIdx.x; r < n; r += blockDim.x)
+        multipliers[r] = product(a[r * n + k], inverse, p);
+    __syncthreads();
+    // All multipliers are retained before any lower-column cell is overwritten.
+    for (unsigned i = threadIdx.x; i < n * n; i += blockDim.x) {
+        unsigned r = i / n, c = i % n;
+        if (r > k && c > k)
+            a[i] = subtract(a[i], product(multipliers[r], a[k * n + c], p), p);
+        else if (r > k && c == k) a[i] = multipliers[r];
+    }
+}
+extern "C" __global__ void solve_rhs(const unsigned *packed, const unsigned *primes,
+    const unsigned *permutation, const unsigned *rejected, const unsigned long long *rhs,
+    unsigned *output, unsigned n) {
+    unsigned index = blockIdx.x, p = primes[index];
+    if (rejected[index]) return;
+    const unsigned *a = packed + (unsigned long long)index * n * n;
+    __shared__ unsigned x[1040];
+    for (unsigned r = threadIdx.x; r < n; r += blockDim.x)
+        x[r] = dyadic(rhs[permutation[index * n + r]], p);
+    __syncthreads();
+    for (unsigned k = 0; k < n; ++k) {
+        for (unsigned r = k + 1 + threadIdx.x; r < n; r += blockDim.x)
+            x[r] = subtract(x[r], product(a[r * n + k], x[k], p), p);
+        __syncthreads();
+    }
+    for (unsigned step = 0; step < n; ++step) {
+        unsigned k = n - 1 - step;
+        if (threadIdx.x == 0) x[k] = product(x[k], power(a[k * n + k], p - 2, p), p);
+        __syncthreads();
+        for (unsigned r = threadIdx.x; r < k; r += blockDim.x)
+            x[r] = subtract(x[r], product(a[r * n + k], x[k], p), p);
+        __syncthreads();
+    }
+    for (unsigned r = threadIdx.x; r < n; r += blockDim.x) output[index * n + r] = x[r];
+}
