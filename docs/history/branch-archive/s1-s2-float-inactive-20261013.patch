+    /// M2 control 2: under `Paired`, the even (left) heads are bit-identical
+    /// to `Left` mode.
+    #[test]
+    #[cfg_attr(not(feature = "cuda"), ignore = "GPU control: runs on the CUDA pod")]
+    fn murm_left_heads_unchanged() -> Result<()> {
+        let device = cuda()?;
+        let (cells, resets) = mixed_cells()?;
+        let f = fixture(&device, &cells, 2, &resets)?;
+        let s = spec(7, 2);
+        let coupling = Tensor::new(&[0.6f32, -0.9], &device)?;
+        let selection = murmuration_select(&s, 2, &f.address, &f.norm, &f.reset)?;
+        let read = |c: Chirality| -> Result<Vec<Vec<Vec<f32>>>> {
+            Ok(murmuration_read(
+                &s,
+                &MurmurationInputs {
+                    address: &f.address,
+                    address_norm: &f.norm,
+                    value: &f.value,
+                    coupling: &coupling,
+                    selection: &selection,
+                    heads: 2,
+                    chirality: c,
+                },
+                false,
+                None,
+            )?
+            .delta
+            .to_vec3()?)
+        };
+        let (left, paired) = (read(Chirality::Left)?, read(Chirality::Paired)?);
+        for r in (0..cells.len()).step_by(2) {
+            for t in 0..cells[0].len() {
+                for i in 0..4 {
+                    assert_eq!(left[r][t][i].to_bits(), paired[r][t][i].to_bits());
+                }
+            }
+        }
+        // And the odd (right) heads genuinely differ somewhere.
+        assert!((1..cells.len()).step_by(2).any(|r| left[r] != paired[r]));
+        Ok(())
+    }
+
+    /// M2 control 3: right heads match an independent device reference that
+    /// forms `h = conj(c_j) (x) c_t` by direct f32 products and applies it on
+    /// the right, `v (x) h` (not the table).
+    #[test]
+    #[cfg_attr(not(feature = "cuda"), ignore = "GPU control: runs on the CUDA pod")]
+    fn murm_right_forward_independent_reference() -> Result<()> {
+        let device = cuda()?;
+        let (cells, resets) = mixed_cells()?;
+        let f = fixture(&device, &cells, 2, &resets)?;
+        let s = spec(7, 2);
+        let sel = selection_spec(&s)?;
+        let coupling = Tensor::new(&[0.75f32, -1.25], &device)?;
+        let selection = murmuration_select(&s, 2, &f.address, &f.norm, &f.reset)?;
+        let out = murmuration_read(
+            &s,
+            &MurmurationInputs {
+                address: &f.address,
+                address_norm: &f.norm,
+                value: &f.value,
+                coupling: &coupling,
+                selection: &selection,
+                heads: 2,
+                chirality: Chirality::Paired,
+            },
+            false,
+            None,
+        )?;
+        let picks: Vec<Vec<Vec<u32>>> = selection.to_vec3()?;
+        let roots = Tensor::from_vec(geometry()?.0, (CELLS, 4), &device)?;
+        let conj = Tensor::new(&[1f32, -1.0, -1.0, -1.0], &device)?;
+        let time = cells[0].len();
+        let k_h = coupling.narrow(0, 1, 1)?;
+        for r in (1..cells.len()).step_by(2) {
+            for t in 0..time {
+                let v_t = f.value.narrow(0, r, 1)?.narrow(1, t, 1)?.reshape(4)?;
+                let c_t = roots
+                    .narrow(0, picks[r][t][sel.slots()] as usize, 1)?
+                    .reshape(4)?;
+                let mut sum = Tensor::zeros(4, DType::F32, &device)?;
+                let mut count = 0usize;
+                for &j in &picks[r][t][..s.kept + 1] {
+                    if count == s.kept {
+                        break;
+                    }
+                    if j == ABSENT || j as usize >= t {
+                        continue;
+                    }
+                    let c_j = roots
+                        .narrow(0, picks[r][j as usize][sel.slots() + 1] as usize, 1)?
+                        .reshape(4)?;
+                    let h = hamilton(&c_j.mul(&conj)?, &c_t)?;
+                    let v_j = f
+                        .value
+                        .narrow(0, r, 1)?
+                        .narrow(1, j as usize, 1)?
+                        .reshape(4)?;
+                    sum = sum.add(&hamilton(&v_j, &h)?)?;
+                    count += 1;
+                }
+                let want = if count == 0 {
+                    Tensor::zeros(4, DType::F32, &device)?
+                } else {
+                    sum.affine(1.0 / count as f64, 0.0)?
+                        .sub(&v_t)?
+                        .broadcast_mul(&k_h)?
+                };
+                let got = out.delta.narrow(0, r, 1)?.narrow(1, t, 1)?.reshape(4)?;
+                let worst = got.sub(&want)?.abs()?.max(0)?.to_scalar::<f32>()?;
+                assert!(worst <= 1e-6, "row {r} t {t}: right head off by {worst}");
+            }
+        }
+        Ok(())
+    }
+
+    /// M2 control 4: right-head value and coupling gradients against device
+    /// central secants (same convention as control 5).
+    #[test]
+    #[cfg_attr(not(feature = "cuda"), ignore = "GPU control: runs on the CUDA pod")]
+    fn murm_right_backward_secants() -> Result<()> {
+        let device = cuda()?;
+        let (cells, resets) = mixed_cells()?;
+        let f = fixture(&device, &cells, 2, &resets)?;
+        let s = spec(7, 2);
+        let (rows, time) = (cells.len(), cells[0].len());
+        let selection = murmuration_select(&s, 2, &f.address, &f.norm, &f.reset)?;
+        // Weight only the right (odd) rows.
+        let weights = Tensor::from_vec(
+            (0..rows * time * 4)
+                .map(|i| {
+                    if (i / (time * 4)) % 2 == 1 {
+                        ((i * 29 % 23) as f32 / 23.0) - 0.5
+                    } else {
+                        0.0
+                    }
+                })
+                .collect::<Vec<_>>(),
+            (rows, time, 4),
+            &device,
+        )?;
+        let delta_of = |v: &Tensor, k: &Tensor| -> Result<Tensor> {
+            Ok(murmuration_read(
+                &s,
+                &MurmurationInputs {
+                    address: &f.address,
+                    address_norm: &f.norm,
+                    value: v,
+                    coupling: k,
+                    selection: &selection,
+                    heads: 2,
+                    chirality: Chirality::Paired,
+                },
+                false,
+                None,
+            )?
+            .delta)
+        };
+        let value = Var::from_tensor(&f.value)?;
+        let coupling = Var::from_tensor(&Tensor::new(&[0.8f32, -0.6], &device)?)?;
+        let grads = delta_of(value.as_tensor(), coupling.as_tensor())?
+            .mul(&weights)?
+            .sum_all()?
+            .backward()?;
+        let gv = grads
+            .get(value.as_tensor())
+            .ok_or_else(|| invalid("no value gradient"))?
+            .flatten_all()?
+            .to_vec1::<f32>()?;
+        let gk = grads
+            .get(coupling.as_tensor())
+            .ok_or_else(|| invalid("no coupling gradient"))?
+            .to_vec1::<f32>()?;
+        let h = 1e-3f64;
+        let n = rows * time * 4;
+        // Elements of the right rows (rows 1 and 3).
+        for idx in [
+            time * 4 + 3,
+            time * 4 + 21,
+            3 * time * 4 + 10,
+            3 * time * 4 + 47,
+        ] {
+            let bump = |sign: f64| -> Result<Tensor> {
+                let e = Tensor::from_vec(
+                    (0..n)
+                        .map(|i| if i == idx { (sign * h) as f32 } else { 0.0 })
+                        .collect::<Vec<_>>(),
+                    (rows, time, 4),
+                    &device,
+                )?;
+                delta_of(&f.value.add(&e)?, coupling.as_tensor())
+            };
+            check_device_secant(
+                gv[idx],
+                &bump(1.0)?,
+                &bump(-1.0)?,
+                &weights,
+                h,
+                &format!("value[{idx}]"),
+            )?;
+        }
+        let bump = |sign: f64| -> Result<Tensor> {
+            let e = Tensor::new(&[0.0f32, (sign * h) as f32], &device)?;
+            delta_of(&f.value, &coupling.as_tensor().add(&e)?)
+        };
+        check_device_secant(
+            gk[1],
+            &bump(1.0)?,
+            &bump(-1.0)?,
+            &weights,
+            h,
+            "coupling[right head]",
+        )?;
+        Ok(())
+    }
+
+    /// Fix 1 control (Codex 6152388126): address-null keys are excluded before
+    /// insertion and ranking. Ring depth 3 in one cell, tokens t0..t4 at the
+    /// same vertex with t2 and t3 address-null: the reader t4 keeps t4 (self),
+    /// t1, t0, because the nulls neither occupied the ring nor evicted t0/t1.
+    /// (Had the nulls been stored, the ring would hold t2, t3, t4.) Positions
+    /// are the original token positions; the BOS reset is preserved.
+    #[test]
+    #[cfg_attr(not(feature = "cuda"), ignore = "GPU control: runs on the CUDA pod")]
+    fn murm_null_keys_never_stored() -> Result<()> {
+        let device = cuda()?;
+        let a = 30usize;
+        let f = fixture(&device, &[vec![a, a, a, a, a, a]], 1, &[vec![0, 5]])?;
+        let norm = Tensor::new(&[[1f32, 1.0, 0.0, 0.0, 1.0, 1.0]], &device)?;
+        let s = NativeStarling {
+            depth: 3,
+            ..spec(2, 0)
+        };
+        let sel = selection_spec(&s)?;
+        let selection = murmuration_select(&s, 1, &f.address, &norm, &f.reset)?;
+        let picks: Vec<Vec<Vec<u32>>> = selection.to_vec3()?;
+        assert_eq!(picks[0][4][..sel.kept].to_vec(), vec![4, 1, 0]);
+        for t in 0..6 {
+            for &j in &picks[0][t][..sel.slots()] {
+                assert!(j != 2 && j != 3, "t {t} ranked an address-null key {j}");
+            }
+        }
+        assert_eq!(picks[0][2][sel.slots() + 1], ABSENT);
+        assert_eq!(picks[0][3][sel.slots() + 1], ABSENT);
+        // The BOS at 5 still clears the rings: t5 sees only itself.
+        assert_eq!(picks[0][5][..sel.kept].to_vec(), vec![5, ABSENT, ABSENT]);
+        let out = murmuration_read(
+            &s,
+            &MurmurationInputs {
+                address: &f.address,
+                address_norm: &norm,
+                value: &f.value,
+                coupling: &Tensor::new(&[1f32], &device)?,
+                selection: &selection,
+                heads: 1,
+                chirality: Chirality::Left,
+            },
+            false,
+            None,
+        )?;
+        let flock = out.flock.to_vec2::<f32>()?;
+        assert_eq!(flock[0][4], 2.0);
+        assert_eq!(flock[0][5], 0.0);
+        Ok(())
+    }
+
+    /// Fix 2 control: NaN or infinity in values, norms or couplings is refused
+    /// before arithmetic (masking would not remove it), in selection and read.
+    #[test]
+    #[cfg_attr(not(feature = "cuda"), ignore = "GPU control: runs on the CUDA pod")]
+    fn murm_nonfinite_refused() -> Result<()> {
+        let device = cuda()?;
+        let (cells, resets) = mixed_cells()?;
+        let f = fixture(&device, &cells, 2, &resets)?;
+        let s = spec(7, 2);
+        let (rows, time) = (cells.len(), cells[0].len());
+        let selection = murmuration_select(&s, 2, &f.address, &f.norm, &f.reset)?;
+        let poke = |x: &Tensor, at: usize, bad: f32| -> Result<Tensor> {
+            let n = x.elem_count();
+            let mask: Vec<f32> = (0..n).map(|i| if i == at { bad } else { 0.0 }).collect();
+            Ok(x.add(&Tensor::from_vec(mask, x.shape(), &device)?)?)
+        };
+        let read = |v: &Tensor, n: &Tensor, k: &Tensor| {
+            murmuration_read(
+                &s,
+                &MurmurationInputs {
+                    address: &f.address,
+                    address_norm: n,
+                    value: v,
+                    coupling: k,
+                    selection: &selection,
+                    heads: 2,
+                    chirality: Chirality::Paired,
+                },
+                false,
+                None,
+            )
+        };
+        let k = Tensor::new(&[0.5f32, 0.0], &device)?; // includes a K = 0 head
+        assert!(read(&f.value, &f.norm, &k).is_ok());
+        // Position 0 has an empty flock: a NaN there must still be refused.
+        assert!(read(&poke(&f.value, 0, f32::NAN)?, &f.norm, &k).is_err());
+        assert!(read(&poke(&f.value, 4 * time + 9, f32::INFINITY)?, &f.norm, &k).is_err());
+        assert!(read(&f.value, &poke(&f.norm, rows * time - 1, f32::NAN)?, &k).is_err());
+        assert!(read(&f.value, &f.norm, &poke(&k, 1, f32::NAN)?).is_err());
+        assert!(
+            murmuration_select(&s, 2, &f.address, &poke(&f.norm, 3, f32::NAN)?, &f.reset).is_err()
+        );
+        Ok(())
+    }
+}
diff --git a/crates/uor-r4-training/src/starling_native/murmuration_composed.rs b/crates/uor-r4-training/src/starling_native/murmuration_composed.rs
new file mode 100644
index 000000000..756ca8cad
--- /dev/null
+++ b/crates/uor-r4-training/src/starling_native/murmuration_composed.rs
@@ -0,0 +1,510 @@
+//! M1 control 7: actual FBS A/value/P, S1 and one native vector writer.
+//! This is a CUDA fixture, not training or a CPU reference. The detached
+//! writer table is constructed once per explicitly declared K1/K0 regime.
+//! The K1 credit-on/off comparison uses the identical fixed table. K0 is a
+//! separate fixed-objective wake-up control, not a cross-table loss comparison.
+//! FBS query gradients are the production geometric secant surrogate, not
+//! derivatives of its discontinuous hard routes. No FBS secant bar is added.
+
+use super::murmuration::{
+    murmuration_read, selection_spec, AddressSink, Chirality, MurmurationInputs,
+};
+use super::{geometry, unit_address, Credit, NativeStarling, CELLS};
+use crate::native_vector_writer::{NativeVectorWriter, WriterSpec};
+use crate::spiralcore_fbs::ProjectionPlan;
+use crate::{invalid, Result};
+use candle_core::{DType, Device, Tensor, Var};
+use std::sync::{Arc, Mutex};
+
+const TIME: usize = 4;
+const WIDTH: usize = 16;
+const HEADS: usize = 4;
+const TARGET: u32 = 511;
+
+// One integration seam: the repaired selector excludes null tokens before
+// storage/ranking and internally provisions the K+1 selection window.
+fn selection(
+    spec: &NativeStarling,
+    address: &Tensor,
+    norm: &Tensor,
+    reset: &Tensor,
+) -> Result<Tensor> {
+    super::murmuration::murmuration_select(spec, HEADS, address, norm, reset)
+}
+
+fn near(a: &Tensor, b: &Tensor, tolerance: f64, label: &str) -> Result<()> {
+    let worst = a.sub(b)?.abs()?.max_all()?.to_scalar::<f32>()?;
+    assert!(
+        worst.is_finite() && f64::from(worst) <= tolerance,
+        "{label}: CUDA maximum error {worst}"
+    );
+    Ok(())
+}
+
+fn finite_nonzero(t: &Tensor, label: &str) -> Result<()> {
+    assert!(t.device().is_cuda(), "{label} left CUDA");
+    let size = t.abs()?.sum_all()?.to_scalar::<f32>()?;
+    assert!(size.is_finite() && size > 1e-7, "{label}: {size}");
+    Ok(())
+}
+
+fn gradient(grads: &candle_core::backprop::GradStore, var: &Var) -> Result<Tensor> {
+    match grads.get(var.as_tensor()) {
+        Some(t) => Ok(t.clone()),
+        // A is disconnected with capture disabled. This is the mathematical
+        // zero of that declared absence, never a substitute model output.
+        None => Ok(var.as_tensor().zeros_like()?),
+    }
+}
+
+struct Parameters {
+    a: Var,
+    value: Var,
+    p: Var,
+    coupling: Var,
+}
+impl Parameters {
+    fn new(a: &Arc<ProjectionPlan>, p: &Arc<ProjectionPlan>, k: f32, d: &Device) -> Result<Self> {
+        let points = |plan: &Arc<ProjectionPlan>, index: usize| -> Result<Var> {
+            let root = plan.geometry.roots[index].map(f32::from);
+            Ok(Var::from_vec(
+                root.into_iter()
+                    .cycle()
+                    .take(plan.query_shape().iter().product())
+                    .collect(),
+                &plan.query_shape()[..],
+                d,
+            )?)
+        };
+        Ok(Self {
+            a: points(a, 0)?,
+            value: points(a, 1)?,
+            p: points(p, 0)?,
+            coupling: Var::from_vec(vec![k, k, 2. * k, 2. * k], HEADS, d)?,
+        })
+    }
+}
+
+struct Fixture {
+    a: Arc<ProjectionPlan>,
+    p: Arc<ProjectionPlan>,
+    spec: NativeStarling,
+    reset: Tensor,
+    off_home: Tensor,
+    writer: NativeVectorWriter,
+}
+
+struct Observation {
+    delta: Tensor,
+    query: Tensor,
+    loss: Tensor,
+    raw_address: Tensor,
+    input: Tensor,
+    sink: AddressSink,
+}
+
+impl Fixture {
+    fn new(d: &Device, anchor_k: f32) -> Result<Self> {
+        // Static icosian/index metadata only. All transport/fixture arithmetic
+        // below, including the helpful off-home value, executes on CUDA.
+        let (roots, adjacent) = geometry()?;
+        let home = 30;
+        let other = adjacent[home * 12] as usize;
+        let roots = Tensor::from_vec(roots, (CELLS, 4), d)?;
+        let c_a = roots.narrow(0, home, 1)?.reshape(4)?;
+        let c_b = roots.narrow(0, other, 1)?.reshape(4)?;
+        let w = Tensor::new(&[1f32, -1., 1., 1.], d)?.affine(32., 0.)?;
+        let conjugation = Tensor::new(&[1f32, -1., -1., -1.], d)?;
+        let rel = super::murmuration::relative_table()?;
+        let g = roots
+            .narrow(0, rel[home * CELLS + other] as usize, 1)?
+            .reshape(4)?;
+        let v_b = super::murmuration::hamilton(&g.mul(&conjugation)?, &w.neg()?)?;
+        let address = Tensor::stack(&[&c_a, &c_b, &c_a, &c_a], 0)?;
+        // Kept home values w; the reader's .4w makes Delta and K wake-up
+        // nonzero. Off-home exploration is carried to -w in the reader frame.
+        let value = Tensor::stack(&[&w, &v_b, &w, &w.affine(0.4, 0.)?], 0)?;
+        let first = Tensor::cat(&[&address, &address], 1)?;
+        let desired_value = Tensor::cat(&[&value, &value], 1)?;
+        let a = ProjectionPlan::new(WIDTH, WIDTH)?;
+        let p = ProjectionPlan::new(WIDTH, WIDTH)?;
+        assert_eq!(a.frontier().len(), 2);
+        assert_eq!(p.frontier().len(), 2);
+        // Exact signed-axis metadata for atom1's BFS action. Invert it on the
+        // GPU to make V's selected output the declared transported values.
+        let g = &a.geometry;
+        let state = g.compose[g.bfs_actions[1] as usize * 64 + g.identity as usize] as usize;
+        let mut inverse = [0u32; 8];
+        for (out, &code) in g.axes[state * 8..state * 8 + 8].iter().enumerate() {
+            inverse[(code & 7) as usize] = out as u32 | (code & 8);
+        }
+        let second = signed_axes(&desired_value, &inverse)?;
+        let seed = Tensor::cat(&[&first, &second], 1)?.reshape((1, TIME, WIDTH))?;
+        let spec = NativeStarling {
+            depth: 4,
+            kept: 2,
+            explore: 2,
+            bos_id: 0,
+            credit: Credit::FIXTURE,
+        };
+        let reset = Tensor::new(&[[1u32, 0, 0, 0]], d)?;
+        let parameters = Parameters::new(&a, &p, anchor_k, d)?;
+        // Device fixture preparation at the one frozen nonzero-coupling
+        // anchor. No table is reanchored for credit or coupling comparisons.
+        let raw = heads(&a.forward(parameters.a.as_tensor(), &seed)?)?;
+        let unit = unit_address(&raw)?;
+        let norm = raw.sqr()?.sum(2)?.sqrt()?;
+        let values = heads(&a.forward(parameters.value.as_tensor(), &seed)?)?;
+        near(
+            &values.narrow(0, 0, 1)?.squeeze(0)?,
+            &value,
+            0.,
+            "V exact BFS inverse",
+        )?;
+        let selected = selection(&spec, &unit, &norm, &reset)?;
+        let delta = murmuration_read(
+            &spec,
+            &MurmurationInputs {
+                address: &unit,
+                address_norm: &norm,
+                value: &values,
+                coupling: parameters.coupling.as_tensor(),
+                selection: &selected,
+                heads: HEADS,
+                chirality: Chirality::Left,
+            },
+            false,
+            None,
+        )?
+        .delta;
+        let anchor = seed
+            .add(&p.forward(parameters.p.as_tensor(), &concat_heads(&delta)?)?)?
+            .narrow(1, TIME - 1, 1)?
+            .reshape((1, WIDTH))?
+            .detach();
+        let sign = w.gt(0.)?.to_dtype(DType::F32)?.affine(2., -1.)?;
+        let direction = Tensor::cat(&[&sign, &sign, &sign, &sign], 0)?.reshape((1, WIDTH))?;
+        let shift = direction.affine(0.25, 0.)?;
+        let rivals = anchor.add(&shift)?.broadcast_as((507, WIDTH))?;
+        let target = anchor.sub(&shift)?;
+        let table = Tensor::cat(&[&seed.reshape((TIME, WIDTH))?, &rivals, &target], 0)?.detach();
+        let writer = NativeVectorWriter::new(
+            &table,
+            WriterSpec {
+                vocabulary: 512,
+                width: WIDTH,
+                kept_cells: 16,
+            },
+        )?;
+        near(
+            &writer.encode(&[0, 1, 2, 3])?,
+            &seed.reshape((TIME, WIDTH))?,
+            0.,
+            "same input table",
+        )?;
+        Ok(Self {
+            a,
+            p,
+            spec,
+            reset,
+            off_home: c_b,
+            writer,
+        })
+    }
+
+    fn run(&self, params: &Parameters, credit: bool) -> Result<Observation> {
+        // The same writer/table supplies token vectors and scores the output.
+        let input = self
+            .writer
+            .encode(&[0, 1, 2, 3])?
+            .reshape((1, TIME, WIDTH))?;
+        let raw = heads(&self.a.forward(params.a.as_tensor(), &input)?)?;
+        let address = unit_address(&raw)?;
+        let norm = raw.sqr()?.sum(2)?.sqrt()?;
+        let value = heads(&self.a.forward(params.value.as_tensor(), &input)?)?;
+        let picked = selection(&self.spec, &address, &norm, &self.reset)?;
+        // This is a real selector result, not a manually authored slot list.
+        let selector = selection_spec(&self.spec)?;
+        let live = picked
+            .narrow(1, TIME - 1, 1)?
+            .narrow(2, 0, selector.slots())?;
+        assert_eq!(
+            live.eq(1u32)?
+                .to_dtype(DType::U32)?
+                .sum_all()?
+                .to_scalar::<u32>()?,
+            HEADS as u32,
+            "helpful off-home token must be an actual candidate"
+        );
+        let exploration = live.narrow(2, selector.kept, self.spec.explore)?;
+        assert_eq!(
+            exploration
+                .eq(1u32)?
+                .to_dtype(DType::U32)?
+                .sum_all()?
+                .to_scalar::<u32>()?,
+            HEADS as u32,
+            "helpful off-home token must lie in the real zero-forward exploration slots"
+        );
+        let kept_window = live.narrow(2, 0, selector.kept)?;
+        for token in [0u32, 2] {
+            assert_eq!(
+                kept_window
+                    .eq(token)?
+                    .to_dtype(DType::U32)?
+                    .sum_all()?
+                    .to_scalar::<u32>()?,
+                HEADS as u32,
+                "both home tokens must lie in the real kept window"
+            );
+        }
+        let sink: AddressSink = Arc::new(Mutex::new(Vec::new()));
+        let read = murmuration_read(
+            &self.spec,
+            &MurmurationInputs {
+                address: &address,
+                address_norm: &norm,
+                value: &value,
+                coupling: params.coupling.as_tensor(),
+                selection: &picked,
+                heads: HEADS,
+                chirality: Chirality::Left,
+            },
+            credit,
+            Some(Arc::clone(&sink)),
+        )?;
+        assert_eq!(
+            read.flock
+                .narrow(1, TIME - 1, 1)?
+                .sum_all()?
+                .to_scalar::<f32>()?,
+            2. * HEADS as f32
+        );
+        let query = input
+            .add(
+                &self
+                    .p
+                    .forward(params.p.as_tensor(), &concat_heads(&read.delta)?)?,
+            )?
+            .narrow(1, TIME - 1, 1)?
+            .reshape((1, WIDTH))?;
+        let candidates = self.writer.candidates(&query)?;
+        let margins = self.writer.margin_rows(&candidates, &[TARGET], 1)?;
+        let admitted = candidates
+            .address_scores()
+            .gather(candidates.cell_ids(), 1)?;
+        let other = candidates
+            .cell_ids()
+            .ne(TARGET % crate::native_vector_writer::CELLS as u32)?;
+        let rivals = other.where_cond(
+            &admitted,
+            &Tensor::full(-1e30f32, admitted.shape(), query.device())?,
+        )?;
+        let tied = rivals.broadcast_eq(&rivals.max_keepdim(1)?)?.mul(&other)?;
+        println!(
+            "composed writer: token margin {}, address margin {}, maximal address rivals {}, target admitted {}",
+            margins.token_margin.sum_all()?.to_scalar::<f32>()?,
+            margins.address_margin.sum_all()?.to_scalar::<f32>()?,
+            tied.to_dtype(DType::U32)?.sum_all()?.to_scalar::<u32>()?,
+            candidates.token_ids().eq(TARGET)?.mul(candidates.valid())?.to_dtype(DType::U32)?.sum_all()?.to_scalar::<u32>()?,
+        );
+        let loss = margins
+            .token_margin
+            .add(&margins.address_margin)?
+            .sum_all()?;
+        Ok(Observation {
+            delta: read.delta,
+            query,
+            loss,
+            raw_address: raw,
+            input,
+            sink,
+        })
+    }
+}
+
+fn heads(vector: &Tensor) -> Result<Tensor> {
+    Ok(vector
+        .reshape((1, TIME, HEADS, 4))?
+        .transpose(1, 2)?
+        .contiguous()?
+        .reshape((HEADS, TIME, 4))?)
+}
+
+fn concat_heads(delta: &Tensor) -> Result<Tensor> {
+    // Exactly P(concat_heads Delta), with no padding, dummy or probe carrier.
+    Ok(delta
+        .reshape((1, HEADS, TIME, 4))?
+        .transpose(1, 2)?
+        .contiguous()?
+        .reshape((1, TIME, WIDTH))?)
+}
+
+fn signed_axes(input: &Tensor, axes: &[u32; 8]) -> Result<Tensor> {
+    let pieces: Vec<Tensor> = axes
+        .iter()
+        .map(|&code| {
+            Ok(input
+                .narrow(1, (code & 7) as usize, 1)?
+                .affine(if code & 8 == 0 { 1. } else { -1. }, 0.)?)
+        })
+        .collect::<Result<_>>()?;
+    Ok(Tensor::cat(&pieces, 1)?)
+}
