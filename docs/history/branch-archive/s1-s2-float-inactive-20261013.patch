+
+// ---- Murmuration read, stage S2 (#2032 card 6151093135, M1 S2-a/b/c; Codex
+// FIT 6151549249). Same module, same nearest-vertex and rank laws as K1. ----
+
+// The one cell function of the read: nearest icosian vertex by dot product,
+// ties to the smallest vertex index (exactly K1's starling_nearest), for any
+// list of unit 4-d addresses. Used for tree nodes so the cell that selects a
+// node is bit-identical to the cell that transports it. Non-finite input
+// raises error[0] |= 1.
+extern "C" __global__ void murm_nearest_cells(
+    const float* address,   // [n, 4]
+    const float* roots,     // [120, 4]
+    uint* cell,             // [n]
+    uint* error,
+    uint n
+) {
+    uint i = blockIdx.x * blockDim.x + threadIdx.x;
+    if (i >= n) return;
+    const float* a = address + (u64)i * 4;
+    if (!isfinite(a[0]) || !isfinite(a[1]) || !isfinite(a[2]) || !isfinite(a[3])) {
+        atomicOr(error, 1u);
+        cell[i] = STARLING_ABSENT;
+        return;
+    }
+    cell[i] = starling_nearest(a, roots);
+}
+
+// Ring selection over a timeline of arriving keys: S1 tokens (address-null
+// keys excluded) and S2 tree nodes (a node arrives at the first position after
+// its last leaf). node_valid[r, t] = 1 marks a real arrival in row r; anything
+// else never enters a ring, so it can neither be ranked nor evict valid history
+// (the host plan also drops node arrivals crossing a document start). Scanning positions in order: a reset clears every ring; an
+// arriving node enters the ring (depth M) of its precomputed cell; then query
+// t gathers the nodes of its home vertex and the 12 neighbours and keeps the
+// `slots` largest address dots, ties to the later arrival. Output per (row,
+// t): the arrival positions in rank order (STARLING_ABSENT when fewer), then
+// the home cell and the arriving node's cell (STARLING_ABSENT when none).
+// Exact f32 products and sums in K1's fixed order; no exponential, no
+// normalisation, no host loop.
+extern "C" __global__ void murm_ring_select(
+    const float* query_address,   // [rows, time, 4], unit
+    const float* node_address,    // [rows, time, 4], the arriving node's unit address
+    const uint* node_cell,        // [rows, time], the arriving node's cell
+    const uint* node_valid,       // [rows, time], 1 where a real key arrives
+    const uint* reset,            // [batch, time], 1 at a document start
+    const float* roots,           // [120, 4]
+    const uint* adjacency,        // [120, 12]
+    uint* ring,                   // scratch [rows, 120, depth]
+    uint* ring_len,               // scratch [rows, 120]
+    uint* ring_head,              // scratch [rows, 120]
+    uint* out,                    // [rows, time, slots + 2]
+    uint* error,
+    uint rows, uint time, uint heads, uint depth, uint slots
+) {
+    uint r = blockIdx.x * blockDim.x + threadIdx.x;
+    if (r >= rows) return;
+    if (slots == 0 || slots > STARLING_MAX_SLOTS || depth == 0 || heads == 0) {
+        atomicOr(error, 2u);
+        return;
+    }
+    uint b = r / heads;
+    uint* my_ring = ring + (u64)r * STARLING_CELLS * depth;
+    uint* my_len = ring_len + (u64)r * STARLING_CELLS;
+    uint* my_head = ring_head + (u64)r * STARLING_CELLS;
+    for (uint c = 0; c < STARLING_CELLS; ++c) {
+        my_len[c] = 0;
+        my_head[c] = 0;
+    }
+    uint width = slots + 2;
+    float best_s[STARLING_MAX_SLOTS];
+    uint best_j[STARLING_MAX_SLOTS];
+    for (uint t = 0; t < time; ++t) {
+        if (reset[(u64)b * time + t] != 0) {
+            for (uint c = 0; c < STARLING_CELLS; ++c) {
+                my_len[c] = 0;
+                my_head[c] = 0;
+            }
+        }
+        const float* query = query_address + ((u64)r * time + t) * 4;
+        if (!isfinite(query[0]) || !isfinite(query[1]) || !isfinite(query[2])
+            || !isfinite(query[3])) {
+            atomicOr(error, 1u);
+            return;
+        }
+        uint arriving = STARLING_ABSENT;
+        if (node_valid[(u64)r * time + t] != 0) {
+            const float* key = node_address + ((u64)r * time + t) * 4;
+            if (!isfinite(key[0]) || !isfinite(key[1]) || !isfinite(key[2])
+                || !isfinite(key[3])) {
+                atomicOr(error, 1u);
+                return;
+            }
+            uint cell = node_cell[(u64)r * time + t];
+            if (cell >= STARLING_CELLS) {
+                atomicOr(error, 4u);
+                return;
+            }
+            arriving = cell;
+            uint* cell_ring = my_ring + (u64)cell * depth;
+            if (my_len[cell] == depth) {
+                cell_ring[my_head[cell]] = t;
+                my_head[cell] = (my_head[cell] + 1) % depth;
+            } else {
+                cell_ring[(my_head[cell] + my_len[cell]) % depth] = t;
+                my_len[cell] += 1;
+            }
+        }
+        uint home = starling_nearest(query, roots);
+        uint filled = 0;
+        for (uint n = 0; n <= STARLING_NEIGHBOURS; ++n) {
+            uint c = n == 0 ? home : adjacency[home * STARLING_NEIGHBOURS + n - 1];
+            const uint* c_ring = my_ring + (u64)c * depth;
+            for (uint i = 0; i < my_len[c]; ++i) {
+                uint j = c_ring[(my_head[c] + i) % depth];
+                float s = starling_dot4(query, node_address + ((u64)r * time + j) * 4);
+                if (filled < slots || starling_before(s, j, best_s[slots - 1], best_j[slots - 1])) {
+                    uint p = filled < slots ? filled : slots - 1;
+                    if (filled < slots) filled += 1;
+                    while (p > 0 && starling_before(s, j, best_s[p - 1], best_j[p - 1])) {
+                        best_s[p] = best_s[p - 1];
+                        best_j[p] = best_j[p - 1];
+                        p -= 1;
+                    }
+                    best_s[p] = s;
+                    best_j[p] = j;
+                }
+            }
+        }
+        uint* o = out + ((u64)r * time + t) * width;
+        for (uint i = 0; i < slots; ++i) {
+            o[i] = i < filled ? best_j[i] : STARLING_ABSENT;
+        }
+        o[slots] = home;
+        o[slots + 1] = arriving;
+    }
+}
diff --git a/crates/uor-r4-training/src/starling_native/kernels.rs b/crates/uor-r4-training/src/starling_native/kernels.rs
new file mode 100644
index 000000000..2a4e9ef35
--- /dev/null
+++ b/crates/uor-r4-training/src/starling_native/kernels.rs
@@ -0,0 +1,281 @@
+//! The murmuration read's ahead-of-time CUDA kernels (nvcc, `starling_native.cu`;
+//! no NVRTC): the shared nearest-cell function and K1's ring selection over a
+//! timeline of arriving keys with a per-row validity mask. Selection is hard
+//! and takes no gradient; model arithmetic is CUDA-only (D24).
+
+use candle_core::{CpuStorage, CustomOp1, CustomOp3, DType, Layout, Shape, Tensor};
+
+use super::{require_cuda, NativeStarling};
+use crate::{invalid, Result};
+
+/// The shared cell function on the device (kernel `murm_nearest_cells`):
+/// nearest icosian of each unit address `[n, 4]`, `[n]` U32.
+pub fn nearest_cells(address: &Tensor) -> Result<Tensor> {
+    require_cuda(address, "the murmuration cell function")?;
+    let (_, four) = address.dims2()?;
+    if four != 4 || address.dtype() != DType::F32 {
+        return Err(invalid("nearest cells need [n, 4] F32 addresses"));
+    }
+    Ok(address
+        .detach()
+        .contiguous()?
+        .apply_op1_no_bwd(&NearestCells)?)
+}
+
+struct NearestCells;
+
+impl CustomOp1 for NearestCells {
+    fn name(&self) -> &'static str {
+        "murmuration-nearest-cells"
+    }
+    fn cpu_fwd(&self, _: &CpuStorage, _: &Layout) -> candle_core::Result<(CpuStorage, Shape)> {
+        candle_core::bail!("the murmuration cell function is GPU-only; no host fallback (D24)")
+    }
+    #[cfg(feature = "cuda")]
+    fn cuda_fwd(
+        &self,
+        address: &candle_core::CudaStorage,
+        layout: &Layout,
+    ) -> candle_core::Result<(candle_core::CudaStorage, Shape)> {
+        cuda::nearest_cells(address, layout)
+    }
+}
+
+/// K1's ring selection over a timeline of arriving keys (kernel
+/// `murm_ring_select`): `node_address`/`node_cell` hold the key arriving at each
+/// position of each row, `valid` (`[rows, time]` U32) marks real arrivals, and
+/// `reset` (`[batch, time]`) clears the rings at BOS. Returns
+/// `[rows, time, spec.kept + 2]`: slot positions in rank order (ABSENT when
+/// fewer), the home cell, and the arriving key's cell (ABSENT when none).
+pub(crate) fn ring_select(
+    spec: &NativeStarling,
+    heads: usize,
+    query: &Tensor,
+    node_address: &Tensor,
+    node_cell: &Tensor,
+    valid: &Tensor,
+    reset: &Tensor,
+) -> Result<Tensor> {
+    require_cuda(query, "ring selection")?;
+    let (rows, time, _) = query.dims3()?;
+    // Codex 6153323237: reject zero or indivisible shapes before any division
+    // or launch (rows = 3, heads = 2 would otherwise read reset out of bounds).
+    if heads == 0 || rows == 0 || rows % heads != 0 {
+        return Err(invalid(format!(
+            "ring selection needs rows > 0 divisible by heads > 0 (rows {rows}, heads {heads})"
+        )));
+    }
+    let batch = rows / heads;
+    if node_address.dims() != [rows, time, 4]
+        || node_cell.dims() != [rows, time]
+        || valid.dims() != [rows, time]
+        || reset.dims() != [batch, time]
+    {
+        return Err(invalid("ring selection tensors disagree"));
+    }
+    // One U32 operand: node cells, then the arrival mask, then the reset mask.
+    let meta = Tensor::cat(
+        &[
+            &node_cell.flatten_all()?,
+            &valid.flatten_all()?,
+            &reset.to_dtype(DType::U32)?.flatten_all()?,
+        ],
+        0,
+    )?;
+    Ok(query.detach().contiguous()?.apply_op3_no_bwd(
+        &node_address.detach().contiguous()?,
+        &meta.contiguous()?,
+        &RingSelect {
+            spec: *spec,
+            heads,
+            batch,
+        },
+    )?)
+}
+
+struct RingSelect {
+    #[cfg_attr(not(feature = "cuda"), allow(dead_code))]
+    spec: NativeStarling,
+    #[cfg_attr(not(feature = "cuda"), allow(dead_code))]
+    heads: usize,
+    #[cfg_attr(not(feature = "cuda"), allow(dead_code))]
+    batch: usize,
+}
+
+impl CustomOp3 for RingSelect {
+    fn name(&self) -> &'static str {
+        "murmuration-ring-select"
+    }
+    fn cpu_fwd(
+        &self,
+        _: &CpuStorage,
+        _: &Layout,
+        _: &CpuStorage,
+        _: &Layout,
+        _: &CpuStorage,
+        _: &Layout,
+    ) -> candle_core::Result<(CpuStorage, Shape)> {
+        candle_core::bail!("ring selection is GPU-only; no host fallback (D24)")
+    }
+    #[cfg(feature = "cuda")]
+    fn cuda_fwd(
+        &self,
+        query: &candle_core::CudaStorage,
+        ql: &Layout,
+        node: &candle_core::CudaStorage,
+        nl: &Layout,
+        meta: &candle_core::CudaStorage,
+        ml: &Layout,
+    ) -> candle_core::Result<(candle_core::CudaStorage, Shape)> {
+        cuda::ring_select(self, query, ql, node, nl, meta, ml)
+    }
+}
+
+#[cfg(feature = "cuda")]
+mod cuda {
+    use candle_core::backend::BackendStorage;
+    use candle_core::{CudaStorage, DType, Layout, Result as CResult, Shape};
+    use cudarc::driver::CudaView;
+
+    use super::RingSelect;
+    use crate::cuda_stack_kernels::cuda::{launch_prebuilt, zeros, Arg};
+
+    const PTX: &str = include_str!(concat!(env!("OUT_DIR"), "/starling_native.ptx"));
+    const MODULE: &str = "uor_r4_starling_native";
+
+    fn view_f32<'a>(s: &'a CudaStorage, l: &Layout) -> CResult<CudaView<'a, f32>> {
+        if !l.is_contiguous() || s.dtype() != DType::F32 {
+            candle_core::bail!("expected a contiguous F32 CUDA tensor");
+        }
+        let start = l.start_offset();
+        match s
+            .as_cuda_slice::<f32>()?
+            .try_slice(start..start + l.shape().elem_count())
+        {
+            Some(v) => Ok(v),
+            None => candle_core::bail!("CUDA input layout exceeds its buffer"),
+        }
+    }
+
+    fn view_u32<'a>(
+        s: &'a CudaStorage,
+        l: &Layout,
+        from: usize,
+        len: usize,
+    ) -> CResult<CudaView<'a, u32>> {
+        if !l.is_contiguous() || s.dtype() != DType::U32 {
+            candle_core::bail!("expected a contiguous U32 CUDA tensor");
+        }
+        let start = l.start_offset() + from;
+        match s.as_cuda_slice::<u32>()?.try_slice(start..start + len) {
+            Some(v) => Ok(v),
+            None => candle_core::bail!("CUDA input layout exceeds its buffer"),
+        }
+    }
+
+    fn narrow(v: usize) -> CResult<u32> {
+        u32::try_from(v)
+            .map_err(|_| candle_core::Error::Msg("murmuration dimension overflow".into()))
+    }
+
+    fn check(
+        device: &candle_core::CudaDevice,
+        error: &cudarc::driver::CudaSlice<u32>,
+        what: &str,
+    ) -> CResult<()> {
+        let flag = device.clone_dtoh(error)?;
+        if flag.first().copied() != Some(0) {
+            candle_core::bail!("{what} rejected its input: {:?}", flag);
+        }
+        Ok(())
+    }
+
+    pub(super) fn nearest_cells(
+        address: &CudaStorage,
+        layout: &Layout,
+    ) -> CResult<(CudaStorage, Shape)> {
+        let device = &address.device;
+        let n = match layout.shape().dims() {
+            [n, 4] => *n,
+            _ => candle_core::bail!("nearest cells need [n, 4] addresses"),
+        };
+        let (roots, _) = crate::starling_native::geometry()
+            .map_err(|e| candle_core::Error::Msg(e.to_string()))?;
+        let roots = device.clone_htod(&roots)?;
+        let out = zeros::<u32>(device, n)?;
+        let error = zeros::<u32>(device, 1)?;
+        let args = [
+            Arg::F(view_f32(address, layout)?),
+            Arg::f(&roots),
+            Arg::u(&out),
+            Arg::u(&error),
+            Arg::U32(narrow(n)?),
+        ];
+        launch_prebuilt(device, MODULE, PTX, "murm_nearest_cells", n, &args)?;
+        drop(args);
+        check(device, &error, "the murmuration cell function")?;
+        Ok((
+            CudaStorage::wrap_cuda_slice(out, device.clone()),
+            Shape::from_dims(&[n]),
+        ))
+    }
+
+    pub(super) fn ring_select(
+        op: &RingSelect,
+        query: &CudaStorage,
+        ql: &Layout,
+        node: &CudaStorage,
+        nl: &Layout,
+        meta: &CudaStorage,
+        ml: &Layout,
+    ) -> CResult<(CudaStorage, Shape)> {
+        let device = &query.device;
+        let (rows, time) = match ql.shape().dims() {
+            [rows, time, 4] => (*rows, *time),
+            _ => candle_core::bail!("ring selection queries must be [rows, time, 4]"),
+        };
+        let batch = op.batch;
+        if nl.shape().dims() != ql.shape().dims()
+            || ml.shape().elem_count() != 2 * rows * time + batch * time
+        {
+            candle_core::bail!("ring selection operands disagree");
+        }
+        let (roots, adjacency) = crate::starling_native::geometry()
+            .map_err(|e| candle_core::Error::Msg(e.to_string()))?;
+        let roots = device.clone_htod(&roots)?;
+        let adjacency = device.clone_htod(&adjacency)?;
+        let cells = crate::starling_native::CELLS;
+        let slots = op.spec.kept;
+        let ring = zeros::<u32>(device, rows * cells * op.spec.depth)?;
+        let ring_len = zeros::<u32>(device, rows * cells)?;
+        let ring_head = zeros::<u32>(device, rows * cells)?;
+        let out = zeros::<u32>(device, rows * time * (slots + 2))?;
+        let error = zeros::<u32>(device, 1)?;
+        let args = [
+            Arg::F(view_f32(query, ql)?),
+            Arg::F(view_f32(node, nl)?),
+            Arg::U(view_u32(meta, ml, 0, rows * time)?),
+            Arg::U(view_u32(meta, ml, rows * time, rows * time)?),
+            Arg::U(view_u32(meta, ml, 2 * rows * time, batch * time)?),
+            Arg::f(&roots),
+            Arg::u(&adjacency),
+            Arg::u(&ring),
+            Arg::u(&ring_len),
+            Arg::u(&ring_head),
+            Arg::u(&out),
+            Arg::u(&error),
+            Arg::U32(narrow(rows)?),
+            Arg::U32(narrow(time)?),
+            Arg::U32(narrow(op.heads)?),
+            Arg::U32(narrow(op.spec.depth)?),
+            Arg::U32(narrow(slots)?),
+        ];
+        launch_prebuilt(device, MODULE, PTX, "murm_ring_select", rows, &args)?;
+        drop(args);
+        check(device, &error, "ring selection")?;
+        Ok((
+            CudaStorage::wrap_cuda_slice(out, device.clone()),
+            Shape::from_dims(&[rows, time, slots + 2]),
+        ))
+    }
+}
