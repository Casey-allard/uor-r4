+/// An optional fraction of the steps in (0, 1] (`starling_anneal=`).
+fn optional_fraction(args: &Args, key: &str) -> Result<Option<f64>> {
+    match args.optional(key) {
+        None => Ok(None),
+        Some(text) => match text.parse::<f64>() {
+            Ok(value) if value > 0.0 && value <= 1.0 => Ok(Some(value)),
+            _ => Err(invalid(format!(
+                "{key} is a fraction in (0, 1], not {text}"
+            ))),
+        },
+    }
+}
+
+/// Applies the starling read and its training-only aids (`read_route=` and
+/// the `starling_*` settings). A fresh model takes the route before its
+/// optimizer is built (the route adds variables); a loaded model must
+/// already carry the same route. Never with a replica or bf16.
+fn apply_starling(settings: &Settings, model: &mut StackModel) -> Result<()> {
+    let Some(route) = settings.read_route else {
+        let any = settings.starling_surrogate
+            || settings.starling_anneal.is_some()
+            || settings.starling_distill.is_some()
+            || settings.starling_salience.is_some()
+            || settings.starling_rank_distill.is_some();
+        if any {
+            return Err(invalid(
+                "the starling_* settings need read_route=starling:...",
+            ));
+        }
+        return Ok(());
+    };
+    if settings.qat || settings.transport_snap.is_some() {
+        return Err(invalid(
+            "read_route=starling runs without qat and transport_snap",
+        ));
+    }
+    if model.read_route().is_some_and(|saved| saved != route) {
+        return Err(invalid(
+            "the model already carries a different starling route",
+        ));
+    }
+    if settings.data_parallel != 1 || settings.precision.is_bf16() {
+        return Err(invalid(
+            "read_route=starling runs with data_parallel=1 and precision=f32",
+        ));
+    }
+    if !(0.0..1.0).contains(&settings.starling_distill_start)
+        || (settings.starling_distill_start > 0.0 && settings.starling_distill.is_none())
+    {
+        return Err(invalid(
+            "starling_distill_start is a fraction in [0, 1) and needs starling_distill",
+        ));
+    }
+    model.set_read_route(Some(route))?;
+    model.set_starling_surrogate(settings.starling_surrogate)?;
+    model.set_starling_distill(settings.starling_distill)?;
+    model.set_starling_salience(settings.starling_salience)?;
+    model.set_starling_rank_distill(settings.starling_rank_distill)?;
+    Ok(())
+}
