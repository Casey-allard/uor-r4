+    /// A scorecard holding exactly `pass` of `of` for each key.
+    fn card_of(rows: &[(&str, usize, usize)]) -> Scorecard {
+        let mut card = Scorecard::default();
+        for (key, pass, of) in rows {
+            for i in 0..*of {
+                card.add((*key).to_owned(), i < *pass);
+            }
+        }
+        card
+    }
