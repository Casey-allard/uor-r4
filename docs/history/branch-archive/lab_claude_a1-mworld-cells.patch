+        let nll = |report: &Value| report["response_mean_nll"].as_f64().unwrap();
+        assert!(
+            nll(&after) < 0.5 * nll(&before),
+            "response NLL {} -> {}",
+            nll(&before),
+            nll(&after)
+        );
+        assert!(after["pointer"]["mean_gate"].is_number());
+        // Greedy replies come from the mixture and stop at EOS.
