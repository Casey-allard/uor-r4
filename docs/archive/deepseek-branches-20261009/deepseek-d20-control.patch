+#!/usr/bin/env python3
+"""D20 section 2 condition 1/2 analysis.
+
+Reads sealed mqar-bench arm records (read-only; never writes into a report
+root) and prints, for the geometric read and its matched ordinary controls:
+
+  * per-seed final in-class and held-out-class accuracy, per bucket,
+  * the paired per-seed delta, the mean, and the sample variance across seeds,
+  * the parameter counts and the per-token MAC accounting side by side,
+  * the D20 section 2 condition 3 reachability evidence (read firing counter and
+    the arch-symmetric source-key ablation counter).
+
+Usage: d20-analyze.py ROOT [ROOT ...]
+"""
+import json
+import os
+import statistics
+import sys
+
+D, HEADS = 128, 4
+CONTEXT = 512
+
+
+def macs(config, t):
+    """Per-token multiply-accumulate accounting at position t."""
+    d = config["width"]
+    h = config["heads"]
+    m = config["mlp_hidden"]
+    lanes = d // 4
+    total = 0.0
+    for ch in config["pattern"]:
+        if config.get("arch") == "transformer":
+            # q,k,v,o maps; RoPE+dot score and value mix over t+1 sources; softmax
+            total += 4 * d * d + 3 * d * m + 2 * d * (t + 1) + 3 * h * (t + 1)
+        elif ch == "r":
+            gates = lanes + (d if config.get("rotation") else 0)
+            total += 2 * d * d + gates * d + d * d + 3 * d * m + 4 * d
+        else:
+            total += 4 * d * d + h * d + 3 * d * m + 2 * d * (t + 1) + h * (t + 1)
+    return total
+
+
+def load(root):
+    with open(os.path.join(root, "report.json")) as handle:
+        report = json.load(handle)
+    if report.get("status") != "complete":
+        return None
+    arm, res = report["arm"], report["results"]
+    config = arm["config"]["stack_config"]
+    final = res["final_in_class_fresh_pairings"]
+    held = res["final_held_out_class_pairings"]
+    return {
+        "root": root,
+        "label": arm["label"],
+        "kind": arm["kind"],
+        "arch": config["arch"],
+        "pattern": config["pattern"],
+        "seed": config["seed"],
+        "config": config,
+        "parameters": arm["parameters"],
+        "parameter_match": arm.get("parameter_match"),
+        "in_class": final["accuracy"],
+        "held_out": held["accuracy"],
+        "buckets": {k: v["accuracy"] for k, v in final["by_bucket"].items()},
+        "nll": final.get("mean_nll"),
+        "positions_scored": final.get("positions_scored_per_query_token_mean"),
+        "context_access": res.get("context_access", {}),
+        "read_firing": res.get("read_firing"),
+        "reachability": res.get("context_reachability"),
+        "steps": res.get("steps_completed"),
+        "early": res.get("stopped_early_at_max_seconds"),
+        "wall": res.get("wall_seconds"),
+        "supervised_queries": res.get("supervised_queries_seen"),
+        "max_seconds": report["task"].get("max_seconds"),
+        "threads": report["task"].get("threads"),
+        "argv": report.get("argv"),
+    }
+
+
+def main():
+    runs = []
+    for root in sys.argv[1:]:
+        if os.path.isfile(os.path.join(root, "report.json")):
+            item = load(root)
+            if item:
+                runs.append(item)
+            else:
+                print(f"SKIP (not complete): {root}")
+    runs.sort(key=lambda r: (r["label"], r["seed"]))
+
+    print("=" * 132)
+    print("PER-SEED RESULTS (final_in_class_fresh_pairings = the primary metric)")
+    print("=" * 132)
+    head = f"{'label':30s} {'kind':18s} {'arch':11s} {'seed':>4s} {'params':>9s} " \
+           f"{'in_class':>9s} {'held_out':>9s} {'nll':>7s} {'pos/q':>8s} {'steps':>5s} {'wall_s':>7s}"
+    print(head)
+    for r in runs:
+        print(f"{r['label'][:30]:30s} {r['kind'][:18]:18s} {r['arch']:11s} {r['seed']:>4d} "
+              f"{r['parameters']:>9d} {r['in_class']:>9.4f} {r['held_out']:>9.4f} "
+              f"{(r['nll'] if r['nll'] is not None else float('nan')):>7.3f} "
+              f"{(r['positions_scored'] or 0):>8.1f} {r['steps']:>5d} {(r['wall'] or 0):>7.0f}")
+        print(f"{'':30s} buckets " + " ".join(f"{k}={v:.3f}" for k, v in sorted(r["buckets"].items())))
+
+    print()
+    print("=" * 132)
+    print("PARAMETER AND PER-TOKEN MAC ACCOUNTING (measured params; MACs from the reported config)")
+    print("=" * 132)
+    print(f"{'label':30s} {'params':>9s} {'MACs@t=256':>12s} {'MACs@t=511':>12s} "
+          f"{'access rows@t':>13s} {'layers':>7s} {'mlp':>6s}")
+    for r in runs:
+        c = r["config"]
+        print(f"{r['label'][:30]:30s} {r['parameters']:>9d} {macs(c, 256):>12,.0f} {macs(c, 511):>12,.0f} "
+              f"{(r['positions_scored'] or 0):>13.1f} {len(c['pattern']):>7d} {c['mlp_hidden']:>6d}")
+
+    print()
+    print("=" * 132)
+    print("D20 SECTION 2 CONDITION 3 — REACHABILITY (must be reached on the scored positions)")
+    print("=" * 132)
+    for r in runs:
+        fire = r["read_firing"] or {}
+        reach = r["reachability"] or {}
+        print(f"{r['label']:30s} s{r['seed']}  firing_status={fire.get('status', 'n/a')[:60]}")
+        if fire.get("status") == "MEASURED":
+            print(f"{'':30s}      rows_evaluated={fire.get('rows_evaluated')} "
+                  f"nonzero_key={fire.get('rows_nonzero_mass_on_key')} "
+                  f"nonzero_value={fire.get('rows_nonzero_mass_on_value')} "
+                  f"over_half_key={fire.get('rows_over_half_on_key')} "
+                  f"over_half_value={fire.get('rows_over_half_on_value')} "
+                  f"mass_key={fire.get('mean_mass_on_key', 0):.4f} "
+                  f"mass_value={fire.get('mean_mass_on_value', 0):.4f} "
+                  f"uniform={fire.get('mean_uniform_reference', 0):.4f}")
+            for bucket, entry in sorted(fire.get("by_bucket", {}).items()):
+                print(f"{'':30s}        {bucket}: rows={entry['rows']} "
+                      f"nz_key={entry['rows_nonzero_mass_on_key']} "
+                      f"nz_value={entry.get('rows_nonzero_mass_on_value')} "
+                      f"mass_key={entry['mean_mass_on_key']:.4f} "
+                      f"mass_value={entry.get('mean_mass_on_value', 0):.4f} "
+                      f"uniform={entry['mean_uniform_reference']:.4f}")
+        if reach:
+            print(f"{'':30s}      key_ablation: {reach.get('rows_with_any_logit_change')}/"
+                  f"{reach.get('rows')} rows changed, argmax "
+                  f"{reach.get('rows_whose_argmax_changed')}, max|dlogit| "
+                  f"{reach.get('max_abs_logit_delta', 0):.6f}")
+
+    print()
+    print("=" * 132)
+    print("PAIRED PER-SEED DELTA vs THE MATCHED CONTROL (d = geometric - control, held-out accuracy)")
+    print("=" * 132)
+    by_label = {}
+    for r in runs:
+        by_label.setdefault(r["label"], {})[r["seed"]] = r
+    geometric = [l for l in by_label if l.startswith("stack-")]
+    controls = [l for l in by_label if not l.startswith("stack-")]
+    for g in sorted(geometric):
+        for c in sorted(controls):
+            seeds = sorted(set(by_label[g]) & set(by_label[c]))
+            if not seeds:
+                continue
+            print(f"\n{g}  -  {c}")
+            for metric in ("in_class", "held_out"):
+                deltas = [by_label[g][s][metric] - by_label[c][s][metric] for s in seeds]
+                print(f"  {metric:9s} per seed " +
+                      " ".join(f"s{s}={d:+.4f}" for s, d in zip(seeds, deltas)) +
+                      f"  mean={statistics.fmean(deltas):+.4f}"
+                      + (f"  variance={statistics.variance(deltas):.6f}" if len(deltas) > 1 else ""))
+            pg = {by_label[g][s]["parameters"] for s in seeds}
+            pc = {by_label[c][s]["parameters"] for s in seeds}
+            print(f"  parameters geometric={sorted(pg)} control={sorted(pc)} "
+                  f"residual={sorted(pg)[0] - sorted(pc)[0]:+d} "
+                  f"({(sorted(pg)[0] - sorted(pc)[0]) / sorted(pc)[0] * 100:+.4f}%)")
+            mg = macs(by_label[g][seeds[0]]["config"], 256)
+            mc = macs(by_label[c][seeds[0]]["config"], 256)
+            print(f"  MACs@t=256 geometric={mg:,.0f} control={mc:,.0f} "
+                  f"({(mg / mc - 1) * 100:+.2f}% control vs geometric)")
+            print(f"  access rows geometric={by_label[g][seeds[0]]['positions_scored']:.1f} "
+                  f"control={by_label[c][seeds[0]]['positions_scored']:.1f}")
+
+
+if __name__ == "__main__":
+    main()
