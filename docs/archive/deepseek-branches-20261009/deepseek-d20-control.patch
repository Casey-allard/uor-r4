+#!/bin/bash
+# D20 section 2 condition 1/2 battery, concurrency 3.
+#
+# Why concurrency: the 1.37M-parameter geometric stack trains at well under one
+# core (measured: 50-81% of one core on this 8-core box), so three concurrent
+# arms cost about what one costs and cut the wall clock by ~3x. Every arm still
+# runs with RAYON_NUM_THREADS unset, i.e. the 8-thread setting every published
+# mqar-bench run used.
+set -u
+BIN="$HOME/.cache/uor-r4-d20control/release/examples/mqar-bench"
+PARENT="$HOME/uor-r4-local/mqar-bench/${BATTERY_ROOT:?BATTERY_ROOT unset}"
+LOG="$PARENT/driver.log"
+mkdir -p "$PARENT"
+COMMON="device=cpu context=512 batch=8 steps=1800 lr=0.001 warmup=100 eval_every=100
+curve_sequences=8 final_sequences=64 max_seconds=3600 probe_steps=none"
+GEOM="pattern=rrarra read=l2 rotation=true width=128 heads=4 mlp=384"
+CTRL="width=128 heads=4 mlp=matched match_pattern=rrarra match_read=l2 match_rotation=true"
+
+# run_one <name> <arm args...>: background one arm, appending its own END line.
+run_one() {
+  local name="$1"; shift
+  local root="$PARENT/$name"
+  if [ -e "$root" ]; then
+    echo "=== SKIP $name: root exists $(date -u +%FT%TZ)" >> "$LOG"
+    return 0
+  fi
+  (
+    local t0 t1 rc
+    t0=$(date +%s)
+    echo "=== START $name $(date -u +%FT%TZ)" >> "$LOG"
+    # shellcheck disable=SC2086
+    /usr/bin/time -l "$BIN" out="$root" $COMMON "$@" > "$PARENT/$name.stdout" 2>&1
+    rc=$?
+    t1=$(date +%s)
+    {
+      echo "=== END $name rc=$rc elapsed=$((t1 - t0))s $(date -u +%FT%TZ)"
+      grep -aE "^(final in-class|reachability)" "$PARENT/$name.stdout" | head -4
+      grep -ao "[0-9]*  maximum resident set size" "$PARENT/$name.stdout" | head -1
+    } >> "$LOG"
+  ) &
+}
+
+wait_all() { wait; echo "--- wave done $(date -u +%FT%TZ)" >> "$LOG"; }
+
+echo "=== BATTERY START concurrency 3 $(date -u +%FT%TZ)" >> "$LOG"
+
+# Wave 1: the two required arms at seed 2, plus the redo of the SIGTERM'd seed 1.
+run_one G-rrarra-s2        $GEOM seed=2
+run_one C2-matched-s2      arm=transformer layers=2 $CTRL seed=2
+run_one G-rrarra-s1r       $GEOM seed=1
+wait_all
+
+# Wave 2: the remaining seeds of the two required arms.
+run_one G-rrarra-s3        $GEOM seed=3
+run_one C2-matched-s1      arm=transformer layers=2 $CTRL seed=1
+run_one C2-matched-s3      arm=transformer layers=2 $CTRL seed=3
+wait_all
+
+# Wave 3: the key/query-lineage arm (D20's "named missing component" localiser).
+run_one F2-rrarra-keyshift-s1 $GEOM key_shift=true seed=1
+run_one F2-rrarra-keyshift-s2 $GEOM key_shift=true seed=2
+run_one F2-rrarra-keyshift-s3 $GEOM key_shift=true seed=3
+wait_all
+
+# Wave 4: the depth-matched control (same 6 layers; +20-36% per-token compute,
+# in the control's favour), for the second half of the matching table.
+run_one C6-matched-s2      arm=transformer layers=6 $CTRL seed=2
+run_one C6-matched-s3      arm=transformer layers=6 $CTRL seed=3
+wait_all
+
+echo "=== BATTERY COMPLETE $(date -u +%FT%TZ)" >> "$LOG"
