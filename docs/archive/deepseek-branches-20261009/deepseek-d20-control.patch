+#!/bin/bash
+# D20 section 2 condition 1/2 battery: the geometric read vs parameter- and
+# compute-matched ordinary causal-softmax controls, 3 seeds per arm.
+# Detached driver: one run at a time, RAYON_NUM_THREADS unset (8, the setting
+# every published mqar-bench run used).
+set -u
+BIN="$HOME/.cache/uor-r4-d20control/release/examples/mqar-bench"
+PARENT="$HOME/uor-r4-local/mqar-bench/${BATTERY_ROOT:?BATTERY_ROOT unset}"
+LOG="$PARENT/driver.log"
+mkdir -p "$PARENT"
+COMMON="device=cpu context=512 batch=8 steps=1800 lr=0.001 warmup=100 eval_every=100
+curve_sequences=8 final_sequences=64 max_seconds=3600 probe_steps=none"
+GEOM="pattern=rrarra read=l2 rotation=true width=128 heads=4 mlp=384"
+CTRL="width=128 heads=4 mlp=matched match_pattern=rrarra match_read=l2 match_rotation=true"
+
+record() {
+  local name="$1"; shift
+  local root="$PARENT/$name"
+  if [ -e "$root" ]; then
+    echo "=== SKIP $name: root exists" >> "$LOG"; return
+  fi
+  echo "=== START $name $(date -u +%FT%TZ)" >> "$LOG"
+  local t0; t0=$(date +%s)
+  /usr/bin/time -l "$BIN" out="$root" $COMMON "$@" > "$PARENT/$name.stdout" 2>&1
+  local rc=$?
+  local t1; t1=$(date +%s)
+  echo "=== END $name rc=$rc elapsed=$((t1 - t0))s $(date -u +%FT%TZ)" >> "$LOG"
+  grep -E "^(final in-class|reachability)" "$PARENT/$name.stdout" >> "$LOG" 2>/dev/null
+  local peak; peak=$(grep -o "[0-9]*  maximum resident set size" "$PARENT/$name.stdout" | head -1)
+  echo "    peak_rss: $peak" >> "$LOG"
+}
+
+record G-rrarra-s1 $GEOM seed=1
+record C6-matched-s1 arm=transformer layers=6 $CTRL seed=1
+record G-rrarra-s2 $GEOM seed=2
+record C6-matched-s2 arm=transformer layers=6 $CTRL seed=2
+record G-rrarra-s3 $GEOM seed=3
+record C6-matched-s3 arm=transformer layers=6 $CTRL seed=3
+record C2-matched-s1 arm=transformer layers=2 $CTRL seed=1
+record C2-matched-s2 arm=transformer layers=2 $CTRL seed=2
+record C2-matched-s3 arm=transformer layers=2 $CTRL seed=3
+record F2-rrarra-keyshift-s1 $GEOM key_shift=true seed=1
+record F2-rrarra-keyshift-s2 $GEOM key_shift=true seed=2
+record F2-rrarra-keyshift-s3 $GEOM key_shift=true seed=3
+echo "=== BATTERY COMPLETE $(date -u +%FT%TZ)" >> "$LOG"
