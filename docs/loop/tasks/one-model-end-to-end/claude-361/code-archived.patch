+    #[cfg(feature = "cuda")]
+    fn linked_reads(device: &Device, carry: usize) -> HammingReads {
+        let reads = HammingReads::new(4, 256, device).unwrap().with_ask(VOCAB).unwrap();
+        let reads = if carry > 0 { reads.with_carry(carry, VOCAB).unwrap() } else { reads };
