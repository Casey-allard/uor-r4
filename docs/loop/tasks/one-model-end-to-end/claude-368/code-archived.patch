+            Check::Replaced {
+                reply: 0,
+                vote: 349_525,
+                top: 2_796_202,
+                refused: false
+            }
+        );
+        let held = Setting {
+            hold_out: true,
+            ..even
+        };
+        assert_eq!(
+            t.check_setting(&[0, 1, 2], B, held),
+            Check::Stands {
+                vote: 1 << 20,
+                top: 1 << 20
+            }
+        );
+        assert_eq!(t.check_setting(&[4, 5], B, even), Check::NoExpert);
+    }
