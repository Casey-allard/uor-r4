{
  "alpha_exit_condition": "a source-free model artifact loads and produces prompt-dependent text through the repository CLI or local service on target local hardware",
  "delivery": {
    "active_task_limit": 1,
    "direct_push_to_main": false,
    "protected_pull_request": true
  },
  "evidence": {
    "distinguish": [
      "mathematical_proof",
      "measured_behavior",
      "unverified_hypothesis"
    ],
    "preserve_negative_results": true,
    "preserve_unique_evidence_and_user_material": true,
    "routine_record": "pull_request_or_active_issue_summary"
  },
  "execution": {
    "allowed": [
      "build_compile_and_lint",
      "focused_tests",
      "model_training_fitting_and_evaluation",
      "service_browser_and_cli_execution",
      "repository_and_source_inspection",
      "reviewable_git_and_github_operations"
    ],
    "automatic_retries": 0,
    "concrete_failure_response": "inspect_existing_output_then_one_direct_fix_and_rerun_or_park",
    "expensive_run": {
      "definition": "estimated_over_15_minutes_or_any_external_cost_or_over_10_gib_new_storage",
      "requires": [
        "explicit_owner_or_active_issue_authorization",
        "hard_resource_limit",
        "stop_condition"
      ]
    },
    "prohibited": [
      "automatic_retry_campaigns",
      "custom_supervisors_watchdogs_and_receipt_harnesses",
      "environment_probe_campaigns",
      "silent_external_spend"
    ],
    "verification": "run_only_the_smallest_check_that_directly_exercises_the_changed_behavior"
  },
  "mode": "build_first_pre_alpha",
  "routine_artifacts": {
    "deferred_until_alpha": [
      "formal_proof_work",
      "claim_ledger_updates",
      "knowledge_index_maintenance",
      "independent_review",
      "frozen_experiment_contracts",
      "fresh_process_replay",
      "receipt_and_supervisor_packages",
      "duplicate_roadmap_and_status_mirrors",
      "paper_and_publication_work",
      "nemesis_and_w33_mapping",
      "broad_qa_and_release_certification"
    ],
    "early_activation": "explicit_owner_instruction_only",
    "required": [
      "primary_code_or_product_deliverable",
      "direct_behavior_result_when_execution_is_relevant",
      "concise_limit_and_next_action"
    ]
  },
  "schema": "uor-r4.agent-execution-policy/2",
  "workspace": {
    "base": "refreshed_origin_main",
    "preserve_user_and_unique_evidence": true,
    "type": "isolated_full_git_worktree"
  }
}
