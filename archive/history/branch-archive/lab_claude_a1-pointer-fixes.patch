+/// has none, records no seed, and so must the resume.
+fn check_resume_pointer_seed(checkpoint: &Path, config: &StackConfig) -> Result<()> {
+    let state: Value = serde_json::from_slice(&fs::read(checkpoint.join("state.json"))?)?;
