+                assert: &COLOR_ASSERT,
+                update: &COLOR_UPDATE,
+                query: &COLOR_QUERY,
+                acks: &["{v} is a pretty color.", "Got it, you love {v}."],
+                answers: &["Your favorite color is {v}.", "You love {v}."],
