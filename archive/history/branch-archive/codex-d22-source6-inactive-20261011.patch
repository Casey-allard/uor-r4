+use std::{error::Error, fs, path::PathBuf};
+
+fn main() -> Result<(), Box<dyn Error>> {
+    let path = PathBuf::from(std::env::args().nth(1).ok_or("capture path required")?);
+    if fs::metadata(&path)?.len() > 16 * 1024 * 1024 {
+        return Err("capture storage admission".into());
+    }
+    let text = fs::read_to_string(path)?;
+    println!("{}", microlp::repair::exact_cost_capture_fixture(&text)?);
+    Ok(())
+}
