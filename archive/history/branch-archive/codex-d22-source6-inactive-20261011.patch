+/// Return y in original row order, with an exact witness B^T y = rhs.
+pub(crate) fn transpose_solve(
+    basis: &crate::repair::Basis,
+    rhs: &[f64],
+) -> Result<Vec<BigRational>, Error> {
+    let n = basis.columns.len();
+    let (total_raw_bits, total_solution_bits) = crate::lu::exact_resource_limits(n)?;
+    if rhs.len() != n {
+        return Err(Error::UnreliableFactorization);
+    }
+    let rhs = rhs
+        .iter()
+        .map(|&v| dyadic(v))
+        .collect::<Result<Vec<_>, _>>()?;
+    let mut columns = Vec::with_capacity(n);
+    for (rows, values) in &basis.columns {
+        if rows.len() != values.len()
+            || rows.windows(2).any(|pair| pair[0] >= pair[1])
+            || rows.iter().any(|&r| r >= n)
+        {
+            return Err(Error::UnreliableFactorization);
+        }
+        let values = values
+            .iter()
+            .map(|&v| dyadic(v))
+            .collect::<Result<Vec<_>, _>>()?;
+        for value in &values {
+            bounded(value, total_raw_bits)?;
+        }
+        columns.push((rows, values));
+    }
+    for value in &rhs {
+        bounded(value, total_raw_bits)?;
+    }
+
+    let mut active_rows = vec![true; n];
+    let mut active_cols = vec![true; n];
+    let mut peeled = Vec::new();
+    loop {
+        let before = peeled.len();
+        for c in 0..n {
+            if !active_cols[c] {
+                continue;
+            }
+            let (rows, values) = &columns[c];
+            let mut entries = rows
+                .iter()
+                .zip(values)
+                .filter(|&(&r, v)| active_rows[r] && !v.is_zero());
+            let Some((&r, _)) = entries.next() else {
+                return Err(Error::SingularMatrix);
+            };
+            if entries.next().is_none() {
+                peeled.push((c, r));
+                active_cols[c] = false;
+                active_rows[r] = false;
+            }
+        }
+        if before == peeled.len() {
+            break;
+        }
+    }
+
+    // The peeled columns are equations for T^T. Each has only one
+    // not-yet-solved row, so the transpose top block is solved forward.
+    let mut solution = vec![BigRational::zero(); n];
+    let mut solved = vec![false; n];
+    for &(c, pivot_row) in &peeled {
+        let mut value = rhs[c].clone();
+        let mut diagonal = BigRational::zero();
+        let (rows, coefficients) = &columns[c];
+        for (&r, coefficient) in rows.iter().zip(coefficients) {
+            if r == pivot_row {
+                diagonal = coefficient.clone();
+            } else if !coefficient.is_zero() {
+                if !solved[r] {
+                    return Err(Error::UnreliableFactorization);
+                }
+                let term = coefficient * &solution[r];
+                bounded(&term, total_raw_bits)?;
+                value -= term;
+                bounded(&value, total_raw_bits)?;
+            }
+        }
+        if diagonal.is_zero() {
+            return Err(Error::SingularMatrix);
+        }
+        value /= diagonal;
+        bounded(&value, total_solution_bits)?;
+        solution[pivot_row] = value;
+        solved[pivot_row] = true;
+    }
+
+    let core_rows = (0..n).filter(|&r| active_rows[r]).collect::<Vec<_>>();
+    let core_cols = (0..n).filter(|&c| active_cols[c]).collect::<Vec<_>>();
+    let m = core_rows.len();
+    if core_cols.len() != m {
+        return Err(Error::UnreliableFactorization);
+    }
+    let (core_raw_bits, core_solution_bits) = crate::lu::exact_resource_limits(m)?;
+    let mut row_to_core = vec![None; n];
+    for (i, &r) in core_rows.iter().enumerate() {
+        row_to_core[r] = Some(i);
+    }
+    let mut equations = Vec::with_capacity(m);
+    for &c in &core_cols {
+        let mut equation = vec![BigRational::zero(); m + 1];
+        let mut value = rhs[c].clone();
+        let (rows, coefficients) = &columns[c];
+        for (&r, coefficient) in rows.iter().zip(coefficients) {
+            if let Some(i) = row_to_core[r] {
+                equation[i] = coefficient.clone();
+            } else {
+                if !solved[r] {
+                    return Err(Error::UnreliableFactorization);
+                }
+                let term = coefficient * &solution[r];
+                bounded(&term, core_raw_bits)?;
+                value -= term;
+                bounded(&value, core_raw_bits)?;
+            }
+        }
+        equation[m] = value;
+        equations.push(equation);
+    }
+    let core_solution = integer_core(equations, core_raw_bits, core_solution_bits)?;
+    for (&r, value) in core_rows.iter().zip(core_solution) {
+        solution[r] = value;
+    }
+
+    // Verify every original equation, not just the peeled or core system.
+    // The core-aware allowance matches the existing structural LU policy.
+    let witness_bits = total_raw_bits.max(core_raw_bits);
+    for (c, (rows, coefficients)) in columns.iter().enumerate() {
+        let mut value = BigRational::zero();
+        for (&r, coefficient) in rows.iter().zip(coefficients) {
+            let term = coefficient * &solution[r];
+            bounded(&term, witness_bits)?;
+            value += term;
+            bounded(&value, witness_bits)?;
+        }
+        if value != rhs[c] {
+            return Err(Error::UnreliableFactorization);
+        }
+    }
+    Ok(solution)
+}
