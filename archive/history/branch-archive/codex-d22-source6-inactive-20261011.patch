 //! Dedicated synthetic numerical fixtures; no model inputs or model evaluation.
+#[test]
+fn captured_costs_require_complete_distinct_partition_and_original_basis() -> Result<(), String> {
+    let column = serde_json::json!({"rows":[0],"coefficient_bits":[1.0f64.to_bits()]});
+    let valid = serde_json::json!({
+        "schema":"uor-r4.d22-exact-cost-phase/1", "eps_bits":1.0e-10f64.to_bits(),
+        "basic_vars":[0], "nonbasic_vars":[1], "basis_columns":[column.clone()],
+        "original_columns":[column.clone(),column.clone()],
+        "working_cost_bits":[0.0f64.to_bits(),0.0f64.to_bits()]
+    });
+    microlp::repair::exact_cost_capture_fixture(&valid.to_string())?;
+    for bad_nonbasic in [
+        serde_json::json!([]),
+        serde_json::json!([1, 1]),
+        serde_json::json!([0]),
+        serde_json::json!([2]),
+    ] {
+        let mut invalid = valid.clone();
+        invalid["nonbasic_vars"] = bad_nonbasic;
+        if microlp::repair::exact_cost_capture_fixture(&invalid.to_string()).is_ok() {
+            return Err("malformed capture partition admitted".into());
+        }
+    }
+    let mut invalid = valid;
+    invalid["basis_columns"][0]["coefficient_bits"][0] = serde_json::json!(2.0f64.to_bits());
+    if microlp::repair::exact_cost_capture_fixture(&invalid.to_string()).is_ok() {
+        return Err("unbound capture basis admitted".into());
+    }
+    Ok(())
+}
