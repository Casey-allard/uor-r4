@@ -0,0 +1,805 @@
+//! Exact transpose solves of the stored dyadic basis, without rounded factors.
+use crate::sparse::Error;
+use num_bigint::BigInt;
+use num_rational::BigRational;
+use num_traits::{One, Signed, Zero};
+
+fn bounded(value: &BigRational, bits: u64) -> Result<(), Error> {
+    if value.numer().bits() > bits || value.denom().bits() > bits {
+        Err(Error::ExactResourceLimit)
+    } else {
+        Ok(())
+    }
+}
+
+fn dyadic(value: f64) -> Result<BigRational, Error> {
+    BigRational::from_float(value).ok_or(Error::NonFiniteFactorization)
+}
+
+fn gcd(mut a: BigInt, mut b: BigInt) -> BigInt {
+    a = a.abs();
+    b = b.abs();
+    while !b.is_zero() {
+        let remainder = &a % &b;
+        a = b;
+        b = remainder;
+    }
+    a
+}
+
+fn cost_inputs(
+    rows: &[usize],
+    coefficients: &[f64],
+    multipliers: &[BigRational],
+) -> Result<(), Error> {
+    if rows.len() != coefficients.len()
+        || rows.windows(2).any(|pair| pair[0] >= pair[1])
+        || rows.iter().any(|&r| r >= multipliers.len())
+    {
+        return Err(Error::UnreliableFactorization);
+    }
+    for (&r, &coefficient) in rows.iter().zip(coefficients) {
+        if !coefficient.is_finite() {
+            return Err(Error::NonFiniteFactorization);
+        }
+        if multipliers[r].denom() <= &BigInt::zero() {
+            return Err(Error::UnreliableFactorization);
+        }
+    }
+    Ok(())
+}
+
+/// Reference preserves the existing normalized accumulated-cost cap per term.
+/// Its scratch policy is unchanged: raw_bits is intentionally not applied.
+pub(crate) fn reference_column_cost(
+    working_cost: f64,
+    rows: &[usize],
+    coefficients: &[f64],
+    multipliers: &[BigRational],
+    _raw_bits: u64,
+    result_bits: u64,
+) -> Result<BigRational, Error> {
+    cost_inputs(rows, coefficients, multipliers)?;
+    let mut cost = dyadic(working_cost)?;
+    bounded(&cost, result_bits)?;
+    for (&r, &coefficient) in rows.iter().zip(coefficients) {
+        if coefficient != 0.0 {
+            cost -= dyadic(coefficient)? * &multipliers[r];
+        }
+        bounded(&cost, result_bits)?;
+    }
+    Ok(cost)
+}
+
+// Exact f64 decomposition A / 2^k, including subnormals and signed zero.
+fn dyadic_parts(value: f64) -> Result<(BigInt, usize), Error> {
+    let bits = value.to_bits();
+    let exponent = ((bits >> 52) & 0x7ff) as i32;
+    if exponent == 0x7ff {
+        return Err(Error::NonFiniteFactorization);
+    }
+    let mut mantissa = bits & ((1_u64 << 52) - 1);
+    let shift = if exponent == 0 {
+        -1074
+    } else {
+        mantissa |= 1_u64 << 52;
+        exponent - 1075
+    };
+    if mantissa == 0 {
+        return Ok((BigInt::zero(), 0));
+    }
+    let denominator_shift;
+    let mut numerator;
+    if shift < 0 {
+        let removed = mantissa.trailing_zeros().min((-shift) as u32);
+        mantissa >>= removed;
+        denominator_shift = (-shift) as usize - removed as usize;
+        numerator = BigInt::from(mantissa);
+    } else {
+        denominator_shift = 0;
+        numerator = BigInt::from(mantissa) << shift as usize;
+    }
+    if bits >> 63 != 0 {
+        numerator = -numerator;
+    }
+    Ok((numerator, denominator_shift))
+}
+
+fn scratch_product(a: &BigInt, b: &BigInt, bits: u64) -> Result<BigInt, Error> {
+    if !a.is_zero() && !b.is_zero() && a.bits().saturating_add(b.bits()) > bits {
+        return Err(Error::ExactResourceLimit);
+    }
+    let result = a * b;
+    if result.bits() > bits {
+        return Err(Error::ExactResourceLimit);
+    }
+    Ok(result)
+}
+
+fn scratch_shift(value: BigInt, shift: usize, bits: u64) -> Result<BigInt, Error> {
+    if !value.is_zero() && value.bits().saturating_add(shift as u64) > bits {
+        return Err(Error::ExactResourceLimit);
+    }
+    Ok(value << shift)
+}
+
+fn shared_column_cost(
+    working_cost: f64,
+    rows: &[usize],
+    coefficients: &[f64],
+    multipliers: &[BigRational],
+    raw_bits: u64,
+    result_bits: u64,
+) -> Result<BigRational, Error> {
+    let (objective, objective_shift) = dyadic_parts(working_cost)?;
+    let parts = coefficients
+        .iter()
+        .map(|&v| dyadic_parts(v))
+        .collect::<Result<Vec<_>, _>>()?;
+    let mut denominator = BigInt::one();
+    let mut shift = objective_shift;
+    for (&r, (numerator, coefficient_shift)) in rows.iter().zip(&parts) {
+        if numerator.is_zero() {
+            continue;
+        }
+        shift = shift.max(*coefficient_shift);
+        let divisor = gcd(denominator.clone(), multipliers[r].denom().clone());
+        denominator = scratch_product(&(&denominator / divisor), multipliers[r].denom(), raw_bits)?;
+    }
+    let common = scratch_shift(denominator.clone(), shift, raw_bits)?;
+    if common.bits() > result_bits {
+        // Without reducing each partial cost, this bound cannot certify the
+        // reference per-term result cap; use the reference instead.
+        return Err(Error::ExactResourceLimit);
+    }
+    let mut numerator = scratch_shift(
+        scratch_product(&objective, &denominator, raw_bits)?,
+        shift - objective_shift,
+        raw_bits,
+    )?;
+    if numerator.bits() > result_bits {
+        return Err(Error::ExactResourceLimit);
+    }
+    for (&r, (coefficient, coefficient_shift)) in rows.iter().zip(&parts) {
+        if coefficient.is_zero() {
+            continue;
+        }
+        let quotient = &denominator / multipliers[r].denom();
+        if &quotient * multipliers[r].denom() != denominator {
+            return Err(Error::UnreliableFactorization);
+        }
+        let term = scratch_shift(
+            scratch_product(
+                &scratch_product(coefficient, multipliers[r].numer(), raw_bits)?,
+                &quotient,
+                raw_bits,
+            )?,
+            shift - coefficient_shift,
+            raw_bits,
+        )?;
+        if numerator.bits().max(term.bits()).saturating_add(1) > raw_bits {
+            return Err(Error::ExactResourceLimit);
+        }
+        numerator -= term;
+        if numerator.bits() > result_bits {
+            return Err(Error::ExactResourceLimit);
+        }
+    }
+    let cost = BigRational::new(numerator, common);
+    bounded(&cost, result_bits)?;
+    Ok(cost)
+}
+
+/// One normalization after integer accumulation; conservative scratch/cap
+/// rejection falls back only to the unchanged exact rational reference.
+pub(crate) fn column_cost(
+    working_cost: f64,
+    rows: &[usize],
+    coefficients: &[f64],
+    multipliers: &[BigRational],
+    raw_bits: u64,
+    result_bits: u64,
+) -> Result<BigRational, Error> {
+    cost_inputs(rows, coefficients, multipliers)?;
+    if !working_cost.is_finite() {
+        return Err(Error::NonFiniteFactorization);
+    }
+    match shared_column_cost(
+        working_cost,
+        rows,
+        coefficients,
+        multipliers,
+        raw_bits,
+        result_bits,
+    ) {
+        Err(Error::ExactResourceLimit) => reference_column_cost(
+            working_cost,
+            rows,
+            coefficients,
+            multipliers,
+            raw_bits,
+            result_bits,
+        ),
+        result => result,
+    }
+}
+
+fn integer_core(
+    equations: Vec<Vec<BigRational>>,
+    raw_bits: u64,
+    solution_bits: u64,
+) -> Result<Vec<BigRational>, Error> {
+    let n = equations.len();
+    if n == 0 {
+        return Ok(Vec::new());
+    }
+    let mut a = Vec::with_capacity(n);
+    for equation in equations {
+        if equation.len() != n + 1 {
+            return Err(Error::UnreliableFactorization);
+        }
+        let mut scale = BigInt::one();
+        for value in &equation {
+            bounded(value, raw_bits)?;
+            scale = (&scale / gcd(scale.clone(), value.denom().clone())) * value.denom();
+            if scale.bits() > raw_bits {
+                return Err(Error::ExactResourceLimit);
+            }
+        }
+        let mut row = Vec::with_capacity(n + 1);
+        for value in equation {
+            let integer = value.numer() * (&scale / value.denom());
+            if integer.bits() > raw_bits {
+                return Err(Error::ExactResourceLimit);
+            }
+            row.push(integer);
+        }
+        a.push(row);
+    }
+
+    // Row scaling includes the rational RHS. Bareiss updates the entire
+    // augmented row and checks every division, including after row swaps.
+    let mut previous = BigInt::one();
+    for k in 0..n {
+        let mut pivot_row = k;
+        for r in k + 1..n {
+            if a[r][k].abs() > a[pivot_row][k].abs() {
+                pivot_row = r;
+            }
+        }
+        if a[pivot_row][k].is_zero() {
+            return Err(Error::SingularMatrix);
+        }
+        a.swap(k, pivot_row);
+        let pivot = a[k][k].clone();
+        for r in k + 1..n {
+            for c in k + 1..=n {
+                let numerator = &pivot * &a[r][c] - &a[r][k] * &a[k][c];
+                // Inputs have at most raw_bits bits, so a temporary product
+                // difference has at most twice that allowance plus one bit.
+                if numerator.bits() > 2 * raw_bits + 1 {
+                    return Err(Error::ExactResourceLimit);
+                }
+                let quotient = &numerator / &previous;
+                if &quotient * &previous != numerator {
+                    return Err(Error::UnreliableFactorization);
+                }
+                if quotient.bits() > raw_bits {
+                    return Err(Error::ExactResourceLimit);
+                }
+                a[r][c] = quotient;
+            }
+            a[r][k] = BigInt::zero();
+        }
+        previous = pivot;
+    }
+    let mut solution = vec![BigRational::zero(); n];
+    for r in (0..n).rev() {
+        let mut value = BigRational::from_integer(a[r][n].clone());
+        for c in r + 1..n {
+            let term = BigRational::from_integer(a[r][c].clone()) * &solution[c];
+            bounded(&term, raw_bits)?;
+            value -= term;
+            bounded(&value, raw_bits)?;
+        }
+        value /= BigRational::from_integer(a[r][r].clone());
+        bounded(&value, solution_bits)?;
+        solution[r] = value;
+    }
+    Ok(solution)
+}
+
+#[cfg(feature = "numerical-fixtures")]
+pub(crate) fn fixture(kind: &str) -> Result<(), Error> {
+    fn basis(rows: &[Vec<f64>]) -> Result<crate::repair::Basis, Error> {
+        let n = rows.len();
+        if rows.iter().any(|row| row.len() != n) {
+            return Err(Error::UnreliableFactorization);
+        }
+        let columns = (0..n)
+            .map(|c| {
+                rows.iter()
+                    .enumerate()
+                    .filter_map(|(r, row)| (row[c] != 0.0).then_some((r, row[c])))
+                    .unzip::<_, _, Vec<_>, Vec<_>>()
+            })
+            .collect::<Vec<_>>();
+        crate::repair::Basis::new(n, |c| (&columns[c].0, &columns[c].1))
+    }
+    fn known_solution(rows: &[Vec<f64>], expected: &[f64]) -> Result<(), Error> {
+        let b = basis(rows)?;
+        let rhs = (0..rows.len())
+            .map(|c| rows.iter().zip(expected).map(|(row, &y)| row[c] * y).sum())
+            .collect::<Vec<f64>>();
+        let result = transpose_solve(&b, &rhs)?;
+        let expected = expected
+            .iter()
+            .map(|&v| dyadic(v))
+            .collect::<Result<Vec<_>, _>>()?;
+        if result != expected {
+            return Err(Error::UnreliableFactorization);
+        }
+        Ok(())
+    }
+    fn rejected(result: Result<Vec<BigRational>, Error>, expected: Error) -> Result<(), Error> {
+        match result {
+            Err(error) if error == expected => Ok(()),
+            _ => Err(Error::UnreliableFactorization),
+        }
+    }
+    match kind {
+        "cost-cancellation" => {
+            let b = basis(&[vec![1.0, 1.0], vec![1.0, 1.0 + f64::EPSILON]])?;
+            let multipliers = transpose_solve(&b, &[0.1, 0.0])?;
+            let actual = column_cost(0.1, &[0, 1], &[1.0, 1.0], &multipliers, 65_536, 16_384)?;
+            let reference =
+                reference_column_cost(0.1, &[0, 1], &[1.0, 1.0], &multipliers, 65_536, 16_384)?;
+            if actual != reference || !actual.is_zero() {
+                return Err(Error::UnreliableFactorization);
+            }
+            Ok(())
+        }
+        "cost-odd-denominators" => {
+            let multipliers = vec![
+                BigRational::new(BigInt::from(1), BigInt::from(3)),
+                BigRational::new(BigInt::from(-2), BigInt::from(5)),
+                BigRational::new(BigInt::from(7), BigInt::from(11)),
+            ];
+            let actual = column_cost(
+                0.125,
+                &[0, 1, 2],
+                &[0.5, -2.0, 1.25],
+                &multipliers,
+                65_536,
+                16_384,
+            )?;
+            let reference = reference_column_cost(
+                0.125,
+                &[0, 1, 2],
+                &[0.5, -2.0, 1.25],
+                &multipliers,
+                65_536,
+                16_384,
+            )?;
+            let expected = BigRational::new(BigInt::from(-2161), BigInt::from(1320));
+            if actual != reference || actual != expected {
+                return Err(Error::UnreliableFactorization);
+            }
+            Ok(())
+        }
+        "cost-boundaries" | "cost-working-objective" => {
+            let eps = crate::solver::EPS;
+            for objective in [
+                f64::from_bits(eps.to_bits() - 1),
+                eps,
+                f64::from_bits(eps.to_bits() + 1),
+                -eps,
+                1.0,
+                -1.0,
+                0.0,
+                -0.0,
+                f64::from_bits(1),
+                f64::MIN_POSITIVE,
+                f64::MAX,
+            ] {
+                let actual = column_cost(objective, &[], &[], &[], 65_536, 16_384)?;
+                if actual != dyadic(objective)?
+                    || actual != reference_column_cost(objective, &[], &[], &[], 65_536, 16_384)?
+                {
+                    return Err(Error::UnreliableFactorization);
+                }
+            }
+            let multipliers = vec![BigRational::new(BigInt::from(1), BigInt::from(3))];
+            for objective in [1.0, -1.0] {
+                if column_cost(objective, &[0], &[0.5], &multipliers, 65_536, 16_384)?
+                    != reference_column_cost(objective, &[0], &[0.5], &multipliers, 65_536, 16_384)?
+                {
