 }
 
+/// The fused product-key memory forward (`cuda_stack_kernels.rs`, kernel 2b):
+/// the CUDA form of [`crate::stack_memory`]'s per-head selection and weighted
+/// value gather, which otherwise runs the CPU forward on host copies. Returns
+/// `None` when the inputs are not contiguous f32 or the geometry exceeds the
+/// kernel's bounds, so the caller falls back to [`via_host3`].
+#[allow(clippy::too_many_arguments)]
+pub(crate) fn product_key_memory_fwd(
+    s1: &CudaStorage,
+    l1: &Layout,
+    s2: &CudaStorage,
+    l2: &Layout,
+    s3: &CudaStorage,
+    l3: &Layout,
+    rows: usize,
+    heads: usize,
+    half: usize,
+    sub_keys: usize,
+    top_k: usize,
+    width: usize,
+    lorentz: bool,
+) -> CResult<Option<Forward>> {
+    if s1.dtype() != DType::F32 {
+        return Ok(None);
+    }
+    if sub_keys > 64 || top_k > 32 || heads == 0 || half == 0 {
+        return Ok(None);
+    }
+    let (Some(query), Some(keys), Some(values)) =
+        (input(s1, l1)?, input(s2, l2)?, input(s3, l3)?)
+    else {
+        return Ok(None);
+    };
+    let device = &s1.device;
+    let out = uninit::<f32>(device, rows * width)?;
+    launch(
+        device,
+        "product_key_memory_fwd",
+        rows * heads,
+        &[
+            Arg::F(query),
+            Arg::F(keys),
+            Arg::F(values),
+            Arg::f(&out),
+            Arg::U32(u32_of(rows, "rows")?),
+            Arg::U32(u32_of(heads, "heads")?),
+            Arg::U32(u32_of(half, "half")?),
+            Arg::U32(u32_of(sub_keys, "sub_keys")?),
+            Arg::U32(u32_of(top_k, "top_k")?),
+            Arg::U32(u32_of(width, "width")?),
+            Arg::U32(u32::from(lorentz)),
+        ],
+    )?;
+    Ok(Some(Ok((storage(out, device), Shape::from((rows, width))))))
+}
+
 pub(super) fn swiglu_fwd(s1: &CudaStorage, l1: &Layout, s2: &CudaStorage, l2: &Layout) -> Forward {
     if s1.dtype() == DType::BF16 {
         return super::cuda_ops_bf16::swiglu_fwd(s1, l1, s2, l2);
diff --git a/crates/uor-r4-training/src/stack_memory.rs b/crates/uor-r4-training/src/stack_memory.rs
index ddf456110..c21bb003c 100644
--- a/crates/uor-r4-training/src/stack_memory.rs
+++ b/crates/uor-r4-training/src/stack_memory.rs
@@ -489,6 +489,25 @@ impl CustomOp3 for ProductKeyMemory {
         s3: &CudaStorage,
         l3: &Layout,
     ) -> candle_core::Result<(CudaStorage, Shape)> {
+        // The fused forward first: it is the same arithmetic on the device, and
+        // the host bridge is the fallback for a shape or dtype it does not take.
+        if let Some(fused) = crate::geometric_stack::cuda_ops::product_key_memory_fwd(
+            s1,
+            l1,
+            s2,
+            l2,
+            s3,
+            l3,
+            self.rows,
+            self.heads,
+            self.half,
+            self.sub_keys,
+            self.top_k,
+            self.width,
+            self.score == MemoryScore::Lorentz,
+        )? {
+            return fused;
+        }
         crate::geometric_stack::cuda_ops::via_host3(self, [(s1, l1), (s2, l2), (s3, l3)])
     }
 
