index 5b8d3afa7..9ebc1b405 100644
--- a/crates/uor-r4-training/src/cuda_stack_kernels.rs
+++ b/crates/uor-r4-training/src/cuda_stack_kernels.rs
@@ -261,6 +261,110 @@ extern "C" __global__ void swiglu_bwd(
     d_gate[id] = act_from_f(d * u * s * (1.0f + g * (1.0f - s)));
 }
 
+// ---------------------------------------------------------------------------
+// 2b. The product-key memory forward: one thread per (row, head). Each thread
+// scores the `sub_keys` sub-keys of each side, keeps the `top_k` best per side
+// (score descending, ties to the lower index — the CPU path's rule), joins the
+// two kept sets into `top_k * top_k` candidates and keeps the `top_k` best
+// pairs (score descending, ties to the lower slot), softmaxes over the kept
+// candidates and gathers the weighted value rows. This is the fused form of
+// `stack_memory.rs`'s `select` + gather, which otherwise runs the CPU forward
+// on host copies; the f32 arithmetic makes it equal to that path to within
+// float tolerance rather than bit for bit, which the correctness test states.
+#define PKM_MAX_K 32
+#define PKM_MAX_SUB 64
+extern "C" __global__ void product_key_memory_fwd(
+    const float* query, const float* keys, const float* values, float* out,
+    uint rows, uint heads, uint half, uint sub_keys, uint top_k, uint width,
+    uint lorentz
+) {
+    uint thread = blockIdx.x * blockDim.x + threadIdx.x;
+    if (thread >= rows * heads) return;
+    uint row = thread / heads;
+    uint head = thread % heads;
+    if (sub_keys > PKM_MAX_SUB || top_k > PKM_MAX_K) return;
+    // The value row this thread accumulates.
+    float* acc = out + (size_t)row * width;
+    for (uint v = 0; v < width; ++v) acc[v] = 0.0f;
+    const float* q = query + (size_t)row * heads * 2 * half + (size_t)head * 2 * half;
+    float beta = lorentz != 0 ? keys[(size_t)heads * 2 * sub_keys * half + head] : 0.0f;
+    uint kept[2][PKM_MAX_K];
+    float score[2][PKM_MAX_K];
+    uint keep = top_k < sub_keys ? top_k : sub_keys;
+    for (uint side = 0; side < 2; ++side) {
+        const float* qs = q + (size_t)side * half;
+        float qlift = 0.0f;
+        for (uint i = 0; i < half; ++i) qlift += qs[i] * qs[i];
+        qlift = sqrtf(1.0f + qlift);
+        for (uint slot = 0; slot < keep; ++slot) { kept[side][slot] = 0; score[side][slot] = -INFINITY; }
+        for (uint index = 0; index < sub_keys; ++index) {
+            const float* k = keys + (((size_t)head * 2 + side) * sub_keys + index) * half;
+            float dot = 0.0f;
+            for (uint i = 0; i < half; ++i) dot += qs[i] * k[i];
+            float value = dot;
+            if (lorentz != 0) {
+                float klift = 0.0f;
+                for (uint i = 0; i < half; ++i) klift += k[i] * k[i];
+                klift = sqrtf(1.0f + klift);
+                float excess = qlift * klift - dot - 1.0f;
+                if (excess < LORENTZ_MIN_EXCESS) excess = LORENTZ_MIN_EXCESS;
+                value = -beta * logf(excess);
+            }
+            // Insert into the side's sorted best set: descending by score,
+            // ties to the lower index (the CPU path's `top`).
+            for (uint pos = 0; pos < keep; ++pos) {
+                if (value > score[side][pos] ||
+                    (value == score[side][pos] && index < kept[side][pos])) {
+                    for (uint move = keep - 1; move > pos; --move) {
+                        score[side][move] = score[side][move - 1];
+                        kept[side][move] = kept[side][move - 1];
+                    }
+                    score[side][pos] = value;
+                    kept[side][pos] = index;
+                    break;
+                }
+            }
+        }
+    }
+    // The candidate join: keep the `keep` best pairs by summed score, ties to
+    // the lower slot `first * sub_keys + second`.
+    uint pair_first[PKM_MAX_K], pair_second[PKM_MAX_K];
+    float pair_score[PKM_MAX_K];
+    for (uint slot = 0; slot < keep; ++slot) { pair_first[slot] = 0; pair_second[slot] = 0; pair_score[slot] = -INFINITY; }
+    for (uint i = 0; i < keep; ++i) {
+        for (uint j = 0; j < keep; ++j) {
+            float value = score[0][i] + score[1][j];
+            uint slot = kept[0][i] * sub_keys + kept[1][j];
+            for (uint pos = 0; pos < keep; ++pos) {
+                uint best_slot = pair_first[pos] * sub_keys + pair_second[pos];
+                if (value > pair_score[pos] || (value == pair_score[pos] && slot < best_slot)) {
+                    for (uint move = keep - 1; move > pos; --move) {
+                        pair_score[move] = pair_score[move - 1];
+                        pair_first[move] = pair_first[move - 1];
+                        pair_second[move] = pair_second[move - 1];
+                    }
+                    pair_score[pos] = value;
+                    pair_first[pos] = kept[0][i];
+                    pair_second[pos] = kept[1][j];
+                    break;
+                }
+            }
+        }
+    }
+    float maximum = pair_score[0];
+    float total = 0.0f;
+    float weight[PKM_MAX_K];
+    for (uint pos = 0; pos < keep; ++pos) {
+        weight[pos] = expf(pair_score[pos] - maximum);
+        total += weight[pos];
+    }
+    for (uint pos = 0; pos < keep; ++pos) {
+        float w = weight[pos] / total;
+        const float* value = values + (size_t)(pair_first[pos] * sub_keys + pair_second[pos]) * width;
+        for (uint v = 0; v < width; ++v) acc[v] += w * value[v];
+    }
+}
+
