+[package]
+name = "uor-r4-chat-eval"
+version = "0.1.0"
+edition = "2021"
+license = "MIT"
+description = "Frozen chat-panel v0 scorer and calibration instrument for the CAR-LM lab (evaluation only)"
+
+[[bin]]
+name = "chat-panel-score"
+path = "src/bin/chat-panel-score.rs"
+
+[dependencies]
+serde = { version = "1.0", features = ["derive"] }
+serde_json = "1.0"
+sha2 = "0.10.8"
+hex = "0.4.3"
+uor-r4-tokenizer = { path = "../uor-r4-tokenizer" }
