+{
+  "schema": "uor-r4.chat-panel/1",
+  "name": "chat-panel-v0",
+  "version": 0,
+  "frozen_date": "2026-09-25",
+  "authority": "CAR-LM branch-local instrument (codex/canonical-address-routing-20260925); evidence-only, not a promotion to main",
+  "sealed_convention": "The `fresh` array is SEALED. Do not run, read, inspect, tune against, or select any design using these rows during development. Open it only for a final held-out evaluation after design selection. Any development read of `fresh` invalidates the sealed-evaluation claim.",
+  "layout": {
+    "development_single_turn_prompts": 28,
+    "development_memory_probes": 10,
+    "development_scored_rows": 38,
+    "fresh_scored_rows": 24,
+    "note": "A(20)+C(8)=28 single-turn development prompts; B adds 10 three-turn memory probes = 38 scored development rows. Fresh=24 mirrors a named development row 1:1 across all three groups (13 core, 6 memory, 5 refusal)."
+  },
+  "tokenizer": {
+    "family": "hf-byte-bpe",
+    "vocab_size": 4096,
+    "note": "Prompts may be tokenized by the shared 4096-vocab byte-level BPE. Content metrics are computed on word tokens; the shared BPE is used for surface length and truncation accounting when a tokenizer.json is supplied."
+  },
