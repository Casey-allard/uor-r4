+        assert_eq!(
+            decode_conversation(&encoded, &tokenizer),
+            "<|bos|>User: Hi\nAssistant: Hello<|eos|>"
+        );
+        // One token per byte: BOS(1) + "User: "(6) + "Hi"(2) + "\n"(1) +
+        // "Assistant: "(11) + "Hello"(5) + EOS(1).
+        let mut expected = vec![0u8; 1 + 6 + 2 + 1 + 11];
