+
+    /// The standard GPT-2 byte-to-unicode table, reproduced here so the test
+    /// fixture is a true byte-level tokenizer with one token per input byte.
+    fn byte_encoder() -> Vec<char> {
+        let mut table = ['\0'; 256];
+        let mut assigned = [false; 256];
