+        }
+        let mut extra = 0u32;
+        for byte in 0..256usize {
+            if !assigned[byte] {
+                table[byte] = char::from_u32(256 + extra).expect("valid codepoint");
+                extra += 1;
+            }
+        }
+        table.to_vec()
+    }
