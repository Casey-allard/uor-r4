+        toy.variables()["pointer.key.weight"].set(&matrix(&|r, c| {
+            if r == c {
+                2.0
+            } else {
+                0.0
+            }
+        })?)?;
+        toy.variables()["pointer.query.weight"].set(&matrix(&|r, c| {
+            if r == 9 && c == 5 {
+                query_scale
+            } else {
+                0.0
