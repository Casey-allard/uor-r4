+        toy.variables()["pointer.gate.weight"].set(&Tensor::zeros((1, 16), DType::F32, &cpu())?)?;
+        toy.variables()["pointer.gate.bias"].set(&Tensor::from_vec(vec![gate_bias], 1, &cpu())?)?;
