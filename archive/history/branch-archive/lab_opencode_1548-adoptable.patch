+        assert_eq!(given.head, Some(Some(8)));
+        assert_eq!(given.score, Some(ReadScore::Lorentz));
+        assert_eq!(given.select, Some(Some(PointerSelect::TopK(1))));
+        assert_eq!(
+            pointer_args(&args(&["pointer_select=none"]))
+                .expect("cleared")
