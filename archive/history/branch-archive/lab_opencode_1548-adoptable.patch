+            );
+            let stated: BTreeSet<&str> = item.turns[..item.turns.len() - 1]
+                .iter()
+                .flat_map(|turn| turn.values.iter().map(String::as_str))
+                .collect();
+            let mut named = scored.answer.iter().chain(&scored.stale);
+            assert!(
