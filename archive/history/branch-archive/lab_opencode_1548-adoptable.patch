+fn split_of(args: &Args) -> Result<Split> {
+    match args.optional("split").as_deref() {
+        None | Some("development") => Ok(Split::Development),
+        Some("train") => Ok(Split::Train),
+        Some(other) => Err(invalid(format!("unknown split={other}"))),
+    }
+}
