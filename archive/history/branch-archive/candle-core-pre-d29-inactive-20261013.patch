-                height_in as f64 / height_out as f64
-            }
-        };
-
-        let scale_w = if self.align_corners {
-            if width_out > 1 {
-                (width_in - 1) as f64 / (width_out - 1) as f64
-            } else {
-                0.0
-            }
-        } else if let Some(scale_factor) = self.scale_w_factor {
-            1.0 / scale_factor
