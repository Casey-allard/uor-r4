+grp={"recurrent (W_in,W_s,b)":n["recurrent.input.weight"]+n["recurrent.state.weight"]+n["recurrent.bias"],
+     "read (Q,K,V,age,null)":sum(v for k,v in n.items() if k.startswith("read.")),
