+
+    fn fixture() -> Result<(HardDescriptor, Vec<u8>)> {
+        let specification = QuantizationSpec {
+            schema: SPEC_SCHEMA.into(),
+            parameters: BTreeMap::from([
+                (
+                    "output.bias".into(),
+                    ParameterQuantization {
+                        shape: vec![2],
+                        bits: 16,
+                        row_exponents: vec![-12],
+                    },
+                ),
+                (
+                    "output.norm.weight".into(),
