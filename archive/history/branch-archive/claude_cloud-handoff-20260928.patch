+def rope(x):
+    B, T, d = x.shape
+    half = d // 2
+    freqs = 1.0 / (10000 ** (jnp.arange(half) / half))
+    ang = jnp.arange(T)[:, None] * freqs[None, :]
+    c, s = jnp.cos(ang), jnp.sin(ang)
+    x1, x2 = x[..., :half], x[..., half:]
+    return jnp.concatenate([x1 * c - x2 * s, x1 * s + x2 * c], -1)
+
+
+def time_mix(b, x, kind, snap):
+    B, T, d = x.shape
+    v = x @ b["Wv"]
+    g = jax.nn.silu(x @ b["Wg"])
