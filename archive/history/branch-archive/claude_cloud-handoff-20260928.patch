+#!/bin/bash
+# usage: evalworker_wait.sh list core ; list lines: name|file_to_wait_for|args
+cd "$(dirname "$0")"
+S=/tmp/claude-0/-home-user-uor-r4/e71805df-3dbc-5124-8067-d8a48084429c/scratchpad
