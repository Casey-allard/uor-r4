+        y = rmsnorm(x, b["n2"])
+        x = x + (jax.nn.silu(y @ b["W1"]) * (y @ b["W2"])) @ b["W3"]
+    return rmsnorm(x, p["nf"]) @ p["out"]
+
+
+def loss_fn(p, xb, yb, kind, snap=False):
