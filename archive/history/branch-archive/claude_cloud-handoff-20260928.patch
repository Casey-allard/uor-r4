+
+    #[test]
+    fn restoring_square_root_obeys_floor_bounds() {
+        for value in [
+            0,
+            1,
+            2,
+            3,
+            4,
+            15,
+            16,
+            17,
+            (1u128 << 126) - 1,
+            1u128 << 126,
+            u128::MAX,
+        ] {
+            let root = isqrt(value);
