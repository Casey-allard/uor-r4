+            return hnew, hnew
+        _, hs = jax.lax.scan(cell, jnp.zeros((B, d)), (jnp.swapaxes(xz, 0, 1), jnp.swapaxes(xr, 0, 1), jnp.swapaxes(xn, 0, 1)))
