+        xz = x @ b["Wa"] + b["ba"]; xr = x @ b["Wr"]; xn = v
+        def cell(hprev, inp):
+            zt, rt, nt = inp
+            z = jax.nn.sigmoid(zt + hprev @ b["Uz"]); r = jax.nn.sigmoid(rt + hprev @ b["Ur"])
+            n = jnp.tanh(nt + r * (hprev @ b["Un"]))
