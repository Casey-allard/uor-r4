+#[cfg(target_arch = "aarch64")]
+unsafe fn adc16_bucket_neon(bytes: &[u8], lo: &[[u8; 16]; 8], hi: &[[u8; 16]; 8], s_out: &mut [i16]) {
+    use std::arch::aarch64::*;
+    let mask = vdupq_n_u8(0x0F);
+    let blocks = bytes.len() / 128;
