+            i128::try_from(sqrt_fixed(squared, 24)?).map_err(|_| IntegerMathError::Overflow)?;
+        assert_eq!(div_round(scale_pow2(3, 38)?, denominator)?, 9830);
+        assert_eq!(div_round(scale_pow2(4, 38)?, denominator)?, 13107);
