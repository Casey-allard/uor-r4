+#[derive(Debug, Serialize)]
+pub struct InputIdentity {
+    pub path: PathBuf,
+    pub bytes: u64,
+    pub sha256: String,
+}
+fn identity(path: &Path) -> Result<InputIdentity> {
+    Ok(InputIdentity {
+        path: path.to_path_buf(),
+        bytes: fs::metadata(path)?.len(),
+        sha256: sha256_file(path)?,
+    })
+}
