+        assert!(parse(&["key_shift=add"]).is_err());
+        assert_eq!(parse(&["key_shift=add", "init=x"])?, KeyShift::AddToInit);
+        assert!(parse(&["key_shift=yes"]).is_err());
+        Ok(())
+    }
