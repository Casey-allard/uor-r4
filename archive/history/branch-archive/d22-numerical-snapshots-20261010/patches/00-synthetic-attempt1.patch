+        // Unfixing a never-fixed var is a no-op with `false`.
+        let (sol, was_fixed) = sol.unfix_var(b).unwrap();
+        let sol = solution(sol);
+        assert!(!was_fixed);
+        assert!((sol.objective() - 11.0).abs() < 1e-6);
