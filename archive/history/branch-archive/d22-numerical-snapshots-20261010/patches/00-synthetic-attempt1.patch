+// No rounded pivot-zero test occurs in this fallback. The rationals represent
+// the exact stored IEEE inputs. Rounded factors are admitted only by verify().
+fn exact_factorize(basis: &crate::repair::Basis) -> Result<LUFactors, Error> {
+    use num_rational::BigRational;
+    use num_traits::{Signed, ToPrimitive, Zero};
+    const MAX_DIM: usize = 512;
+    const MAX_BITS: u64 = 16_384;
+    fn bounded(x: BigRational) -> Result<BigRational, Error> {
+        if x.numer().bits() > MAX_BITS || x.denom().bits() > MAX_BITS {
+            Err(Error::ExactResourceLimit)
+        } else {
+            Ok(x)
+        }
+    }
+    fn rounded(x: &BigRational) -> Result<f64, Error> {
+        let v = x.to_f64().ok_or(Error::NonFiniteFactorization)?;
+        if !v.is_finite() || (v == 0.0 && !x.is_zero()) {
+            return Err(Error::UnreliableFactorization);
+        }
+        Ok(v)
+    }
+    let n = basis.columns.len();
+    if n > MAX_DIM {
+        return Err(Error::ExactResourceLimit);
+    }
+    let mut a = vec![vec![BigRational::zero(); n]; n];
+    for (c, (rs, vs)) in basis.columns.iter().enumerate() {
+        for (&r, &v) in rs.iter().zip(vs) {
+            a[r][c] = BigRational::from_float(v).ok_or(Error::NonFiniteFactorization)?;
+        }
+    }
+    let mut new2orig: Vec<usize> = (0..n).collect();
+    for k in 0..n {
+        let mut pivot = k;
+        for r in k + 1..n {
+            if a[r][k].abs() > a[pivot][k].abs() {
+                pivot = r;
+            }
+        }
+        if a[pivot][k].is_zero() {
+            crate::repair::count(|s| s.exact_singular += 1);
+            return Err(Error::SingularMatrix);
+        }
+        a.swap(k, pivot);
+        new2orig.swap(k, pivot);
+        for r in k + 1..n {
+            if a[r][k].is_zero() {
+                continue;
+            }
+            a[r][k] = bounded(&a[r][k] / &a[k][k])?;
+            for c in k + 1..n {
+                if !a[k][c].is_zero() {
+                    a[r][c] = bounded(&a[r][c] - &a[r][k] * &a[k][c])?;
+                }
+            }
+        }
+    }
+    let mut lower = SparseMat::new(n);
+    let mut upper = SparseMat::new(n);
+    let mut diagonal = Vec::with_capacity(n);
+    for c in 0..n {
+        for r in 0..c {
+            if !a[r][c].is_zero() {
+                upper.push(r, rounded(&a[r][c])?);
+            }
+        }
+        for r in c + 1..n {
+            if !a[r][c].is_zero() {
+                lower.push(r, rounded(&a[r][c])?);
+            }
+        }
+        lower.seal_column();
+        upper.seal_column();
+        diagonal.push(rounded(&a[c][c])?);
+    }
+    let mut orig2new = vec![0; n];
+    for (i, &r) in new2orig.iter().enumerate() {
+        orig2new[r] = i;
+    }
+    Ok(LUFactors {
+        lower: TriangleMat {
+            nondiag: lower,
+            diag: None,
+        },
+        upper: TriangleMat {
+            nondiag: upper,
+            diag: Some(diagonal),
+        },
+        row_perm: Some(Perm { orig2new, new2orig }),
+        col_perm: None,
+    })
+}
