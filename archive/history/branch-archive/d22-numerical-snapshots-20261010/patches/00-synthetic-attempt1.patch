+/// TSP (Travelling Salesman Problem) solver.
+pub mod tsp;
diff --git a/crates/uor-r4-training/vendor/microlp/src/problems_solvers/tsp.rs b/crates/uor-r4-training/vendor/microlp/src/problems_solvers/tsp.rs
