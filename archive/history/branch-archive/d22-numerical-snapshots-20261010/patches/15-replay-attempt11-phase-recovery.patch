+        self.is_dual_feasible = true;
+        self.numerical_feasibility_restart_active = false;
+        numerical_progress(
+            "original-objective-restored",
+            &self.basic_vars,
+            self.lp_iterations,
+        );
+        Ok(StopReason::Finished)
+    }
