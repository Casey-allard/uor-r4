+        assert!(text.contains("R3 J_CLAIM_RETRACTED"), "{text}");
+        // The conv falls short: the claim stands, and Step 2b opens.
+        let decision = decide(&grouped(vec![
+            ("none", runs("none", 3, |_| 0.6)),
+            ("f2", runs("f2", 3, |_| 0.99)),
