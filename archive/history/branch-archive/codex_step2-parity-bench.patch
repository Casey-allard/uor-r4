+        assert!(text.contains("R3 J_CLAIM_STANDS_OVER_CONV"), "{text}");
+        assert!(text.contains("R6 STEP_2B_JUSTIFIED"), "{text}");
+        // Two failing arms tying is not evidence about j (guard).
+        let decision = decide(&grouped(vec![
