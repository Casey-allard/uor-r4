+        assert!(parse_checks("a\tabstain\tnone\tx\n").is_err());
+        assert!(parse_checks("a\tany\tsometimes\tx\n").is_err());
+        assert!(parse_checks("a\tany\tnone\tx\na\tany\tnone\ty\n").is_err());
+        let checks = Checks {
