+                    }
+                    // A long unrelated reply fails every turn of every kind.
+                    let filler =
+                        "The main difference is a simple yet simple way to spend the day at the park.";
+                    assert!(
+                        !judge_v2(&turn.checks, &turn.user, filler),
+                        "{:?}: {:?} passes filler",
+                        turn.intent,
+                        turn.checks
