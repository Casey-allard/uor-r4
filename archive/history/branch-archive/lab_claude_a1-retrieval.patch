+fn messages_through(turns: &[Turn2], upto: usize) -> Vec<Message<'_>> {
+    let mut messages = Vec::with_capacity(2 * upto + 1);
+    for (i, turn) in turns.iter().enumerate().take(upto + 1) {
+        messages.push(Message {
+            role: "user",
+            content: &turn.user,
+        });
+        if i < upto {
+            messages.push(Message {
+                role: "assistant",
+                content: &turn.reply,
+            });
+        }
+    }
+    messages
