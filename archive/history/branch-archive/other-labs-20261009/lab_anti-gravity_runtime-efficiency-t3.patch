+      OPTIMIZED_BIN="$2"
+      shift 2
+      ;;
+    --step-bin)
+      STEP_BIN="$2"
+      shift 2
+      ;;
+    *)
+      echo "Unknown option: $1" >&2
+      exit 1
+      ;;
+  esac
+done
+
+# If explicit STEP_BIN was provided, use it for both baseline and optimized if not separately specified
+if [[ -n "$STEP_BIN" ]]; then
