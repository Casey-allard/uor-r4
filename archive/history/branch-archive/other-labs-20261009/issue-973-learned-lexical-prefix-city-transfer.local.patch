index 000fec522..a81e67a7f 100644
--- a/crates/uor-r4-core/src/native_geometric/word_copy_tests.rs
+++ b/crates/uor-r4-core/src/native_geometric/word_copy_tests.rs
@@ -576,3 +576,77 @@ fn native_word_copy_preserves_parent_and_respects_typed_precedence_and_controls(
