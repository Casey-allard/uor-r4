+];
+const CLOSED_ALIASES: [&str; 11] = [
+    "user_name",
+    "pet_name",
+    "friend_name",
+    "hometown",
+    "lucky_number",
+    "code_word",
+    "job",
+    "home",
+    "favorite_food",
