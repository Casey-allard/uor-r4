+    /// A codec that loses a value.
+    struct Short;
+
+    impl MapCodec for Short {
+        fn name(&self) -> &str {
+            "short"
+        }
+
+        fn round_trip(&self, values: &[f32], _rows: usize, _cols: usize) -> Result<Vec<f32>> {
+            Ok(values[..values.len().saturating_sub(1)].to_vec())
+        }
+    }
