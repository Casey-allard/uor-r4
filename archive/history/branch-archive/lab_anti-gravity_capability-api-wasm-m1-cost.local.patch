+        with open(path, "rb") as f:
+            while chunk := f.read(65536):
+                h.update(chunk)
+        return h.hexdigest()
+    # Fallback to sha256 with explicit label if blake3 module unavailable
+    return f"sha256:{sha256_file(path)}"
