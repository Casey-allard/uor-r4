+    for (name, examples) in [("train", &train), ("dev", &dev)] {
+        let (mut tokens, mut mask) = (Vec::new(), Vec::new());
+        let (mut documents, mut skipped) = (0usize, 0usize);
+        let mut by_op: BTreeMap<String, usize> = BTreeMap::new();
+        for example in examples.iter() {
