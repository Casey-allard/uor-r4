+            "pointer.gate.weight" => vec![0.0; count],
+            "pointer.gate.bias" => vec![POINTER_GATE_BIAS; count],
+            _ => (0..count).map(|_| (rng.normal() * std) as f32).collect(),
+        };
+        variables.insert(name, Var::from_vec(values, shape.as_slice(), device)?);
+    }
